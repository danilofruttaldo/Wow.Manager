---
import Base from '../layouts/Base.astro';
import { getProfessions, professionsMeta, type Profession } from '../lib/content';

const professions = getProfessions();

const GROUPS: { type: Profession['type']; label: string }[] = [
  { type: 'crafting', label: 'Crafting' },
  { type: 'gathering', label: 'Raccolta' },
  { type: 'secondary', label: 'Secondarie' },
];
const byType = (t: Profession['type']) => professions.filter(p => p.type === t);
---
<Base title="Professioni" description="Professioni WoW: 1ª e 2ª specializzazione da prendere e ramo da maxare.">
  <div class="wrap">
    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th style="width:40px"></th>
            <th style="width:12rem">Professione</th>
            <th>1ª specializzazione · ramo da maxare</th>
            <th>2ª specializzazione · ramo da maxare</th>
            <th>Note</th>
          </tr>
        </thead>
        <tbody>
          {GROUPS.map(g => {
            const rows = byType(g.type);
            if (!rows.length) return null;
            return (
              <Fragment>
                <tr class="gsep"><td colspan="5">{g.label}</td></tr>
                {rows.map(p => (
                  <tr>
                    <td><img class="ico" src={`/icons/prof/${p.key}.jpg`} alt={p.name} title={p.name} width="26" height="26" /></td>
                    <td><strong>{p.name}</strong></td>
                    <td>
                      {p.first
                        ? <div class="step"><span class="badge badge--accent">{p.first.spec}</span><span class="step-branch">massimizza <strong>{p.first.branch}</strong></span></div>
                        : <span class="muted">—</span>}
                    </td>
                    <td>
                      {p.second
                        ? <div class="step"><span class="badge">{p.second.spec}</span><span class="step-branch">massimizza <strong>{p.second.branch}</strong></span></div>
                        : <span class="muted">—</span>}
                    </td>
                    <td style="max-width:44ch"><span class="cell-note" style="margin:0">{p.notes}</span></td>
                  </tr>
                ))}
              </Fragment>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</Base>

<style>
.step { display: flex; flex-direction: column; gap: 0.2rem; align-items: flex-start; }
.step-branch { font-size: 0.78rem; color: var(--text-muted); }
.step-branch strong { color: var(--text); font-weight: 600; }
.muted { color: var(--text-subtle); }
tr.gsep td {
  font-size: 0.72rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-subtle); background: var(--surface-2);
  padding-top: 0.5rem; padding-bottom: 0.5rem;
}
</style>
