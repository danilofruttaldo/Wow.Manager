---
import Base from '../layouts/Base.astro';
import { getProfessions, type Profession } from '../lib/content';

const professions = getProfessions().sort((a, b) => a.name.localeCompare(b.name));

const TYPE_LABEL: Record<Profession['type'], string> = {
  crafting: 'Craft', gathering: 'Raccolta',
};
const steps = (p: Profession) => [p.first, p.second, p.third];
const searchData = (p: Profession) =>
  `${p.name} ${TYPE_LABEL[p.type]} ${steps(p).map(s => s ? `${s.spec} ${s.branch}` : '').join(' ')} ${p.notes ?? ''}`.toLowerCase();

const craftingCount = professions.filter(p => p.type === 'crafting').length;
const gatheringCount = professions.filter(p => p.type === 'gathering').length;
---
<Base title="Professioni" description="Professioni WoW: specializzazioni da prendere in ordine e ramo da maxare.">
  <div class="wrap">
    <div class="filters row">
      <input id="prof-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca professione…" aria-label="Cerca professione" />
      <div class="chips" id="prof-filters" role="group" aria-label="Filtra per tipo">
        <button class="chip" data-filter="crafting" type="button"><img class="chip-ico" src="/icons/ui/crafting.jpg" alt="" width="18" height="18" />Crafting<span class="c">{craftingCount}</span></button>
        <button class="chip" data-filter="gathering" type="button"><img class="chip-ico" src="/icons/ui/gathering.jpg" alt="" width="18" height="18" />Raccolta<span class="c">{gatheringCount}</span></button>
      </div>
    </div>

    <div class="prof-grid" id="prof-grid">
      {professions.map(p => (
        <article class={`pcard pcard--${p.type}`} data-type={p.type} data-search={searchData(p)}>
          <header class="pcard-head">
            <img class="pico" src={`/icons/prof/${p.key}.jpg`} alt="" width="40" height="40" loading="lazy" />
            <span class="pcard-name">{p.name}</span>
            <span class={`badge ptype ptype--${p.type}`}>{TYPE_LABEL[p.type]}</span>
          </header>
          <ol class="steps">
            {steps(p).map((s, i) => (
              <li class="step">
                <span class={`step-n step-n--${i + 1}`}>{i + 1}</span>
                <div class="step-body">
                  <span class="step-spec">{s ? s.spec : '—'}</span>
                  {s && <span class="step-branch"><strong>{s.branch}</strong></span>}
                </div>
              </li>
            ))}
          </ol>
          <p class="pcard-note">{p.notes}</p>
        </article>
      ))}
    </div>
    <p class="empty" id="empty" hidden>Nessuna professione trovata.</p>
  </div>
</Base>

<style>
/* Griglia 3→2→1 row-major come /addons: l'ordine alfabetico si legge per righe. */
.prof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem; padding-top: 0.6rem; }
@media (max-width: 1200px) { .prof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 820px) { .prof-grid { grid-template-columns: 1fr; } .filters { top: 0; } }

/* Shell identica a .acard di /addons: bordo semplice, niente barra colorata. */
.pcard { display: flex; flex-direction: column; gap: 0.75rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 0.85rem 1.05rem; }
.pcard[hidden] { display: none !important; }  /* display:flex vince su [hidden]: forziamo */

.pcard-head { display: flex; align-items: center; gap: 0.65rem; }
.pico { flex-shrink: 0; width: 38px; height: 38px; min-width: 38px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); object-fit: cover; }
.pcard-name { font-weight: 600; font-size: 1rem; line-height: 1.2; color: var(--text); }
.ptype { margin-left: auto; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.64rem; }
.ptype--crafting  { background: var(--accent-soft); color: var(--accent); }
.ptype--gathering { background: color-mix(in srgb, var(--c-hunter) 14%, transparent); color: var(--c-hunter); }

/* Classifica ① → ② → ③: tre tappe collegate da uno spine verticale, identico su ogni card. */
.steps { list-style: none; display: flex; flex-direction: column; gap: 0.55rem; }
.step { position: relative; display: flex; gap: 0.6rem; align-items: flex-start; }
.step:not(:last-child)::before { content: ''; position: absolute; left: 9.5px; top: 22px; bottom: -0.55rem; width: 1px; background: var(--border); }
.step-n { position: relative; z-index: 1; flex-shrink: 0; display: grid; place-items: center; width: 20px; height: 20px; border-radius: 999px; font-size: 0.72rem; font-weight: 700; color: #fff; }
.step-n--1 { background: var(--accent); }
.step-n--2 { background: color-mix(in srgb, var(--accent) 55%, var(--text-subtle)); }
.step-n--3 { background: var(--text-subtle); }
.step-body { display: flex; flex-direction: column; gap: 0.1rem; min-width: 0; padding-top: 0.05rem; }
.step-spec { font-size: 0.9rem; font-weight: 600; color: var(--text); line-height: 1.3; }
.step-branch { font-size: 0.78rem; color: var(--text-muted); }
.step-branch strong { color: var(--text); font-weight: 600; }

/* Note sempre in fondo alla card, così i footer si allineano su tutta la riga. */
.pcard-note { margin-top: auto; padding-top: 0.6rem; border-top: 1px solid var(--border-light); font-size: 0.78rem; color: var(--text-subtle); line-height: 1.45; }
</style>

<script>
  function initProfessions() {
    const grid = document.getElementById('prof-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('.pcard')) as HTMLElement[];
    const search = document.getElementById('prof-search') as HTMLInputElement;
    const chips = Array.from(document.querySelectorAll('#prof-filters .chip')) as HTMLButtonElement[];
    const empty = document.getElementById('empty') as HTMLElement;

    let query = '';
    let filter = ''; // '' = tutti, 'crafting', 'gathering'

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const okText = query === '' || (card.dataset.search || '').includes(query);
        const okFilter = filter === '' || card.dataset.type === filter;
        const show = okText && okFilter;
        card.hidden = !show;
        if (show) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    if (search) search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); apply(); });
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter || '';
        filter = filter === f ? '' : f;              // toggle: ri-click deseleziona
        for (const c of chips) c.classList.toggle('is-active', c === chip && filter !== '');
        apply();
      });
    }
  }

  document.addEventListener('astro:page-load', initProfessions);
</script>
