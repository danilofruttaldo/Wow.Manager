---
import Base from '../layouts/Base.astro';
import { getProfessions, professionsMeta, type Profession } from '../lib/content';

const professions = getProfessions();

const GROUPS: { type: Profession['type']; label: string }[] = [
  { type: 'crafting', label: 'Crafting' },
  { type: 'gathering', label: 'Raccolta' },
  { type: 'secondary', label: 'Secondarie' },
];
const byType = (t: Profession['type']) => professions.filter(p => p.type === t);
---
<Base title="Professioni" description="Professioni WoW: specializzazioni e ramo da maxare per ciascuna.">
  <div class="wrap">
    <div class="phead">
      <h1>Professioni</h1>
      <span class="meta">{professions.length} professioni · <code>{professionsMeta.expansion}</code></span>
    </div>

    <p class="note-box">{professionsMeta.note}</p>

    <div class="table-scroll">
      <table>
        <thead>
          <tr>
            <th style="width:40px"></th>
            <th>Specializzazioni</th>
            <th>Ramo da maxare</th>
            <th>Note</th>
          </tr>
        </thead>
        <tbody>
          {GROUPS.map(g => {
            const rows = byType(g.type);
            if (!rows.length) return null;
            return (
              <Fragment>
                <tr class="gsep"><td colspan="4">{g.label}</td></tr>
                {rows.map(p => (
                  <tr>
                    <td>
                      <img class="ico" src={`/icons/prof/${p.key}.jpg`} alt={p.name} title={p.name} width="26" height="26" />
                    </td>
                    <td>
                      {p.specializations.length
                        ? <span class="spec-list">{p.specializations.map(s => <span class="badge">{s}</span>)}</span>
                        : <span class="muted">—</span>}
                    </td>
                    <td>
                      {p.maxBranch
                        ? <span class="badge badge--accent">{p.maxBranch}</span>
                        : <span class="muted">—</span>}
                    </td>
                    <td style="max-width:46ch"><span class="cell-note" style="margin:0">{p.notes}</span></td>
                  </tr>
                ))}
              </Fragment>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>
</Base>

<style>
.note-box {
  font-size: 0.8rem;
  line-height: 1.5;
  color: var(--text-muted);
  background: var(--surface-2);
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius-sm);
  padding: 0.6rem 0.8rem;
  margin: 0 0 1.1rem;
}
.spec-list { display: flex; flex-wrap: wrap; gap: 0.3rem; }
.muted { color: var(--text-subtle); }
tr.gsep td {
  font-size: 0.72rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-subtle);
  background: var(--surface-2);
  padding-top: 0.5rem;
  padding-bottom: 0.5rem;
}
</style>
