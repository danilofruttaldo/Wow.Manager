---
import Base from '../layouts/Base.astro';
import { getProfessions, getProfessionTrees, getProfessionLeveling, getProfExpansions,
         type Profession, type ProfNode } from '../lib/content';

// Tab per professione, come /transmog e' a tab per classe. Dentro ogni tab DUE parti:
//   1. Specializzazioni da prendere -- l'albero estratto dal CLIENT (trees.json): spec,
//      sotto-nodi e i punti massimi, il dato che il web non ha.
//   2. Skill-up 1 -> max -- la guida di leveling della skill (leveling.json), web-sourced.
// Una tendina sceglie l'espansione: oggi solo Midnight, ma struttura e controllo sono
// gia' pronti per aggiungere le passate.
const professions = getProfessions().sort((a, b) => a.name.localeCompare(b.name));
const trees = getProfessionTrees();          // key -> espansione -> albero
const leveling = getProfessionLeveling();    // key -> espansione -> guida skill
const expansions = getProfExpansions();      // ordinate; oggi ["Midnight"]
const defaultExp = expansions[0] ?? 'Midnight';

const TYPE_LABEL: Record<Profession['type'], string> = { crafting: 'Craft', gathering: 'Raccolta' };

const PROF_ICONS = new Set(
  Object.keys(import.meta.glob('/public/icons/prof/*.jpg', { eager: true }))
    .map(p => p.split('/').pop()!.replace(/\.jpg$/, '')),
);
const profIcon = (key: string) => (PROF_ICONS.has(key) ? `/icons/prof/${key}.jpg` : null);

const treeFor = (key: string, exp: string) => trees[key]?.[exp];
const levelFor = (key: string, exp: string) => leveling[key]?.[exp];
const hasTree = (key: string, exp: string) => !!treeFor(key, exp)?.specs?.length;
const hasLevel = (key: string, exp: string) => !!levelFor(key, exp)?.steps?.length;
// Un tab e' "vuoto" (chip spenta) solo se NESSUNA delle due parti ha dati per quell'espansione.
const hasAny = (key: string, exp: string) => hasTree(key, exp) || hasLevel(key, exp);
// Tab attivo di default: la prima professione (alfabetica) con qualcosa nell'espansione
// di default, cosi' all'apertura si vede contenuto reale e non due segnaposto.
const defaultKey = (professions.find(p => hasAny(p.key, defaultExp)) ?? professions[0])?.key;

// L'albero e' generato da dati JSON nostri (fidati), ma passa da set:html: scappiamo
// comunque i metacaratteri; i `cap` sono numeri.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
// Testo cercabile di un nodo e dei suoi discendenti: nome + descrizione, ricorsivo.
// Alimenta il `data-search` della card spec (i figli sono resi via set:html, quindi il
// testo va raccolto qui e non e' estraibile dal DOM in modo affidabile).
const nodeText = (n: ProfNode): string =>
  `${n.name ?? ''} ${n.desc ?? ''} ${(n.children ?? []).map(nodeText).join(' ')}`;
function renderNode(n: ProfNode, depth = 0): string {
  const kids = n.children?.length
    ? `<div class="pnode-kids">${n.children.map(c => renderNode(c, depth + 1)).join('')}</div>`
    : '';
  const desc = n.desc ? `<p class="pnode-desc">${esc(n.desc)}</p>` : '';
  // Difesa su dump parziale/malformato: senza questi default, un nodo senza `name`
  // farebbe esc(undefined).replace -> crash del build; un `cap` mancante stamperebbe
  // "undefined" nella pastiglia.
  const name = esc(n.name ?? '?');
  const cap = n.cap ?? '';
  return `<div class="pnode pnode--d${depth}">`
    + `<div class="pnode-head"><span class="pnode-name">${name}</span>`
    + `<span class="pnode-cap" title="Rank massimo: ${cap} punti conoscenza">${cap}</span></div>`
    + `${desc}${kids}</div>`;
}
---
<Base title="Professioni" description="Alberi di specializzazione e leveling WoW per professione: spec, punti massimi e skill-up, dal client.">
  <div class="wrap">
    <div class="filters row">
      <input id="prof-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca spec, nodo, tappa…" aria-label="Cerca nella professione attiva" />
      <div class="chips" id="prof-chips" role="tablist" aria-label="Scegli la professione">
        {professions.map(p => {
          const icon = profIcon(p.key);
          const empty = !hasAny(p.key, defaultExp);
          return (
            <button class:list={['chip', { 'is-active': p.key === defaultKey, 'is-empty': empty }]}
                    data-prof={p.key} type="button" role="tab"
                    id={`ptab-${p.key}`} aria-controls={`ppanel-${p.key}`}
                    tabindex={p.key === defaultKey ? 0 : -1}
                    aria-selected={p.key === defaultKey ? 'true' : 'false'}>
              {icon
                ? <img class="chip-ico" src={icon} alt="" width="18" height="18" />
                : <span class="chip-mono" aria-hidden="true">{p.name.charAt(0)}</span>}
              {p.name}
            </button>
          );
        })}
      </div>
      <label class="exp-pick">
        <span class="exp-pick-lbl">Espansione</span>
        <select id="prof-exp" aria-label="Scegli l'espansione" autocomplete="off" disabled={expansions.length < 2}>
          {expansions.map(exp => <option value={exp} selected={exp === defaultExp}>{exp}</option>)}
        </select>
      </label>
    </div>

    {professions.map(p => (
      <section class="prof-panel" data-prof={p.key} hidden={p.key !== defaultKey} role="tabpanel" id={`ppanel-${p.key}`} aria-labelledby={`ptab-${p.key}`}>
        <header class="prof-head">
          {profIcon(p.key)
            ? <img class="prof-ico" src={profIcon(p.key)!} alt="" width="40" height="40" />
            : <span class="prof-mono" aria-hidden="true">{p.name.charAt(0).toUpperCase()}</span>}
          <span class="prof-name">{p.name}</span>
          <span class={`badge ptype ptype--${p.type}`}>{TYPE_LABEL[p.type]}</span>
        </header>

        {expansions.map(exp => {
          const tree = treeFor(p.key, exp);
          const guide = levelFor(p.key, exp);
          const okTree = !!tree?.specs?.length;
          const okLevel = !!guide?.steps?.length;
          return (
            <div class="prof-exp" data-exp={exp} data-has={okTree || okLevel ? '1' : '0'} hidden={exp !== defaultExp}>
              {/* Parte 1: specializzazioni da prendere */}
              <section class="prof-sec">
                <h2 class="sec-title"><span class="sec-num">1</span>Specializzazioni da prendere
                  {okTree && <span class="sec-hint">i numeri = rank massimo del nodo</span>}
                </h2>
                {okTree
                  ? <div class="spec-grid">
                      {tree!.specs.map(spec => (
                        <article class="spec" data-search={`${spec.name} ${spec.desc ?? ''} ${(spec.children ?? []).map(nodeText).join(' ')}`.toLowerCase()}>
                          <div class="pnode-head spec-head">
                            <span class="pnode-name">{spec.name}</span>
                            <span class="pnode-cap" title={`Rank massimo: ${spec.cap} punti conoscenza`}>{spec.cap}</span>
                          </div>
                          {spec.desc && <p class="pnode-desc">{spec.desc}</p>}
                          {spec.children && spec.children.length > 0 &&
                            <div class="pnode-kids" set:html={spec.children.map(c => renderNode(c, 1)).join('')} />}
                        </article>
                      ))}
                    </div>
                  : <p class="prof-empty">Albero <strong>{exp}</strong> non ancora estratto dal client. Serve loggare un PG con <strong>{p.name}</strong> e rilanciare il dump.</p>}
              </section>

              {/* Parte 2: skill-up 1 -> max */}
              <section class="prof-sec">
                <h2 class="sec-title">
                  <span class="sec-num">2</span>Skill-up
                  {guide?.maxSkill && <span class="sec-range">1 → {guide.maxSkill}</span>}
                </h2>
                {okLevel
                  ? <ol class="lvl">
                      {guide!.steps.map(s => (
                        <li class="lvl-step" data-search={`${s.from} ${s.to} ${s.action} ${s.note ?? ''}`.toLowerCase()}>
                          <span class="lvl-range">{s.from}–{s.to}</span>
                          <span class="lvl-action">{s.action}{s.note && <em class="lvl-note"> — {s.note}</em>}</span>
                        </li>
                      ))}
                    </ol>
                  : <p class="prof-empty">Guida di leveling <strong>{exp}</strong> non ancora inserita.</p>}
              </section>
            </div>
          );
        })}

        {p.notes && <p class="prof-note">{p.notes}</p>}
      </section>
    ))}
    <p class="empty" id="prof-empty" role="status" hidden>Nessun risultato per questa ricerca in questa professione.</p>
  </div>
</Base>

<style>
.prof-panel { padding-top: 0.4rem; }
.prof-panel[hidden] { display: none !important; }
.prof-exp[hidden] { display: none !important; }

.exp-pick { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; }
.exp-pick-lbl { font-size: 0.78rem; color: var(--text-subtle); }
#prof-exp {
  font-family: inherit; font-size: var(--fs-base); color: var(--text); background: var(--surface);
  border: 1px solid var(--border); border-radius: 999px; padding: 0.28rem 0.7rem; cursor: pointer;
  min-height: var(--control-h);
}
#prof-exp:hover { border-color: var(--accent); }

.prof-head { display: flex; align-items: center; gap: 0.6rem; padding: 0.2rem 0 0.9rem; }
.prof-ico { width: 40px; height: 40px; border-radius: var(--radius-lg); border: 1px solid var(--border); object-fit: cover; max-width: none; }
.prof-mono { display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-lg); background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 1.2rem; }
.prof-name { font-weight: 700; font-size: 1.2rem; letter-spacing: -0.01em; }
.ptype { text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.64rem; }
.ptype--crafting  { background: var(--accent-soft); color: var(--accent); }
.ptype--gathering { background: color-mix(in srgb, var(--c-hunter) 14%, transparent); color: var(--c-hunter); }

/* Le due parti (Specializzazioni / Skill-up), separate da un titolo numerato. */
.prof-sec { margin-top: 0.6rem; }
.prof-sec + .prof-sec { margin-top: 1.6rem; }
.sec-title { display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; font-weight: 700; color: var(--text); margin: 0 0 0.7rem; }
.sec-num { display: grid; place-items: center; width: 20px; height: 20px; border-radius: 999px; background: var(--accent); color: #fff; font-size: 0.72rem; font-weight: 700; flex-shrink: 0; }
.sec-range { margin-left: 0.3rem; font-size: 0.78rem; font-weight: 600; color: var(--text-subtle); font-variant-numeric: tabular-nums; }
/* Hint di sezione (NON un titolo di pagina): spiega in chiaro i numeri .pnode-cap,
   altrimenti leggibili solo nel title in hover (invisibile su touch). */
.sec-hint { margin-left: 0.4rem; font-size: 0.72rem; font-weight: 400; color: var(--text-subtle); font-style: italic; }

/* Parte 1: spec di primo livello affiancate in colonne. */
.spec-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--grid-gap); }
.spec { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--card-pad); }
.spec-head { border-bottom: 1px solid var(--border-light); padding-bottom: 0.5rem; margin-bottom: 0.5rem; }
.spec-head .pnode-name { font-size: var(--fs-lg); font-weight: 700; }

/* ⚠️ I nodi FIGLI li produce renderNode via set:html, quindi NON hanno l'attributo
   [data-astro-cid-…] con cui Astro scopa gli stili: le loro regole DEVONO stare in
   :global(), altrimenti il cap resta un numero nudo incollato al nome invece che una
   pastiglia a destra. Stesso motivo per cui transmog e roster usano :global sulle voci
   create a runtime. Le classi .pnode-* sono uniche di questa pagina: il global non esce. */
:global(.pnode-head) { display: flex; align-items: baseline; gap: 0.5rem; }
:global(.pnode-name) { font-weight: 600; color: var(--text); line-height: 1.3; min-width: 0; }
:global(.pnode-cap) {
  margin-left: auto; flex-shrink: 0; font-size: 0.75rem; font-weight: 700;
  color: var(--accent); background: var(--accent-soft); border-radius: 999px;
  padding: 0.05rem 0.5rem; font-variant-numeric: tabular-nums;
}
:global(.pnode-desc) { font-size: 0.76rem; color: var(--text-subtle); line-height: 1.4; margin: 0.2rem 0 0; }
:global(.pnode-kids) { margin: 0.45rem 0 0 0.3rem; padding-left: 0.7rem; border-left: 1px solid var(--border); display: flex; flex-direction: column; gap: 0.5rem; }
:global(.pnode) { min-width: 0; }
:global(.pnode .pnode-head) { font-size: 0.9rem; }

/* Parte 2: skill-up, una tappa per riga con la fascia "da-a" a sinistra. */
.lvl { list-style: none; display: flex; flex-direction: column; gap: 0; max-width: 620px; }
.lvl-step { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.45rem 0; border-bottom: 1px solid var(--border-light); }
.lvl-step:last-child { border-bottom: none; }
.lvl-range {
  flex-shrink: 0; min-width: 4.2rem; text-align: center; font-size: 0.76rem; font-weight: 700;
  color: var(--accent); background: var(--accent-soft); border-radius: 6px; padding: 0.1rem 0.35rem;
  font-variant-numeric: tabular-nums;
}
.lvl-action { font-size: 0.9rem; color: var(--text); line-height: 1.35; }
.lvl-note { color: var(--text-subtle); font-style: italic; }

.prof-empty { color: var(--text-subtle); font-size: 0.9rem; padding: 1rem; background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius-lg); }
.prof-empty strong { color: var(--text); }

/* Nota editoriale della professione: sul sito le note delle professioni SI vedono
   (unica eccezione nel repo), quindi restano in fondo. */
.prof-note { margin-top: 1.6rem; padding-top: 0.7rem; border-top: 1px solid var(--border-light); font-size: 0.8rem; color: var(--text-subtle); line-height: 1.5; }

.chip-mono { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 4px; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 0.7rem; }
</style>

<script>
  function initProfessioni() {
    const chips = Array.from(document.querySelectorAll('#prof-chips .chip')) as HTMLButtonElement[];
    const panels = Array.from(document.querySelectorAll('.prof-panel')) as HTMLElement[];
    const expSel = document.getElementById('prof-exp') as HTMLSelectElement | null;
    const search = document.getElementById('prof-search') as HTMLInputElement | null;
    const emptyMsg = document.getElementById('prof-empty') as HTMLElement | null;
    if (!chips.length || !panels.length) return;

    // Filtra per testo il contenuto della professione VISIBILE: nasconde le card spec e le
    // tappe di leveling che non combaciano. Ri-eseguito a ogni cambio tab/espansione.
    function applySearch() {
      const q = (search?.value || '').trim().toLowerCase();
      const panel = panels.find(p => !p.hidden);
      if (!panel) return;
      const items = Array.from(panel.querySelectorAll('.spec, .lvl-step')) as HTMLElement[];
      let shown = 0;
      for (const it of items) {
        const match = q === '' || (it.dataset.search || '').includes(q);
        it.hidden = !match;
        if (match) shown++;
      }
      if (emptyMsg) emptyMsg.hidden = !(shown === 0 && q !== '');
    }
    if (search) search.addEventListener('input', applySearch);

    // Tab a selezione singola, stesso pattern di /transmog: una professione alla volta.
    // `focus` regola il roving tabindex + lo spostamento del focus da tastiera: 0 sul chip
    // attivo, -1 sugli altri, cosi' TAB entra/esce dalla tablist con un solo stop e le
    // frecce muovono la selezione dentro (pattern ARIA "tabs, automatic activation").
    const select = (chip: HTMLButtonElement, focus = false) => {
      const target = chip.dataset.prof || '';
      for (const c of chips) {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-selected', on ? 'true' : 'false');
        c.tabIndex = on ? 0 : -1;
      }
      for (const p of panels) p.hidden = p.dataset.prof !== target;
      if (focus) chip.focus();
      applySearch();   // la ricerca vale sulla professione attiva: ri-filtra il nuovo pannello
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => select(chip));
      // Navigazione da tastiera nella tablist: frecce = chip precedente/successivo (con
      // wrap), Home/End = primo/ultimo. Attiva subito e sposta il focus.
      chip.addEventListener('keydown', (e) => {
        const i = chips.indexOf(chip);
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % chips.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + chips.length) % chips.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = chips.length - 1;
        else return;
        e.preventDefault();
        select(chips[next], true);
      });
    }

    // Tendina espansione: mostra il blocco [data-exp] scelto in ogni pannello e aggiorna
    // lo spegnimento dei chip. Oggi c'e' solo Midnight, ma il giro e' gia' completo.
    const applyExp = () => {
      const exp = expSel?.value || '';
      for (const panel of panels) {
        const blocks = Array.from(panel.querySelectorAll('.prof-exp')) as HTMLElement[];
        for (const b of blocks) b.hidden = b.dataset.exp !== exp;
        const active = blocks.find(b => b.dataset.exp === exp);
        const chip = chips.find(c => c.dataset.prof === panel.dataset.prof);
        if (chip) chip.classList.toggle('is-empty', active?.dataset.has !== '1');
      }
      applySearch();   // cambiato blocco espansione: ri-filtra il contenuto ora visibile
    };
    if (expSel) expSel.addEventListener('change', applyExp);
  }

  document.addEventListener('astro:page-load', initProfessioni);
</script>
