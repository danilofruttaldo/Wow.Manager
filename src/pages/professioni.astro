---
import Base from '../layouts/Base.astro';
import { getProfessions, getProfessionTrees, getProfessionLeveling, getProfessionBuilds,
         getProfessionSpecDescs, getProfExpansions, type Profession, type ProfNode } from '../lib/content';

// Tab per professione, come /transmog e' a tab per classe. Dentro ogni tab DUE sezioni:
//   1. Specializzazioni -- l'ORDINE CONSIGLIATO (builds.json, editoriale/verificato): card
//      sequenziali, "quali rami potenziare e in che ordine". Ogni card porta i PUNTI del ramo
//      (il `cap`/maxRanks del nodo, letto da trees.json). L'albero completo NON si mostra piu':
//      trees.json serve solo a ricavare quei numeri.
//   2. Skill-up 1 -> max -- la guida di leveling della skill (leveling.json), web-sourced.
// Una tendina sceglie l'espansione: oggi solo Midnight, ma struttura e controllo sono
// gia' pronti per aggiungere le passate.
const professions = getProfessions().sort((a, b) => (a.name ?? '').localeCompare(b.name ?? ''));
const trees = getProfessionTrees();          // key -> espansione -> albero
const leveling = getProfessionLeveling();    // key -> espansione -> guida skill
const builds = getProfessionBuilds();        // key -> espansione -> ordine consigliato
const specDescs = getProfessionSpecDescs();  // key -> nome-nodo -> descrizione breve (IT)
const expansions = getProfExpansions();      // quelle CON dati; oggi ["Midnight"]
const defaultExp = expansions[0] ?? 'Midnight';
// Elenco completo per la tendina: TUTTE le espansioni WoW da Classic a Midnight, in ordine di
// uscita; quelle senza dati restano <option disabled> (grigie). `expansions` (con dati) decide
// quali sono selezionabili -- oggi solo Midnight.
const ALL_EXPANSIONS = [
  'Classic', 'The Burning Crusade', 'Wrath of the Lich King', 'Cataclysm',
  'Mists of Pandaria', 'Warlords of Draenor', 'Legion', 'Battle for Azeroth',
  'Shadowlands', 'Dragonflight', 'The War Within', 'Midnight',
];
// Elenco reso in tendina: le note sopra + eventuali espansioni con dati non ancora in lista.
const expList = [...ALL_EXPANSIONS, ...expansions.filter(e => !ALL_EXPANSIONS.includes(e))];
const hasData = (exp: string) => expansions.includes(exp);

const TYPE_LABEL: Record<Profession['type'], string> = { crafting: 'Craft', gathering: 'Raccolta' };

const PROF_ICONS = new Set(
  Object.keys(import.meta.glob('/public/icons/prof/*.jpg', { eager: true }))
    .map(p => p.split('/').pop()!.replace(/\.jpg$/, '')),
);
const profIcon = (key: string) => (PROF_ICONS.has(key) ? `/icons/prof/${key}.jpg` : null);

const treeFor = (key: string, exp: string) => trees[key]?.[exp];
const levelFor = (key: string, exp: string) => leveling[key]?.[exp];
const buildFor = (key: string, exp: string) => builds[key]?.[exp];
const hasTree = (key: string, exp: string) => !!treeFor(key, exp)?.specs?.length;
const hasLevel = (key: string, exp: string) => !!levelFor(key, exp)?.steps?.length;
const hasBuild = (key: string, exp: string) => !!buildFor(key, exp)?.steps?.length;
// Un tab e' "vuoto" (chip spenta) solo se NESSUNA sezione ha dati per quell'espansione.
const hasAny = (key: string, exp: string) => hasBuild(key, exp) || hasTree(key, exp) || hasLevel(key, exp);
// Tab attivo di default: la prima professione (alfabetica) con qualcosa nell'espansione
// di default, cosi' all'apertura si vede contenuto reale e non due segnaposto.
const defaultKey = (professions.find(p => hasAny(p.key, defaultExp)) ?? professions[0])?.key;

// PUNTI del ramo per la card. Due fonti, il tag editoriale ha la precedenza:
//   1. il `tag` di builds.json quando indica un conteggio ("20 pt root", "10 pt", "40 pt"...):
//      e' la scelta VOLUTA di quanti punti mettere, e puo' divergere dal massimo del ramo
//      (skinning: "10 pt" su un ramo che ne regge 40). Include l'eventuale qualifica ("root").
//   2. altrimenti il `cap` (maxRanks) del nodo `spec`/`nodes`, dall'albero client (trees.json,
//      non piu' mostrato): il tetto del ramo, buono per i passi che si massano ("base", ecc.).
// Cosi' ogni card ha UN solo numero, senza il doppione "30 punti + 20 pt" che confondeva.
function tagPoints(tag: string | undefined): { n: number; rest: string } | null {
  const m = tag?.match(/^\s*(\d+)\s*pt\b\s*(.*)$/i);
  return m ? { n: Number(m[1]), rest: m[2].trim() } : null;
}
function capMap(tree: { specs?: ProfNode[] } | undefined): Map<string, number> {
  const m = new Map<string, number>();
  const walk = (n: ProfNode) => {
    if (n?.name != null && n.cap != null) m.set(n.name, n.cap);
    (n?.children ?? []).forEach(walk);
  };
  (tree?.specs ?? []).forEach(walk);
  return m;
}
function branchCap(step: { spec: string; nodes?: string[] }, caps: Map<string, number>): number | null {
  const names = step.nodes?.length ? step.nodes : [step.spec];
  const vals = names.map(n => caps.get(n)).filter((c): c is number => c != null);
  return vals.length ? Math.max(...vals) : null;
}
// Mappa nome-nodo -> desc del client (fallback delle descrizioni card, quando specs.json non
// copre ancora quel nodo). Nel client solo le spec di primo livello hanno una desc.
function clientDescMap(tree: { specs?: ProfNode[] } | undefined): Map<string, string> {
  const m = new Map<string, string>();
  const walk = (n: ProfNode) => {
    const d = (n?.desc ?? '').trim();
    if (n?.name != null && d) m.set(n.name, d);
    (n?.children ?? []).forEach(walk);
  };
  (tree?.specs ?? []).forEach(walk);
  return m;
}
// Descrizione breve della card: specs.json (IT, verificato) col nome-nodo del passo; per i
// passi composti ("uno solo") si usa il primo dei `nodes`. Fallback: desc del client.
function stepDesc(step: { spec: string; nodes?: string[] }, specForKey: Record<string, string>, cdesc: Map<string, string>): string | null {
  const dkey = step.nodes?.length ? step.nodes[0] : step.spec;
  return specForKey[dkey] ?? specForKey[step.spec] ?? cdesc.get(dkey) ?? cdesc.get(step.spec) ?? null;
}
---
<Base title="Professioni" description="Alberi di specializzazione e leveling WoW per professione: spec, punti massimi e skill-up, dal client.">
  <div class="wrap">
    <div class="filters row">
      <input id="prof-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca spec, nodo, tappa…" aria-label="Cerca nella professione attiva" />
      <div class="chips" id="prof-chips" role="tablist" aria-label="Scegli la professione">
        {professions.map(p => {
          const icon = profIcon(p.key);
          const empty = !hasAny(p.key, defaultExp);
          return (
            <button class:list={['chip', { 'is-active': p.key === defaultKey, 'is-empty': empty }]}
                    data-prof={p.key} type="button" role="tab"
                    id={`ptab-${p.key}`} aria-controls={`ppanel-${p.key}`}
                    tabindex={p.key === defaultKey ? 0 : -1}
                    aria-selected={p.key === defaultKey ? 'true' : 'false'}>
              {icon
                ? <img class="chip-ico" src={icon} alt="" width="18" height="18" />
                : <span class="chip-mono" aria-hidden="true">{p.name.charAt(0)}</span>}
              {p.name}
            </button>
          );
        })}
      </div>
      {/* Tendina espansione, in fondo ai filtri (spinta a destra da margin-left:auto). Mostra
         TUTTE le espansioni dell'era specializzazioni; selezionabili solo quelle con dati
         (oggi Midnight), le altre restano come <option disabled> (grigie). Quando builds/
         trees/leveling porteranno una nuova espansione, si abilita da sola via `hasData`. */}
      <label class="exp-pick">
        <span class="exp-pick-lbl">Espansione</span>
        <select id="prof-exp" class="select" aria-label="Scegli l'espansione" autocomplete="off">
          {expList.map(exp => (
            <option value={exp} disabled={!hasData(exp)} selected={exp === defaultExp}>{exp}</option>
          ))}
        </select>
      </label>
    </div>

    {professions.map(p => (
      <section class="prof-panel" data-prof={p.key} hidden={p.key !== defaultKey} role="tabpanel" id={`ppanel-${p.key}`} aria-labelledby={`ptab-${p.key}`}>
        <header class="prof-head">
          {profIcon(p.key)
            ? <img class="prof-ico" src={profIcon(p.key)!} alt="" width="40" height="40" />
            : <span class="prof-mono" aria-hidden="true">{p.name.charAt(0).toUpperCase()}</span>}
          <span class="prof-name">{p.name}</span>
          <span class={`badge ptype ptype--${p.type}`}>{TYPE_LABEL[p.type]}</span>
        </header>

        {expansions.map(exp => {
          const tree = treeFor(p.key, exp);   // non si mostra: serve solo per i cap dei rami
          const guide = levelFor(p.key, exp);
          const build = buildFor(p.key, exp);
          const okLevel = !!guide?.steps?.length;
          const okBuild = !!build?.steps?.length;
          // Cap dei rami: fallback dei punti quando il tag non li indica, e sorgente dei numeri
          // degli step auto.
          const caps = capMap(tree);
          // Descrizioni brevi delle card: specs.json (IT) col fallback sulla desc del client.
          const specForKey = specDescs[p.key] ?? {};
          const cdesc = clientDescMap(tree);
          // Step di completamento AUTO: dopo i passi curati, ogni nodo dell'albero client NON
          // ancora toccato (in ordine d'albero) diventa una card "riempi il ramo al suo cap",
          // finche' non sono coperti tutti i punti potenziali. Non e' un consiglio inventato:
          // e' "poi completa tutto il resto". Solo le prime 4 card si mostrano, il resto sotto
          // "mostra tutti" (vedi JS). ⚠️ Enumera anche i rami che una scelta curata segna come
          // alternativi ("uno solo"/"scegli una"): li elenca tutti, non e' un errore di lettura.
          const autoFor = (steps: { spec: string; alt?: string; nodes?: string[] }[]) => {
            const covered = new Set<string>();
            for (const s of steps) { covered.add(s.spec); if (s.alt) covered.add(s.alt); (s.nodes ?? []).forEach(n => covered.add(n)); }
            const out: { spec: string; auto: true }[] = [];
            const walk = (n: ProfNode) => {
              if (n?.name != null && n.cap != null && !covered.has(n.name)) out.push({ spec: n.name, auto: true });
              (n?.children ?? []).forEach(walk);
            };
            (tree?.specs ?? []).forEach(walk);
            return out;
          };
          // Liste da rendere: default + una per variante (es. Druido); a ciascuna appendiamo i
          // suoi step auto. La prima e' visibile, le altre nascoste (l'interruttore le scambia).
          const buildLists: { variant: string; steps: any[] }[] = okBuild
            ? [{ variant: 'default', steps: [...build!.steps, ...autoFor(build!.steps)] },
               ...(build!.variants ?? []).map(v => ({ variant: v.key, steps: [...v.steps, ...autoFor(v.steps)] }))]
            : [];
          return (
            <div class="prof-exp" data-exp={exp} data-has={okBuild || okLevel ? '1' : '0'} hidden={exp !== defaultExp}>
              {/* Sezione 1: SPECIALIZZAZIONI. Pannello con testata e corpo. Il corpo e' l'ORDINE
                 CONSIGLIATO (builds.json): CARD SEQUENZIALI, "come sviluppare la professione".
                 Ogni card = un passo: nome del ramo/spec + i PUNTI da metterci (cap dall'albero
                 client) prima di passare alla card successiva. L'albero completo non si mostra. */}
              <section class="prof-sec">
                <header class="sec-head">
                  <div class="sec-headtext">
                    <h2 class="sec-title">Specializzazioni</h2>
                    <p class="sec-sub">Come sviluppare la professione: in quali rami mettere i punti, nell'ordine</p>
                  </div>
                  {/* Interruttore variante (oggi solo Herbalism -> Druido): scambia l'ordine. */}
                  {build?.variants?.length ? (
                    <label class="build-toggle" title={`Mostra l'ordine consigliato per ${build.variants[0].label}`}>
                      <input type="checkbox" class="build-toggle-input" data-variant={build.variants[0].key} />
                      <span class="build-toggle-lbl">{build.variants[0].label}</span>
                    </label>
                  ) : null}
                </header>
                <div class="sec-body">
                  {okBuild
                    ? <div class="build-wrap">
                        {buildLists.map((lst, i) => (
                          <ol class="build" data-variant={lst.variant} hidden={i !== 0}>
                            {lst.steps.map((step, si) => {
                              const tp = tagPoints(step.tag);           // conteggio dal tag editoriale (precedenza)
                              const pts = tp ? tp.n : branchCap(step, caps);   // altrimenti il cap del ramo
                              const desc = stepDesc(step, specForKey, cdesc);  // breve descrizione (cosa fa il ramo)
                              return (
                                <li class="build-step"
                                    data-search={`${step.spec} ${step.alt ?? ''} ${step.tag ?? ''} ${desc ?? ''} ${step.note ?? ''}`.toLowerCase()}>
                                  {/* Numero esplicito (non contatore CSS): resta stabile anche quando
                                     collapse/ricerca nascondono delle card in mezzo. */}
                                  <span class="build-num" aria-hidden="true">{si + 1}</span>
                                  <div class="build-head">
                                    <span class="build-spec">{step.spec}</span>
                                    {step.alt && <span class="build-alt">oppure {step.alt}</span>}
                                  </div>
                                  {/* Breve descrizione: cosa fa/sblocca il ramo (specs.json, fallback client). */}
                                  {desc && <p class="build-desc">{desc}</p>}
                                  <div class="build-meta">
                                    {pts != null &&
                                      <span class="build-pts" title="Punti da mettere in questo ramo prima di passare alla card successiva">
                                        <span class="build-pts-n">{pts}</span> punti{tp?.rest && <span class="build-pts-q"> · {tp.rest}</span>}
                                      </span>}
                                    {/* Il tag si mostra solo se NON e' gia' il conteggio punti (che sta nel badge sopra). */}
                                    {step.tag && !tp && <span class="build-tag">{step.tag}</span>}
                                  </div>
                                  {/* Nota editoriale (il "perche'"), solo sulle card curate. */}
                                  {step.note && <p class="build-note">{step.note}</p>}
                                </li>
                              );
                            })}
                          </ol>
                        ))}
                        {/* Collapse: le prime 4 card sono visibili, il resto (soprattutto gli step
                           auto) sta qui sotto. Visibilita' e testo li gestisce il JS (nascosto se
                           <=4 card o durante la ricerca). */}
                        <button class="build-more" type="button" hidden>Mostra tutti</button>
                      </div>
                    : <p class="prof-empty">Ordine consigliato <strong>{exp}</strong> non ancora definito per <strong>{p.name}</strong>.</p>}
                </div>
              </section>

              {/* Sezione 2: SKILL-UP 1 -> max (leveling.json). */}
              <section class="prof-sec">
                <header class="sec-head">
                  <div class="sec-headtext">
                    <h2 class="sec-title">Skill-up</h2>
                    <p class="sec-sub">Come portare la professione da 1 al livello massimo</p>
                  </div>
                  {guide?.maxSkill && <span class="sec-range">1 → {guide.maxSkill}</span>}
                </header>
                <div class="sec-body">
                  {okLevel
                    ? <ol class="lvl">
                        {guide!.steps.map(s => (
                          <li class="lvl-step" data-search={`${s.from} ${s.to} ${s.action} ${s.note ?? ''}`.toLowerCase()}>
                            <span class="lvl-range">{s.from}–{s.to}</span>
                            <span class="lvl-action">{s.action}{s.note && <em class="lvl-note"> — {s.note}</em>}</span>
                          </li>
                        ))}
                      </ol>
                    : <p class="prof-empty">Guida di leveling <strong>{exp}</strong> non ancora inserita.</p>}
                </div>
              </section>
            </div>
          );
        })}
      </section>
    ))}
    <p class="empty" id="prof-empty" role="status" hidden>Nessun risultato per questa ricerca in questa professione.</p>
  </div>
</Base>

<style>
.prof-panel { padding-top: 0.4rem; }
.prof-panel[hidden] { display: none !important; }
.prof-exp[hidden] { display: none !important; }

.exp-pick { margin-left: auto; display: inline-flex; align-items: center; gap: 0.4rem; }
/* display:inline-flex vince sul [hidden] della UA stylesheet: forziamo (stesso motivo di
   .chip[hidden] in global.css). Cosi' con una sola espansione la tendina sparisce davvero. */
.exp-pick[hidden] { display: none !important; }
.exp-pick-lbl { font-size: 0.78rem; color: var(--text-subtle); }
/* L'aspetto della tendina sta in `.select` (global.css), condiviso con /mount. Qui niente
   regola su #prof-exp: un selettore per id vincerebbe sulla classe e la farebbe divergere
   di nuovo (l'id resta, ma serve solo al JS). */

.prof-head { display: flex; align-items: center; gap: 0.6rem; padding: 0.2rem 0 0.9rem; }
.prof-ico { width: 40px; height: 40px; border-radius: var(--radius-lg); border: 1px solid var(--border); object-fit: cover; max-width: none; }
.prof-mono { display: grid; place-items: center; width: 40px; height: 40px; border-radius: var(--radius-lg); background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: var(--fs-xl); }
.prof-name { font-weight: 700; font-size: var(--fs-xl); letter-spacing: -0.01em; }
.ptype { text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.64rem; }
.ptype--crafting  { background: var(--accent-soft); color: var(--accent); }
/* --c-hunter (#5E8E2E) su un suo tint chiaro dava ~3.3:1 (sotto AA su testo 0.64rem):
   si passa alla coppia token verde pensata apposta per il testo (--ok-text su tint --ok),
   ~4.9:1, mantenendo il segnale "verde = raccolta" e la simmetria con --crafting. */
.ptype--gathering { background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok-text); }

/* Le DUE sezioni (Specializzazioni / Skill-up): ognuna un pannello riquadrato con testata
   e corpo, cosi' sono nettamente distinte a colpo d'occhio. La testata e' una fascia bianca
   con filetto nella tinta della sezione (come la barra filtri); il corpo sta sul grigio di
   pagina, cosi' le card bianche dell'ordine consigliato e l'albero risaltano dentro. */
.prof-sec { margin-top: 0.8rem; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface); overflow: hidden; }
.prof-sec + .prof-sec { margin-top: 1.4rem; }
.sec-head { display: flex; align-items: center; gap: 0.6rem; padding: 0.7rem 1rem; background: var(--surface); border-bottom: 2px solid color-mix(in srgb, var(--section, var(--border)) 42%, var(--border)); }
.sec-headtext { min-width: 0; display: flex; flex-direction: column; gap: 0.05rem; }
.sec-title { font-size: var(--fs-lg); font-weight: 700; color: var(--text); margin: 0; }
.sec-sub { font-size: var(--fs-xs); font-weight: 400; color: var(--text-subtle); margin: 0; line-height: 1.3; }
/* Range "1 -> max" spinto a destra nella testata della sezione 2. */
.sec-range { margin-left: auto; flex-shrink: 0; font-size: var(--fs-sm); font-weight: 700; color: var(--accent); background: var(--accent-soft); border-radius: 999px; padding: 0.12rem 0.55rem; font-variant-numeric: tabular-nums; }
.sec-body { padding: 1rem; background: var(--bg); }

/* Interruttore variante d'ordine (oggi solo Herbalism -> Druido): checkbox nativa + etichetta,
   nella testata della sezione (spinto a destra). Spuntato = mostra l'ordine della variante. */
.build-toggle { display: inline-flex; align-items: center; gap: 0.35rem; margin-left: auto; font-size: var(--fs-xs); font-weight: 600; color: var(--text-subtle); cursor: pointer; user-select: none; }
.build-toggle:hover { color: var(--text); }
.build-toggle-input { width: 0.95rem; height: 0.95rem; margin: 0; accent-color: var(--accent); cursor: pointer; }
.build-toggle-input:checked ~ .build-toggle-lbl { color: var(--accent); }

/* SEZIONE 1 = card sequenziali (builds.json + completamento auto): "come sviluppare la
   professione". Ogni card e' un passo numerato: nome del ramo/spec + i punti da metterci.
   Griglia a 4 COLONNE: le prime 4 card (visibili a riposo) stanno su una riga, il resto sotto
   il "Mostra tutti" a righe di 4. Scende a 2 colonne su schermi medi, 1 su mobile. */
.build { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--grid-gap); }
@media (max-width: 900px) { .build { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 560px) { .build { grid-template-columns: 1fr; } }
/* display:grid vince sul [hidden] della UA: forziamo, cosi' la lista-variante nascosta
   sparisce davvero (stesso motivo di .exp-pick[hidden] / .chip[hidden]). */
.build[hidden] { display: none !important; }
.build-step {
  position: relative;
  padding: 0.5rem 0.85rem 0.55rem 2.5rem;
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
}
/* Pastiglia numerata a sinistra: numero esplicito dal template (stabile con collapse/ricerca). */
.build-num {
  position: absolute; left: 0.6rem; top: 0.55rem;
  display: grid; place-items: center; width: 20px; height: 20px; border-radius: 999px;
  background: var(--accent); color: #fff; font-size: 0.72rem; font-weight: 700;
  font-variant-numeric: tabular-nums;
}
.build-step[hidden] { display: none !important; }  /* collapse/ricerca nascondono le card non pertinenti */
.build-head { display: flex; align-items: baseline; gap: 0.35rem 0.5rem; flex-wrap: wrap; }
.build-spec { font-weight: 700; font-size: var(--fs-md); color: var(--text); }
.build-alt { font-size: var(--fs-sm); color: var(--text-subtle); }
/* Breve descrizione del ramo (cosa fa/sblocca): sotto il nome, sopra i punti. */
.build-desc { font-size: var(--fs-sm); color: var(--text-muted); line-height: 1.35; margin: 0.2rem 0 0; }
/* Riga dei metadati del passo: i PUNTI del ramo + l'eventuale tag. Sotto il nome del ramo. */
.build-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.4rem; }
/* Pastiglia dei punti: il numero (cap del ramo) risaltato + testo. E' il dato-chiave della card
   ("quanti punti metto qui"), quindi piu' marcato del tag: fondo pieno accent, non tint. */
.build-pts { display: inline-flex; align-items: baseline; gap: 0.3rem; font-size: var(--fs-xs); font-weight: 600; color: var(--accent); background: var(--accent-soft); border-radius: 999px; padding: 0.1rem 0.55rem; }
.build-pts-n { font-size: var(--fs-sm); font-weight: 800; font-variant-numeric: tabular-nums; }
/* Qualifica del conteggio (es. "root" da "20 pt root"): attenuata, dentro la stessa pastiglia. */
.build-pts-q { font-weight: 600; opacity: 0.75; }
.build-tag {
  font-size: 0.64rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em;
  color: var(--text-subtle); background: var(--border-light); border-radius: 999px; padding: 0.06rem 0.45rem;
}
.build-note { font-size: var(--fs-sm); color: var(--text-subtle); line-height: 1.4; margin: 0.4rem 0 0; }

/* Bottone "Mostra tutti / Mostra meno": apre le card oltre le prime 4 (soprattutto gli step
   auto). A tutta larghezza sotto la griglia; tinta di sezione sul bordo, come gli altri controlli. */
.build-more {
  margin-top: var(--grid-gap); width: 100%;
  font-family: inherit; font-size: var(--fs-sm); font-weight: 600; color: var(--text-muted);
  background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius-lg);
  padding: 0.5rem 0.75rem; cursor: pointer; transition: color var(--transition), border-color var(--transition);
}
.build-more:hover { color: var(--text); border-color: var(--section, var(--accent)); }
.build-more[hidden] { display: none !important; }

/* Parte 2: skill-up, una tappa per riga con la fascia "da-a" a sinistra. Larghezza piena
   del container (niente cap): le azioni sono testi lunghi e respirano meglio. */
.lvl { list-style: none; display: flex; flex-direction: column; gap: 0; }
.lvl-step { display: flex; gap: 0.75rem; align-items: baseline; padding: 0.45rem 0; border-bottom: 1px solid var(--border-light); }
.lvl-step:last-child { border-bottom: none; }
.lvl-range {
  flex-shrink: 0; min-width: 4.2rem; text-align: center; font-size: 0.76rem; font-weight: 700;
  color: var(--accent); background: var(--accent-soft); border-radius: 6px; padding: 0.1rem 0.35rem;
  font-variant-numeric: tabular-nums;
}
.lvl-action { font-size: 0.9rem; color: var(--text); line-height: 1.35; }
.lvl-note { color: var(--text-subtle); font-style: italic; }

.prof-empty { color: var(--text-subtle); font-size: 0.9rem; padding: 1rem; background: var(--surface); border: 1px dashed var(--border); border-radius: var(--radius-lg); }
.prof-empty strong { color: var(--text); }

.chip-mono { display: grid; place-items: center; width: 18px; height: 18px; border-radius: 4px; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 0.7rem; }
</style>

<script>
  import { loadFilters, saveFilters } from '../lib/filter-state';

  function initProfessioni() {
    const chips = Array.from(document.querySelectorAll('#prof-chips .chip')) as HTMLButtonElement[];
    const panels = Array.from(document.querySelectorAll('.prof-panel')) as HTMLElement[];
    const expSel = document.getElementById('prof-exp') as HTMLSelectElement | null;
    const search = document.getElementById('prof-search') as HTMLInputElement | null;
    const emptyMsg = document.getElementById('prof-empty') as HTMLElement | null;
    if (!chips.length || !panels.length) return;

    // Interruttore variante d'ordine (oggi solo Herbalism -> Druido): oggi ce n'e' al piu'
    // uno in pagina, quindi lo stato sta in un singolo bool `druid`.
    const variantToggle = document.querySelector('.build-toggle-input') as HTMLInputElement | null;

    // Collapse: quante card dell'ordine si vedono a riposo prima del "Mostra tutti".
    const VISIBLE = 4;

    // Salva professione attiva + espansione + ricerca + stato variante (localStorage).
    const persist = () => saveFilters('professioni', {
      prof: chips.find(c => c.classList.contains('is-active'))?.dataset.prof || '',
      exp: expSel?.value || '',
      q: search?.value || '',
      druid: !!variantToggle?.checked,
    });

    // Filtra e/o collassa il contenuto della professione VISIBILE. Due comportamenti:
    //  - a RIPOSO (ricerca vuota): le card dell'ordine sono collassate (prime VISIBLE + "Mostra
    //    tutti"); le tappe di leveling tutte visibili.
    //  - in RICERCA: il collapse si sospende, si mostrano tutte le card/tappe che combaciano.
    // Solo il blocco espansione VISIBILE (con piu' espansioni un .prof-exp nascosto falserebbe
    // il conteggio "shown"). `.build:not([hidden])`: la lista-variante nascosta (Druido) e'
    // esclusa. Ri-eseguito a ogni cambio tab/espansione/variante.
    function applySearch() {
      const q = (search?.value || '').trim().toLowerCase();
      const panel = panels.find(p => !p.hidden);
      if (!panel) return;
      const searching = q !== '';
      let shown = 0;

      // Card dell'ordine consigliato (curate + auto): ricerca oppure collapse.
      const build = panel.querySelector('.prof-exp:not([hidden]) .build:not([hidden])') as HTMLElement | null;
      if (build) {
        const steps = Array.from(build.querySelectorAll('.build-step')) as HTMLElement[];
        const expanded = build.classList.contains('is-expanded');
        steps.forEach((it, i) => {
          const match = q === '' || (it.dataset.search || '').includes(q);
          const vis = searching ? match : (expanded || i < VISIBLE);
          it.hidden = !vis;
          if (searching && match) shown++;
        });
        // "Mostra tutti / Mostra meno": solo a riposo e con piu' di VISIBLE card.
        const moreBtn = build.parentElement?.querySelector('.build-more') as HTMLButtonElement | null;
        if (moreBtn) {
          moreBtn.hidden = searching || steps.length <= VISIBLE;
          moreBtn.textContent = expanded ? 'Mostra meno' : `Mostra tutti (${steps.length})`;
        }
      }

      // Tappe di leveling: pura ricerca.
      const lvls = Array.from(panel.querySelectorAll('.prof-exp:not([hidden]) .lvl-step')) as HTMLElement[];
      for (const it of lvls) {
        const match = q === '' || (it.dataset.search || '').includes(q);
        it.hidden = !match;
        if (searching && match) shown++;
      }

      if (emptyMsg) emptyMsg.hidden = !(shown === 0 && searching);
    }
    if (search) search.addEventListener('input', () => { applySearch(); persist(); });

    // Bottone "Mostra tutti / Mostra meno": espande/collassa le card della build visibile.
    for (const btn of Array.from(document.querySelectorAll('.build-more')) as HTMLButtonElement[]) {
      btn.addEventListener('click', () => {
        const build = btn.parentElement?.querySelector('.build:not([hidden])') as HTMLElement | null;
        if (!build) return;
        build.classList.toggle('is-expanded');
        applySearch();
      });
    }

    // Tab a selezione singola, stesso pattern di /transmog: una professione alla volta.
    // `focus` regola il roving tabindex + lo spostamento del focus da tastiera: 0 sul chip
    // attivo, -1 sugli altri, cosi' TAB entra/esce dalla tablist con un solo stop e le
    // frecce muovono la selezione dentro (pattern ARIA "tabs, automatic activation").
    const select = (chip: HTMLButtonElement, focus = false) => {
      const target = chip.dataset.prof || '';
      for (const c of chips) {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-selected', on ? 'true' : 'false');
        c.tabIndex = on ? 0 : -1;
      }
      for (const p of panels) p.hidden = p.dataset.prof !== target;
      if (focus) chip.focus();
      applySearch();   // la ricerca vale sulla professione attiva: ri-filtra il nuovo pannello
      persist();
    };

    for (const chip of chips) {
      chip.addEventListener('click', () => select(chip));
      // Navigazione da tastiera nella tablist: frecce = chip precedente/successivo (con
      // wrap), Home/End = primo/ultimo. Attiva subito e sposta il focus.
      chip.addEventListener('keydown', (e) => {
        const i = chips.indexOf(chip);
        let next = -1;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = (i + 1) % chips.length;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = (i - 1 + chips.length) % chips.length;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = chips.length - 1;
        else return;
        e.preventDefault();
        select(chips[next], true);
      });
    }

    // Tendina espansione: mostra il blocco [data-exp] scelto in ogni pannello e aggiorna
    // lo spegnimento dei chip. Oggi c'e' solo Midnight, ma il giro e' gia' completo.
    const applyExp = () => {
      const exp = expSel?.value || '';
      for (const panel of panels) {
        const blocks = Array.from(panel.querySelectorAll('.prof-exp')) as HTMLElement[];
        for (const b of blocks) b.hidden = b.dataset.exp !== exp;
        const active = blocks.find(b => b.dataset.exp === exp);
        const chip = chips.find(c => c.dataset.prof === panel.dataset.prof);
        if (chip) chip.classList.toggle('is-empty', active?.dataset.has !== '1');
      }
      applySearch();   // cambiato blocco espansione: ri-filtra il contenuto ora visibile
      persist();
    };
    if (expSel) expSel.addEventListener('change', applyExp);

    // Interruttore variante: mostra la <ol> con la variante scelta e nasconde le altre, dentro
    // la sua sezione. Spuntato = la variante di `data-variant`; non spuntato = 'default'.
    const applyVariant = () => {
      if (!variantToggle) return;
      const sec = variantToggle.closest('.prof-sec');
      if (!sec) return;
      const key = variantToggle.checked ? (variantToggle.dataset.variant || 'default') : 'default';
      for (const ol of Array.from(sec.querySelectorAll('.build')) as HTMLElement[]) {
        ol.hidden = ol.dataset.variant !== key;
      }
    };
    if (variantToggle) {
      variantToggle.addEventListener('change', () => { applyVariant(); applySearch(); persist(); });
    }

    // Ripristina l'ultima professione + espansione + ricerca + variante (localStorage). Valori
    // spariti (professione/espansione rimossa) -> resta il default renderizzato dal server.
    const saved = loadFilters('professioni', { prof: '', exp: '', q: '', druid: false });
    if (search && saved.q) search.value = saved.q;
    if (expSel && saved.exp && Array.from(expSel.options).some(o => o.value === saved.exp)) {
      expSel.value = saved.exp;
    }
    if (variantToggle && saved.druid) variantToggle.checked = true;
    applyVariant();                     // allinea la lista visibile allo stato dell'interruttore
    const savedChip = saved.prof ? chips.find(c => c.dataset.prof === saved.prof) : undefined;
    if (savedChip) select(savedChip);   // cambia professione + ri-filtra
    applyExp();                         // applica l'espansione + ri-filtra col testo ripristinato
  }

  document.addEventListener('astro:page-load', initProfessioni);
</script>
