---
import Base from '../layouts/Base.astro';
import { getPgHtml } from '../lib/content';

const html = getPgHtml();
---
<Base title="PG" description="Matrice razza × classe: copertura combinazioni e PG esistenti (Orda + Alleanza).">
  <div class="wrap pg-wrap">
    <article class="pg-prose" set:html={html}></article>
  </div>
</Base>

<style>
  /* Larghezza: eredita --page-max da .wrap (standard unico del sito), niente override. */
  /* Matrice: table-layout fixed + width 100% -> colonne adattive, testo a capo, niente scroll
     su desktop/tablet. Sotto i 640px scatta un min-width + scroll orizzontale (in fondo). */
  /* Bordo e raggio li porta il contenitore .table-scroll: qui li tolgo per non avere due
     filetti arrotondati annidati (la home fa gia' cosi', bordo solo sul contenitore). */
  .pg-prose :global(table) {
    font-size: var(--fs-sm); width: 100%; table-layout: fixed;
    overflow: hidden; background: var(--surface);
  }
  /* Misura UNICA delle icone dentro la cella PG (spec, wildcard, professioni). Sta qui e non
     a valori sparsi perche' e' anche l'altezza riservata alla fila: cambiandola si muovono
     insieme icone e altezza di cella. 16px = la stessa misura degli attributi width/height
     nell'HTML (content.ts) e di .spec-q in global.css, cosi' il "?" della spec da confermare
     e' largo quanto un'icona. */
  /* `--pg-cell-px` = padding orizzontale della cella. E' una variabile perche' serve DUE volte
     con segno opposto: qui, e come margine negativo in `.pg-multi`, dove il filetto fra due PG
     deve arrivare ai bordi della casella. Cambiandone uno solo, il filetto sfora o resta corto. */
  .pg-prose { --pg-ico: 16px; --pg-cell-px: 0.16rem; }
  .pg-prose :global(th), .pg-prose :global(td) {
    padding: 0.22rem var(--pg-cell-px); text-align: center; vertical-align: middle;
    white-space: normal; overflow-wrap: anywhere; line-height: 1.25;
    border-bottom: 1px solid var(--border-light); border-right: 1px solid var(--border-light);
  }
  .pg-prose :global(th:first-child), .pg-prose :global(td:first-child) { width: 56px; }
  /* Ultima colonna: niente border-right, si sdoppiava contro il bordo del .table-scroll. */
  .pg-prose :global(th:last-child), .pg-prose :global(td:last-child) { border-right: none; }
  .pg-prose :global(thead th) { background: var(--surface-2); padding: 0.32rem 0.16rem; }
  /* ⚠️ `min-width` va SEMPRE ridichiarato insieme a width: `.ico` in global.css porta
     `min-width: 26px`, e in un contenitore flex quel minimo VINCE sulla width. Senza questa
     riga le icone di razza e classe restavano a 26px pur essendo dichiarate 24. */
  .pg-prose :global(.ico) { width: 24px; height: 24px; min-width: 24px; }
  .pg-prose :global(.race-txt) { font-size: var(--fs-xs); font-weight: 600; }
  /* Nome sulla PRIMA riga, icone (spec + professioni) SEMPRE a capo sulla seconda: il gruppo
     e' una colonna, non piu' una riga che manda l'icona sotto solo quando non ci sta. Con tre
     icone accanto al nome la vecchia resa alternava celle su una riga e celle su due a seconda
     della lunghezza del nome; in colonna hanno tutte la stessa forma. `max-width: 100%` (sul
     gruppo e sul nome) tiene tutto dentro la colonna: un nome piu' largo della cella si spezza
     dall'overflow-wrap invece di sforare. La fila di icone va a capo da sola se sono troppe. */
  .pg-prose :global(.pg) { display: inline-flex; flex-direction: column; align-items: center; gap: 1px; max-width: 100%; vertical-align: middle; line-height: 1.2; }
  .pg-prose :global(.pg .pg-name) { max-width: 100%; text-align: center; overflow-wrap: anywhere; }
  /* `min-height` = altezza di un'icona: la fila e' emessa sempre (anche vuota) e occupa
     comunque la sua banda, cosi' le icone di tutte le celle di una riga sono allineate. */
  .pg-prose :global(.pg-icons) {
    display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center;
    gap: 2px 6px; max-width: 100%; min-height: var(--pg-ico); line-height: 1;
  }
  /* Il gap di `.pg-icons` (6px) separa i due GRUPPI — spec e professioni — mentre dentro il
     gruppo le icone stanno strette (2px): sono coppie, si leggono come un blocco solo. */
  .pg-prose :global(.pg-icons .ig) { display: inline-flex; align-items: center; gap: 1px; }
  /* Una regola sola per TUTTE le icone della fila (spec, wildcard, professioni): si prendono
     per elemento, non per classe, cosi' un'icona nuova nasce gia' della misura giusta.
     ⚠️ `min-width` e' obbligatorio: `.ico-prof` non ha una regola sua in global.css, quindi
     ereditava il `min-width: 26px` di `.ico` e le professioni uscivano larghe 26 e alte 18 —
     piu' grandi dell'icona spec accanto, e schiacciate. Con la wildcard le quattro icone
     sforavano la colonna e andavano a capo: quella cella era alta 20px piu' delle altre. */
  .pg-prose :global(.pg-icons img) {
    width: var(--pg-ico); height: var(--pg-ico); min-width: var(--pg-ico);
    border-radius: 3px; margin: 0; vertical-align: middle;
  }
  /* Ripieghi testuali (spec da confermare "?", iniziale fra parentesi): stessa banda delle
     icone, cosi' non allungano la riga quando compaiono al posto di un'immagine. */
  .pg-prose :global(.pg .spec-q), .pg-prose :global(.pg .prof-q) { margin: 0; width: var(--pg-ico); height: var(--pg-ico); min-width: var(--pg-ico); line-height: var(--pg-ico); vertical-align: middle; }
  .pg-prose :global(.pg .spec-l) { color: var(--text-muted); font-weight: 600; line-height: var(--pg-ico); }

  /* Piu' PG nella stessa casella: la casella si divide ORIZZONTALMENTE, un PG per fascia,
     con un filetto che la taglia da bordo a bordo (i margini negativi annullano il padding
     orizzontale del td). Prima erano solo due nomi impilati da un <br>: con due righe di
     icone a testa non si capiva dove finisse un PG e cominciasse l'altro. */
  .pg-prose :global(.pg-multi) {
    display: flex; flex-direction: column;
    margin-inline: calc(-1 * var(--pg-cell-px));
  }
  /* Il padding tolto al contenitore torna a ogni fascia, cosi' i nomi restano allineati
     con quelli delle celle a un PG solo. */
  .pg-prose :global(.pg-multi > .pg) { padding-inline: var(--pg-cell-px); }
  .pg-prose :global(.pg-multi > .pg + .pg) {
    border-top: 1px solid var(--border);
    margin-top: 0.22rem; padding-top: 0.22rem;
  }

  /* Tinta fazione tenue e uniforme per riga (identità Orda/Alleanza) */
  .pg-prose :global(tr.fac-horde)    { background: color-mix(in srgb, #C0202A 6%, var(--surface)); }
  .pg-prose :global(tr.fac-alliance) { background: color-mix(in srgb, #1E6FD0 6%, var(--surface)); }

  /* Colonna razza: neutra, staccata dalla tinta */
  /* .rhead e' un <th scope="row"> (lega le celle alla razza per gli screen reader):
     il font-weight normale annulla il grassetto di default del th e tiene la resa
     identica a quando era un <td>. */
  .pg-prose :global(th.rhead) { background: var(--surface-2); padding-left: 0.16rem; padding-right: 0.16rem; font-weight: 400; }
  /* `tbody tr:last-child td` in global.css non raggiunge piu' la cella-razza, che ora e' un th */
  .pg-prose :global(tbody tr:last-child th) { border-bottom: none; }

  /* Contatori: totale accanto all'icona (razza in riga, classe in testata) */
  .pg-prose :global(.rcell) { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
  /* Testata classe: contatore sotto l'icona invece che di fianco */
  .pg-prose :global(.rcell--stack) { flex-direction: column; gap: 2px; }
  .pg-prose :global(.rtot) {
    font-size: 0.72rem; font-weight: 700; color: var(--text);
    font-variant-numeric: tabular-nums; line-height: 1;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 4px; padding: 2px 3px;
  }

  /* Celle con un PG: bianche e in evidenza (risaltano sulle vuote tinte) */
  .pg-prose :global(tbody tr:not(.rsep) td:not(.rhead):not(:empty):not(:has(.na))) {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    font-weight: 600; color: var(--text);
  }

  /* Bande separatrici Orda / Alleanza */
  .pg-prose :global(tr.rsep td) { text-align: left; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.68rem; padding: 0.42rem 0.65rem; }
  .pg-prose :global(tr.rsep--horde td)    { background: color-mix(in srgb, #C0202A 20%, var(--surface)); color: #7c1720; }
  .pg-prose :global(tr.rsep--alliance td) { background: color-mix(in srgb, #1E6FD0 20%, var(--surface)); color: #14477f; }

  /* Combinazione non ottenibile: tratteggio LEGGERO che recede in secondo piano */
  .pg-prose :global(td:has(.na)) {
    background-color: color-mix(in srgb, var(--text) 4%, var(--surface));
    background-image: repeating-linear-gradient(45deg,
      color-mix(in srgb, var(--text) 10%, transparent) 0 1px,
      transparent 1px 7px);
  }
  .pg-prose :global(.na) { display: block; width: 100%; height: 100%; min-height: 1.5em; }

  /* Hover: evidenzia la riga senza coprire i PG bianchi */
  .pg-prose :global(tbody tr.fac-horde:hover)    { background: color-mix(in srgb, #C0202A 13%, var(--surface)); }
  .pg-prose :global(tbody tr.fac-alliance:hover) { background: color-mix(in srgb, #1E6FD0 13%, var(--surface)); }

  /* Mobile: sotto i 640px 14 colonne diventano celle da ~20px, coi nomi spezzati in verticale
     e illeggibili. Il "MAI scroll" vale su desktop/tablet (colonne adattive); qui sotto do alla
     tabella un min-width e lascio scorrere il .table-scroll in orizzontale, cosi' le colonne
     restano leggibili. Desktop invariato: width:100% >= min-width -> nessuno scroll. */
  @media (max-width: 640px) {
    .pg-prose :global(table) { min-width: 720px; }
  }
</style>
