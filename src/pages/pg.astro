---
import Base from '../layouts/Base.astro';
import { getPgHtml } from '../lib/content';

const html = getPgHtml();
---
<Base title="PG" description="Matrice razza × classe: copertura combinazioni e PG esistenti (Orda + Alleanza).">
  <div class="wrap pg-wrap">
    <article class="pg-prose" set:html={html}></article>
  </div>
</Base>

<style>
  /* Larghezza: eredita --page-max da .wrap (standard unico del sito), niente override. */
  /* Matrice: table-layout fixed + width 100% -> colonne adattive, testo a capo, niente scroll
     su desktop/tablet. Sotto i 640px scatta un min-width + scroll orizzontale (in fondo). */
  /* Bordo e raggio li porta il contenitore .table-scroll: qui li tolgo per non avere due
     filetti arrotondati annidati (la home fa gia' cosi', bordo solo sul contenitore). */
  .pg-prose :global(table) {
    font-size: var(--fs-sm); width: 100%; table-layout: fixed;
    overflow: hidden; background: var(--surface);
  }
  .pg-prose :global(th), .pg-prose :global(td) {
    padding: 0.3rem 0.22rem; text-align: center; vertical-align: middle;
    white-space: normal; overflow-wrap: anywhere; line-height: 1.25;
    border-bottom: 1px solid var(--border-light); border-right: 1px solid var(--border-light);
  }
  .pg-prose :global(th:first-child), .pg-prose :global(td:first-child) { width: 56px; }
  /* Ultima colonna: niente border-right, si sdoppiava contro il bordo del .table-scroll. */
  .pg-prose :global(th:last-child), .pg-prose :global(td:last-child) { border-right: none; }
  .pg-prose :global(thead th) { background: var(--surface-2); padding: 0.4rem 0.2rem; }
  .pg-prose :global(.ico) { width: 24px; height: 24px; }
  .pg-prose :global(.race-txt) { font-size: var(--fs-xs); font-weight: 600; }
  /* Nome e icona/e spec sulla STESSA riga quando ci stanno; se non ci stanno, e' l'ICONA a
     scendere sotto -- il nome non si accorcia mai. La chiave e' `flex: 0 0 auto` sul nome:
     non si stringe per far posto all'icona di fianco (era il vecchio difetto, nome tagliato
     a meta'), quindi resta intero e semmai spinge l'icona a capo. `max-width: 100%` lo tiene
     dentro la colonna: un nome piu' largo della cella si spezza dal `overflow-wrap` invece di
     sforare. `.pg` a `max-width: 100%` fa lo stesso per l'intero gruppo. flex-wrap manda
     l'icona a capo quando la riga e' piena, mai fuori dalla cella. Cosi' i nomi corti stanno
     su una riga sola -- meno spazio verticale sprecato e righe piu' uniformi. */
  .pg-prose :global(.pg) { display: inline-flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 2px 4px; max-width: 100%; vertical-align: middle; line-height: 1.2; }
  .pg-prose :global(.pg .pg-name) { flex: 0 0 auto; max-width: 100%; text-align: center; overflow-wrap: anywhere; }
  .pg-prose :global(.pg .ico-spec) { width: 18px; height: 18px; margin: 0; }
  .pg-prose :global(.pg .spec-q) { margin: 0; }
  .pg-prose :global(.pg .spec-l) { color: var(--text-muted); font-weight: 600; }
  /* Marcatore wildcard (gioca tutte le spec) accanto all'icona */
  .pg-prose :global(.pg .wild) { color: var(--accent); font-size: 0.85em; font-weight: 700; margin-left: -1px; }

  /* Tinta fazione tenue e uniforme per riga (identità Orda/Alleanza) */
  .pg-prose :global(tr.fac-horde)    { background: color-mix(in srgb, #C0202A 6%, var(--surface)); }
  .pg-prose :global(tr.fac-alliance) { background: color-mix(in srgb, #1E6FD0 6%, var(--surface)); }

  /* Colonna razza: neutra, staccata dalla tinta */
  /* .rhead e' un <th scope="row"> (lega le celle alla razza per gli screen reader):
     il font-weight normale annulla il grassetto di default del th e tiene la resa
     identica a quando era un <td>. */
  .pg-prose :global(th.rhead) { background: var(--surface-2); padding-left: 0.16rem; padding-right: 0.16rem; font-weight: 400; }
  /* `tbody tr:last-child td` in global.css non raggiunge piu' la cella-razza, che ora e' un th */
  .pg-prose :global(tbody tr:last-child th) { border-bottom: none; }

  /* Contatori: totale accanto all'icona (razza in riga, classe in testata) */
  .pg-prose :global(.rcell) { display: inline-flex; align-items: center; gap: 3px; white-space: nowrap; }
  /* Testata classe: contatore sotto l'icona invece che di fianco */
  .pg-prose :global(.rcell--stack) { flex-direction: column; gap: 2px; }
  .pg-prose :global(.rtot) {
    font-size: 0.72rem; font-weight: 700; color: var(--text);
    font-variant-numeric: tabular-nums; line-height: 1;
    background: var(--surface); border: 1px solid var(--border);
    border-radius: 4px; padding: 2px 3px;
  }

  /* Celle con un PG: bianche e in evidenza (risaltano sulle vuote tinte) */
  .pg-prose :global(tbody tr:not(.rsep) td:not(.rhead):not(:empty):not(:has(.na))) {
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--border);
    font-weight: 600; color: var(--text);
  }

  /* Bande separatrici Orda / Alleanza */
  .pg-prose :global(tr.rsep td) { text-align: left; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; font-size: 0.68rem; padding: 0.42rem 0.65rem; }
  .pg-prose :global(tr.rsep--horde td)    { background: color-mix(in srgb, #C0202A 20%, var(--surface)); color: #7c1720; }
  .pg-prose :global(tr.rsep--alliance td) { background: color-mix(in srgb, #1E6FD0 20%, var(--surface)); color: #14477f; }

  /* Combinazione non ottenibile: tratteggio LEGGERO che recede in secondo piano */
  .pg-prose :global(td:has(.na)) {
    background-color: color-mix(in srgb, var(--text) 4%, var(--surface));
    background-image: repeating-linear-gradient(45deg,
      color-mix(in srgb, var(--text) 10%, transparent) 0 1px,
      transparent 1px 7px);
  }
  .pg-prose :global(.na) { display: block; width: 100%; height: 100%; min-height: 1.5em; }

  /* Hover: evidenzia la riga senza coprire i PG bianchi */
  .pg-prose :global(tbody tr.fac-horde:hover)    { background: color-mix(in srgb, #C0202A 13%, var(--surface)); }
  .pg-prose :global(tbody tr.fac-alliance:hover) { background: color-mix(in srgb, #1E6FD0 13%, var(--surface)); }

  /* Mobile: sotto i 640px 14 colonne diventano celle da ~20px, coi nomi spezzati in verticale
     e illeggibili. Il "MAI scroll" vale su desktop/tablet (colonne adattive); qui sotto do alla
     tabella un min-width e lascio scorrere il .table-scroll in orizzontale, cosi' le colonne
     restano leggibili. Desktop invariato: width:100% >= min-width -> nessuno scroll. */
  @media (max-width: 640px) {
    .pg-prose :global(table) { min-width: 720px; }
  }
</style>
