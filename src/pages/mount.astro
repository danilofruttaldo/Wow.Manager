---
import Base from '../layouts/Base.astro';
import { getMounts, getMountSources, getMountStats, mountCats, mountBadges, MOUNT_CATS } from '../lib/content';

const mounts = getMounts();
const sources = getMountSources();
const stats = getMountStats();

// Le righe della provenienza come le scrive il gioco, una per campo ("Drop: Attumen the
// Huntsman" / "Location: Karazhan" / "Cost: 5000 Gold").
const srcLines = (m: (typeof mounts)[number]) =>
  (m.srcText ?? '').split('\n').map((s) => s.trim()).filter(Boolean);

// Nella card ci sta la PRIMA riga soltanto, cioe' la provenienza vera (Drop/Vendor/Quest).
// Concatenando anche zona, costo e fazione il testo superava i 40 caratteri su 909 card
// su 1527: sei righe su dieci finivano in ellissi e la colonna diventava una fila di
// puntini. Gli altri campi sono nella modale, dove hanno la loro etichetta.
const srcLabel = (m: (typeof mounts)[number]) =>
  srcLines(m)[0] || sources[String(m.src)] || 'Provenienza ignota';

// Una mount puo' stare in piu' categorie (volante che porta passeggeri), quindi i
// conteggi delle chip NON sommano al totale: e' lo stesso comportamento del menu di
// gioco, dove i filtri Type si spuntano insieme.
const catCount = (key: string) => mounts.filter((m) => mountCats(m).includes(key)).length;
// Categoria senza nemmeno una mount -> niente chip. «Altro» a zero e' la situazione
// buona: vuol dire che il diario ha classificato tutto. `chip: false` = categoria che
// esiste nei dati ma non e' uno dei quattro TIPI del gioco (skyriding), quindi resta
// pastiglia nella modale e fuori dai filtri.
const cats = MOUNT_CATS.filter((c) => c.chip !== false && catCount(c.key) > 0);

// Fonti presenti nei dati, per la tendina: ordinate per numero di mount (le grosse in
// testa), con il conteggio accanto.
const srcCounts = new Map<string, number>();
for (const m of mounts) {
  const k = String(m.src);
  srcCounts.set(k, (srcCounts.get(k) ?? 0) + 1);
}
const srcOptions = [...srcCounts.entries()]
  .map(([k, n]) => ({ k, n, label: sources[k] ?? 'Altro' }))
  .sort((a, b) => b.n - a.n || a.label.localeCompare(b.label));

---
<Base title="Mount" description="Collezione cavalcature: tutte le mount del gioco, quelle sbloccate e quelle che mancano, con la provenienza.">
  <div class="wrap" id="mount-main">
    <div class="filters row">
      <input id="mount-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca cavalcatura…" aria-label="Cerca cavalcatura" />
      <div class="chips" id="mount-state" role="group" aria-label="Filtra per stato">
        <button class="chip" data-state="1" type="button" aria-pressed="false"><img class="chip-ico" src="/icons/ui/ok.jpg" alt="" width="18" height="18" /> Sbloccate<span class="c">{stats.got}</span></button>
        <button class="chip" data-state="0" type="button" aria-pressed="false"><img class="chip-ico" src="/icons/ui/warn.jpg" alt="" width="18" height="18" /> Mancanti<span class="c">{stats.total - stats.got}</span></button>
      </div>
      <label class="sr-only" for="mount-src">Filtra per provenienza</label>
      <select id="mount-src" class="select">
        <option value="">Tutte le provenienze</option>
        {srcOptions.map(o => <option value={o.k}>{o.label} ({o.n})</option>)}
      </select>
      {/* Avanzamento della collezione: la pagina esiste per quello, e un numero secco
          in coda alla barra non lo fa vedere. La barretta e' decorativa (aria-hidden),
          il dato resta scritto accanto. */}
      <span class="prog" style={`--pct:${stats.pct}`} aria-hidden="true"></span>
      <span class="tally" id="tally">{stats.got} / {stats.total} · {stats.pct}%</span>
    </div>

    {/* Secondo asse di filtro su riga propria, come le chip spec di /macros: dentro
        `.filters.row` il contenitore chip si scioglie (display:contents, regola globale)
        e stato + categoria diventerebbero una fila sola col medesimo gap, cioe' due
        filtri indipendenti che sembrano un gruppo a selezione unica. */}
    <div class="chips cat-chips" id="mount-cats" role="group" aria-label="Filtra per categoria">
      {cats.map(c => (
        <button class="chip" data-cat={c.key} type="button" aria-pressed="false"><img class="chip-ico" src={c.icon} alt="" width="18" height="18" /> {c.label}<span class="c">{catCount(c.key)}</span></button>
      ))}
    </div>

    <div class="mount-grid" id="mount-grid">
      {mounts.map(m => (
        <button type="button" class="mcard" data-got={String(m.got)} data-cats={mountCats(m).join(' ')} data-src={String(m.src)}
                 data-full={m.srcText ?? ''} data-desc={m.desc ?? ''} data-spell={String(m.spell)} data-img={m.img}
                 data-srclabel={sources[String(m.src)] ?? ''}
                 data-badges={mountBadges(m).length ? JSON.stringify(mountBadges(m)) : undefined}
                 data-search={`${m.name} ${srcLines(m).join(' ')} ${sources[String(m.src)] ?? ''} ${m.class ?? ''} ${m.race ?? ''}`.toLowerCase()}>
          {m.icon
            ? <img class="mico" src={`/icons/mount/${m.icon}.jpg`} alt="" width="36" height="36" loading="lazy" decoding="async" />
            : <span class="mono" aria-hidden="true">{m.name.replace(/[^A-Za-z0-9]/g, '').charAt(0).toUpperCase()}</span>}
          <div class="mbody">
            <span class="mname">{m.name}</span>
            <span class="msrc">{srcLabel(m)}</span>
          </div>
          {/* Vincoli d'uso: fazione, classe e -- per le mount razziali dei paladini --
              anche la razza. Icone di gioco col nome nel tooltip, non testo. */}
          {(() => { const b = mountBadges(m); return b.length > 0 && (
            <span class="mreq">
              {b.map(x => x.icon
                ? <img class="mreq-ico" src={x.icon} alt={x.label} title={x.label} width="18" height="18" loading="lazy" decoding="async" />
                : <span class="mreq-txt" title={x.label}>{x.label}</span>)}
            </span>
          ); })()}
        </button>
      ))}
    </div>
    {/* Due messaggi che NON vanno mostrati insieme: senza dati la griglia e' vuota, quindi
        anche il filtro non trova nulla e prima uscivano entrambi. Ne renderizza uno solo
        (stessa distinzione vuoto/ricerca di /extra). */}
    {mounts.length === 0
      ? <p class="empty">Nessun dato: lancia <code>scripts\mount-sync.ps1</code> dopo un <code>/reload</code> in gioco.</p>
      : <p class="empty" id="empty" role="status" hidden>Nessuna cavalcatura trovata.</p>}
  </div>

  {/* Etichette e icone delle categorie, una volta sola: la modale le rimonta dalle
      chiavi in data-cats invece di ripeterle su ognuna delle ~1500 card. */}
  <script type="application/json" id="mount-maps" set:html={JSON.stringify(
    Object.fromEntries(MOUNT_CATS.map(c => [c.key, { label: c.label, icon: c.icon }])))}></script>

  {/* Guscio condiviso `.dlg*` (global.css), lo stesso di /addons: qui restano solo le
      parti proprie di questa modale — la fascia col render e le pastiglie. */}
  <div class="dlg" id="mlb" role="dialog" aria-modal="true" aria-labelledby="mlb-title">
    {/* `tabindex=-1`: all'apertura il focus va sul PANNELLO, non sulla ×. Portandolo
        sul bottone di chiusura la prima cosa che si vedeva era un grosso anello di
        focus verde sulla × -- l'occhio finiva li' invece che sulla cavalcatura. Il
        lettore di schermo annuncia comunque il dialog, e il Tab entra nella trappola
        dal primo controllo. */}
    <div class="dlg-panel" id="mlb-panel" tabindex="-1">
      <div class="dlg-head">
        <img class="dlg-ico" id="mlb-ico" src="/icons/section/mount.jpg" alt="" width="44" height="44" />
        <div class="dlg-htext">
          <strong class="dlg-title" id="mlb-title"></strong>
          {/* Stato a pastiglia con la stessa icona delle chip del filtro (ok/warn):
              scritto in chiaro, non affidato al solo colore. */}
          <span class="dlg-state" id="mlb-state">
            <img class="dlg-state-ico" id="mlb-state-ico" src="/icons/ui/ok.jpg" alt="" width="14" height="14" />
            <span id="mlb-state-txt"></span>
          </span>
        </div>
        {/* Frecce fra le card, come il lightbox di /ui (stesse ArrowLeft/ArrowRight e
            stesso giro circolare). Scorrono le card VISIBILI, cioe' rispettano il
            filtro attivo: con 1527 cavalcature sfogliare il sottoinsieme e' il modo
            normale di usarle. In testata e non sull'immagine, che 8 mount non hanno. */}
        <span class="dlg-pos" id="mlb-pos"></span>
        <button class="dlg-step dlg-prev" id="mlb-prev" type="button" aria-label="Precedente">&lsaquo;</button>
        <button class="dlg-step dlg-next" id="mlb-next" type="button" aria-label="Successiva">&rsaquo;</button>
        <button class="dlg-close" id="mlb-close" aria-label="Chiudi">&times;</button>
      </div>
      {/* Immagine del modello: il src lo mette il JS all'apertura, quindi le ~1500
          immagini non pesano sul caricamento della pagina. Fuori da .dlg-body per
          restare a piena larghezza e ferma mentre i campi scorrono. Le sorgenti sono
          600x600 (render ufficiali Blizzard): si mostrano a 320 CSS, cioe' con la
          riserva di risoluzione che serve agli schermi a densita' doppia. */}
      <div class="dlg-hero" id="mlb-hero" hidden>
        {/* Niente `src=""`: un src vuoto il browser lo risolve sull'URL della pagina e
            se la va a scaricare. L'attributo lo crea il JS quando serve. */}
        <img class="dlg-img" id="mlb-img" alt="" decoding="async" />
      </div>
      <div class="dlg-body">
        <div class="mlb-badges" id="mlb-badges"></div>
        <dl class="dlg-fields" id="mlb-fields"></dl>
        <p class="dlg-desc mlb-desc" id="mlb-desc" hidden></p>
        <a class="dlg-link extlink" id="mlb-link" href="#" target="_blank" rel="noopener noreferrer">
          {/* Niente spazio fra testo e icona: la spaziatura la da' il `gap` di `.extlink`,
              e uno spazio letterale ci si sommerebbe — la pastiglia della modale addon,
              che lo spazio non ce l'ha, risulterebbe piu' stretta a parita' di regola. */}
          <span>Scheda su Wowhead</span><img class="stat-ico" src="/icons/ui/external.jpg" alt="" width="14" height="14" /><span class="sr-only"> (apre in una nuova scheda)</span>
        </a>
      </div>
    </div>
  </div>
</Base>

<style>
/* Card fitte: sono 1527, quindi la griglia sta stretta (auto-fill su 260px) e ogni card
   e' una fascia bassa di icona + nome + provenienza, col nome al massimo su due righe. */
.mount-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: var(--grid-gap); padding-top: 0.6rem; }

/* Lo stato e' una barretta a sinistra, non un colore di fondo: verde = presa, grigio =
   manca. ⚠️ La barra delle mancanti era ROSSA: su 832 card mancanti di 1527 la griglia
   diventava una scacchiera rosso/verde che si leggeva come un elenco di errori, e
   filtrando «Mancanti» era un muro rosso pieno. Ma una mount che non hai non e' un
   guasto: e' il default. Il segnale di «presa» resta pieno (verde), il «manca» torna
   quieto -- grigio, fondo appena piu' scuro, icona smorzata -- e il colore in pagina
   dice una cosa sola. Non e' la rampa di /transmog, che vive in una matrice di poche
   celle dove il rosso ha spazio per significare qualcosa.
   `inset` invece di un border per non spostare il contenuto. */
.mcard {
  --bar: var(--ok);
  position: relative; display: flex; align-items: center; gap: 0.7rem;
  background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg);
  padding: 0.55rem 0.7rem; box-shadow: inset 3px 0 0 var(--bar); overflow: hidden;
  font: inherit; color: inherit; text-align: left; cursor: pointer;
  transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
  /* Le card sono 1527 e stanno TUTTE nel DOM (il filtro nasconde, non rimuove): senza
     contenimento il browser impagina e disegna anche le migliaia fuori schermo a ogni
     giro. `auto` come misura di riserva vuol dire "usa 56px finche' non l'hai vista,
     poi ricordati quella vera", cosi' la barra di scorrimento non salta. */
  content-visibility: auto;
  contain-intrinsic-size: auto 56px;
}
/* La barretta di stato e' un box-shadow: l'hover deve RIPETERLA, altrimenti
   aggiungendo l'ombra la si spegne e la card sembra cambiare stato al passaggio. La
   ripete via `--bar`, cosi' la regola vale per tutti e due gli stati invece di
   duplicarsi. Il sollevamento di 1px e' il feedback comune a tutte le card cliccabili
   del sito (/extra e /ui): la card apre una modale, quindi si comporta come quelle. */
.mcard:hover { border-color: var(--section, var(--accent)); box-shadow: inset 3px 0 0 var(--bar), var(--shadow-md); transform: translateY(-1px); }
.mcard[data-got="0"] { --bar: color-mix(in srgb, var(--text-subtle) 35%, var(--border)); background: var(--surface-2); }
/* Mancante: l'icona resta leggibile ma smorzata, cosi' la griglia si legge a colpo
   d'occhio senza doverla percorrere card per card. ⚠️ Era grayscale pieno a 0.55 di
   opacita': le icone di WoW sono la sola parte a colori della pagina, e cosi' meta'
   griglia diventava una fila di macchie grigie indistinguibili. Ora si riconoscono
   ancora, restando chiaramente in secondo piano. */
.mcard[data-got="0"] .mico { filter: grayscale(0.85); opacity: 0.72; }
.mcard[data-got="0"] .mname { color: var(--text-muted); }
.mcard[hidden] { display: none !important; }  /* display:flex vince su [hidden]: forziamo */

/* Stesso raggio delle icone-card del resto del sito (.aico di /addons, .xico di /extra,
   .prof-ico di /professioni): --radius-lg. Cambia solo la misura, non l'arrotondamento. */
.mico { flex-shrink: 0; width: 36px; height: 36px; min-width: 36px; border-radius: var(--radius-lg); border: 1px solid var(--border); object-fit: cover; max-width: none; }
.mono { flex-shrink: 0; display: grid; place-items: center; width: 36px; height: 36px; border-radius: var(--radius-lg); background: var(--accent-soft); color: var(--accent); font-weight: 700; }
.mbody { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.1rem; }
/* I nomi arrivano a 46 caratteri: senza limite una card a 3 righe alza TUTTA la riga
   della griglia (le celle si stirano alla piu' alta) e il ritmo si sfalda. Due righe
   bastano al nome piu' lungo alla colonna minima; il resto e' nella modale. */
.mname { font-size: var(--fs-md); font-weight: 600; line-height: 1.25; display: -webkit-box; -webkit-line-clamp: 2; line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
/* Provenienza su una riga sola: il testo del gioco puo' essere lungo (boss + zona) e
   qui conta il colpo d'occhio, non il testo integrale. */
.msrc { font-size: var(--fs-xs); color: var(--text-subtle); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
/* Vincoli: fila di icone a destra del nome. Restano piccole (18px) perche' sono un
   contorno del dato, non il dato: la card deve leggersi lo stesso senza guardarle. */
.mreq { flex-shrink: 0; align-self: center; display: flex; align-items: center; gap: 0.2rem; }
.mreq-ico { width: 18px; height: 18px; min-width: 18px; max-width: none; border-radius: 4px; border: 1px solid var(--border); object-fit: cover; }
/* Razza senza icona mappata: si scrive, non si perde. */
.mreq-txt { font-size: var(--fs-2xs); font-weight: 600; color: var(--text-muted); background: var(--border-light); border-radius: 999px; padding: 0.05rem 0.4rem; white-space: nowrap; }

/* La tendina delle provenienze usa `.select` di global.css, condiviso con /professioni. */
/* Riga delle categorie: fuori da `.filters` non c'e' il `display:contents`, quindi
   `.chips` (global.css) le dispone gia' in flex con gap 0.4rem — qui serve solo lo
   stacco dalla barra. Stesso trattamento di `.spec-chips` in /macros. */
.cat-chips { margin-top: 0.5rem; }
.tally { font-size: var(--fs-sm); font-weight: 600; color: var(--text-muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
/* Barretta di avanzamento: `--pct` (0-100, unitless) inline, come la rampa di
   /transmog. Sta in coda alla barra filtri insieme al contatore, di cui e' la lettura
   a colpo d'occhio -- non un elemento a se'. */
.prog { margin-left: auto; flex: none; width: 88px; height: 6px; border-radius: 999px; background: var(--border-light); border: 1px solid var(--border); overflow: hidden; }
.prog::after { content: ""; display: block; width: calc(var(--pct, 0) * 1%); height: 100%; background: var(--ok); border-radius: 999px; }

/* ── Modale di dettaglio ───────────────────────────
   Il guscio (overlay, pannello, testata, corpo, campi, link) e' `.dlg*` in global.css,
   condiviso con /addons. Qui resta solo quello che e' di questa modale. */

/* Qui le icone portano l'etichetta ACCANTO, non solo nel tooltip: nella card lo
   spazio non c'e', nella modale si'. */
.mlb-badges { display: flex; flex-wrap: wrap; gap: 0.35rem; }
/* ⚠️ Le pastiglie le crea il JS a runtime (`pill()`), quindi NON hanno l'attributo
   [data-astro-cid-…] con cui Astro scopa gli stili: senza :global() queste regole non le
   colpiscono affatto e categorie e vincoli escono come testo nudo in fila. Stesso inganno
   del tooltip di /transmog e della tabella di /pg. Il contenitore invece sta nel
   template, quindi tiene il suo scope e fa da ancora. */
.mlb-badges :global(span) { display: inline-flex; align-items: center; gap: 0.32rem; font-size: var(--fs-xs); font-weight: 600; color: var(--text-muted); background: var(--surface-2); border: 1px solid var(--border); border-radius: 999px; padding: 0.12rem 0.5rem 0.12rem 0.22rem; }
.mlb-badges :global(img) { width: 18px; height: 18px; min-width: 18px; max-width: none; border-radius: 999px; object-fit: cover; }

/* La provenienza (Vendor, Zone, Cost, Faction) usa i campi condivisi `.dlg-fields`.
   Qui l'unica differenza: il testo di COLORE del gioco e' in corsivo, perche' e' prosa
   di sapore e non un dato — sulla modale addon la stessa riga e' la descrizione di cosa
   fa l'addon, che prosa non e'. E' l'unico scostamento voluto fra le due modali. */
.mlb-desc { font-style: italic; }
</style>

<script>
  import { loadFilters, saveFilters } from '../lib/filter-state';
  import { initDialog, dialogPos, dialogField } from '../lib/dialog';

  function initMounts() {
    const grid = document.getElementById('mount-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('.mcard')) as HTMLElement[];
    const search = document.getElementById('mount-search') as HTMLInputElement;
    const stateChips = Array.from(document.querySelectorAll('#mount-state .chip')) as HTMLButtonElement[];
    const catChips = Array.from(document.querySelectorAll('#mount-cats .chip')) as HTMLButtonElement[];
    const srcSel = document.getElementById('mount-src') as HTMLSelectElement;
    const empty = document.getElementById('empty') as HTMLElement;
    const tally = document.getElementById('tally') as HTMLElement;
    const totali = tally?.textContent ?? '';

    const saved = loadFilters('mounts', { q: '', stato: '', cat: '', src: '' });
    let query = (saved.q || '').trim().toLowerCase();
    let stato = saved.stato || '';   // '' = tutte, '1' = sbloccate, '0' = mancanti
    let cat = saved.cat || '';
    let src = saved.src || '';
    const persist = () => saveFilters('mounts', { q: search?.value || '', stato, cat, src });

    // Indice letto UNA volta sola. `dataset` non e' un oggetto normale: ogni accesso
    // ricalcola il nome dell'attributo, e qui se ne leggevano quattro per ognuna delle
    // 1527 card a ogni battuta sulla ricerca. Anche lo `split` delle categorie era
    // rifatto da capo ogni volta. Ora il filtro lavora su valori gia' pronti.
    const idx = cards.map((card) => ({
      card,
      search: card.dataset.search || '',
      got: card.dataset.got || '',
      cats: (card.dataset.cats || '').split(' '),
      src: card.dataset.src || '',
    }));

    // Card visibili nell'ordine della griglia: le frecce della modale scorrono QUESTE,
    // cosi' «successiva» segue il filtro attivo invece di saltare in mezzo alle nascoste.
    let visible: HTMLElement[] = [];

    const apply = () => {
      visible = [];
      for (const it of idx) {
        // Le categorie sono una LISTA (una mount puo' essere volo + passeggero):
        // si confronta l'appartenenza, non l'uguaglianza.
        const show = (query === '' || it.search.includes(query))
          && (stato === '' || it.got === stato)
          && (cat === '' || it.cats.includes(cat))
          && (src === '' || it.src === src);
        // Si scrive solo quando cambia davvero: riassegnare `hidden` a tutte e 1527
        // invalida lo stile di ognuna anche dove non e' cambiato nulla.
        if (it.card.hidden === show) it.card.hidden = !show;
        if (show) visible.push(it.card);
      }
      const shown = visible.length;
      if (empty) empty.hidden = shown > 0;
      // Il totale resta sempre visibile: il numero filtrato da solo non direbbe
      // quanto manca alla collezione, che e' il dato per cui la pagina esiste.
      if (tally) tally.textContent = shown === cards.length ? totali : `${shown} mostrate · ${totali}`;
    };

    // Un gruppo di chip a selezione singola con ri-click che deseleziona: lo stesso
    // comportamento di /addons, qui riusato per stato e categoria.
    const gruppo = (chips: HTMLButtonElement[], attr: string, get: () => string, set: (v: string) => void) => {
      for (const chip of chips) {
        chip.addEventListener('click', () => {
          const v = chip.dataset[attr] || '';
          set(get() === v ? '' : v);
          for (const c of chips) {
            const on = c === chip && get() !== '';
            c.classList.toggle('is-active', on);
            c.setAttribute('aria-pressed', on ? 'true' : 'false');
          }
          apply();
          persist();
        });
      }
    };
    gruppo(stateChips, 'state', () => stato, (v) => { stato = v; });
    gruppo(catChips, 'cat', () => cat, (v) => { cat = v; });

    if (search) search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); apply(); persist(); });
    if (srcSel) srcSel.addEventListener('change', () => { src = srcSel.value; apply(); persist(); });

    // Ripristino dello stato salvato sul DOM, poi si filtra.
    if (search && saved.q) search.value = saved.q;
    if (srcSel && src) srcSel.value = src;
    for (const [chips, val, attr] of [[stateChips, stato, 'state'], [catChips, cat, 'cat']] as const) {
      if (!val) continue;
      for (const c of chips) {
        const on = (c.dataset[attr] || '') === val;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-pressed', on ? 'true' : 'false');
      }
    }
    apply();

    // ── Modale di dettaglio ────────────────────────────
    // Apertura, chiusura, Esc, frecce circolari e trappola del focus stanno in
    // `lib/dialog.ts`, condivisi con /addons: qui resta solo il riempimento.
    const lb = document.getElementById('mlb');
    const maps = JSON.parse(document.getElementById('mount-maps')?.textContent || '{}');
    if (lb) {
      const el = (id: string) => document.getElementById(id)!;
      const elBadges = el('mlb-badges');
      const elFields = el('mlb-fields');
      const elImg = el('mlb-img') as HTMLImageElement;

      const pill = (label: string, icon?: string) => {
        const s = document.createElement('span');
        if (icon) {
          const img = document.createElement('img');
          img.src = icon; img.alt = ''; img.width = 18; img.height = 18;
          s.appendChild(img);
        }
        s.appendChild(document.createTextNode(label));
        return s;
      };

      initDialog({
        id: 'mlb', mainId: 'mount-main', grid, cardSel: '.mcard',
        visible: () => visible,
        fill: (card) => {
          const got = card.dataset.got === '1';
          const nome = card.querySelector('.mname')?.textContent || '';
          el('mlb-title').textContent = nome;
          const ico = card.querySelector('.mico');
          (el('mlb-ico') as HTMLImageElement).src = ico?.getAttribute('src') || '/icons/section/mount.jpg';
          el('mlb-state-txt').textContent = got ? 'Sbloccata' : 'Mancante';
          (el('mlb-state-ico') as HTMLImageElement).src = got ? '/icons/ui/ok.jpg' : '/icons/ui/warn.jpg';
          // ⚠️ `className =` sostituisce l'attributo intero: va riscritta anche `dlg-state`.
          el('mlb-state').className = 'dlg-state ' + (got ? 'ok' : 'warn');

          // Non tutte hanno il modello (8 su 1527): senza, sparisce la fascia INTERA,
          // invece di lasciare una banda vuota sotto la testata.
          const img = card.dataset.img || '';
          el('mlb-hero').hidden = !img;
          if (img) { elImg.src = img; elImg.alt = nome; } else { elImg.removeAttribute('src'); }

          // Categorie (dalle chiavi in data-cats) + vincoli (gia' risolti a build-time
          // in data-badges, che c'e' solo dove serve).
          elBadges.textContent = '';
          for (const k of (card.dataset.cats || '').split(' ').filter(Boolean)) {
            const c = maps[k];
            if (c) elBadges.appendChild(pill(c.label, c.icon));
          }
          for (const b of JSON.parse(card.dataset.badges || '[]')) {
            elBadges.appendChild(pill(b.label, b.icon));
          }

          // Provenienza: il gioco la scrive gia' come "Etichetta: valore" una riga per
          // volta (Vendor, Zone, Cost, Faction), quindi diventa una lista di campi.
          // Le righe senza due punti (es. "Trading Post") restano valore senza etichetta.
          elFields.textContent = '';
          const srcLab = card.dataset.srclabel || '';
          const righe = (card.dataset.full || '').split('\n').map(s => s.trim()).filter(Boolean);
          // La categoria di sorgente («Drop», «Trading Post», «Vendor») si scrive solo se
          // le righe del gioco non la dicono gia' -- e quasi sempre la dicono, o come
          // riga nuda («Trading Post» sotto «SORGENTE: Trading Post», 198 mount) o come
          // etichetta della riga di dettaglio («DROP: Mistress Sassz'ine»). Prima usciva
          // comunque, e la lista si apriva con la stessa parola due volte di fila.
          const uguale = (a: string, b: string) => a.toLowerCase() === b.toLowerCase();
          // ⚠️ Solo quando l'ETICHETTA di una riga di dettaglio ripete la sorgente: se a
          // ripeterla e' una riga nuda («Trading Post»), la riga «Sorgente» va scritta
          // lo stesso -- e' quella nuda a essere saltata sotto -- altrimenti la modale
          // resterebbe senza nessun campo.
          const gia = righe.some(l => l.includes(': ') && uguale(l.slice(0, l.indexOf(': ')), srcLab));
          if (srcLab && !gia) dialogField(elFields, 'Sorgente', srcLab);
          for (const l of righe) {
            if (uguale(l, srcLab)) continue;
            const sep = l.indexOf(': ');
            // ⚠️ Etichetta vuota: `dialogField` scarta il VALORE vuoto, non l'etichetta,
            // quindi le righe nude restano (sono 198 mount col solo «Trading Post»).
            if (sep > 0) dialogField(elFields, l.slice(0, sep), l.slice(sep + 2));
            else dialogField(elFields, '', l);
          }
          // 7 mount non hanno ne' provenienza ne' etichetta di sorgente: si nasconde la
          // lista invece di lasciare la sua fetta di gap fra pastiglie e testo di colore.
          elFields.hidden = elFields.children.length === 0;

          const desc = card.dataset.desc || '';
          el('mlb-desc').textContent = desc;
          el('mlb-desc').hidden = !desc;
          (el('mlb-link') as HTMLAnchorElement).href = `https://www.wowhead.com/spell=${card.dataset.spell || ''}`;

          // Posizione nel sottoinsieme filtrato: con 1527 cavalcature dice quanto resta
          // da sfogliare, come il contatore in barra dice quanto manca alla collezione.
          dialogPos(lb, card, visible);
        },
      });
    }
  }

  document.addEventListener('astro:page-load', initMounts);
</script>
