---
import Base from '../layouts/Base.astro';
import { classLabel, titleCase } from '../lib/content';

// `*` non attraversa lo slash: questo glob prende solo la radice, non thumb/.
const files = Object.keys(
  import.meta.glob('/public/screenshots/*.jpg', { eager: true }),
).map((p) => p.replace('/public', ''));

// Miniature a 640px generate da scripts/make-thumbs.ps1 (stesso nome file).
// Le originali restano la sorgente del lightbox: in griglia sarebbero 2560px
// resi a ~300, cioe' ~9 MB scaricati per niente. Se la miniatura manca (script
// non ancora rilanciato dopo un nuovo screenshot) si ripiega sull'originale.
const thumbs = new Set(
  Object.keys(import.meta.glob('/public/screenshots/thumb/*.jpg', { eager: true }))
    .map((p) => p.replace('/public', '')),
);

const ALIAS: Record<string, string> = { deathknight: 'death-knight', demonhunter: 'demon-hunter' };
const shots = files.map((src) => {
  const stem = src.split('/').pop()!.replace(/\.[^.]+$/, '');
  const parts = stem.split('-');
  const className = ALIAS[parts[0]] ?? parts[0];
  const spec = parts[1] ?? '';
  const char = parts.slice(2).join('-') || parts[parts.length - 1];
  const thumbPath = `/screenshots/thumb/${stem}.jpg`;
  const thumb = thumbs.has(thumbPath) ? thumbPath : src;
  return { src, thumb, className, spec, char };
});

// Raggruppa per classe
const byClass = new Map<string, typeof shots>();
for (const s of shots) {
  if (!byClass.has(s.className)) byClass.set(s.className, []);
  byClass.get(s.className)!.push(s);
}
const groups = [...byClass.entries()]
  .map(([cls, list]) => [cls, list.sort((a, b) => a.char.localeCompare(b.char))] as const)
  .sort((a, b) => classLabel(a[0]).localeCompare(classLabel(b[0])));

const iconFor = (cls: string) => `/icons/class/${cls.replace(/-/g, '')}.jpg`;

// Chip filtro: TUTTE le 13 classi WoW, anche senza screenshot (count 0 → chip attenuata).
const ALL_CLASSES = ['warrior','paladin','hunter','rogue','priest','death-knight','shaman','mage','warlock','monk','druid','demon-hunter','evoker'];
const shotCountByClass = new Map(groups.map(([cls, list]) => [cls, list.length] as const));
const classChips = ALL_CLASSES
  .map((cls) => ({ cls, count: shotCountByClass.get(cls) ?? 0 }))
  .sort((a, b) => classLabel(a.cls).localeCompare(classLabel(b.cls)));

// indice globale per il lightbox (ordine = ordine di render)
let gi = 0;
---
<Base title="UI" description="La UI reale in gioco di ogni personaggio, per classe.">
  <div class="wrap" id="ui-main">
    <div class="filters row">
      <input id="ui-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca PG, classe, spec…" aria-label="Cerca screenshot" />
      <div class="chips" id="ui-filters" role="group" aria-label="Filtra per classe">
        {classChips.map(({ cls, count }) => (
          <button class:list={['chip', { 'is-empty': count === 0 }]} data-class={cls} type="button" aria-pressed="false">
            <img class="chip-ico" src={iconFor(cls)} alt="" width="18" height="18" />
            {classLabel(cls)}<span class="c">{count}</span>
          </button>
        ))}
      </div>
    </div>

    {groups.map(([cls, list]) => (
      <section class="class-group" data-class={cls}>
        <h2 class="group"><img class="ico ico-sm" src={iconFor(cls)} alt="" width="20" height="20" /> {classLabel(cls)}</h2>
        <div class="gallery">
          {list.map((s) => {
            const i = gi++;
            return (
              <button class="shot" style={`--pc: var(--c-${s.className})`} data-i={i} data-class={s.className} data-search={`${s.char} ${classLabel(s.className)} ${s.spec}`.toLowerCase()} data-src={s.src} data-char={titleCase(s.char)} data-who={`${classLabel(s.className)} · ${titleCase(s.spec)}`}>
                {/* Le prime ~3 thumb sono sopra la piega: eager per non penalizzare l'LCP; il resto lazy. `i` e' l'indice GLOBALE (gi++). */}
                <span class="imgwrap"><img src={s.thumb} alt={`UI di ${titleCase(s.char)}`} loading={i < 3 ? 'eager' : 'lazy'} decoding="async" width="640" height="360" /></span>
                <span class="cap">
                  <span class="cap-txt"><span class="ch">{titleCase(s.char)}</span></span>
                  <span class="sp">{titleCase(s.spec)}</span>
                </span>
              </button>
            );
          })}
        </div>
      </section>
    ))}
    <p class="empty" id="empty" role="status" hidden>Nessuno screenshot per questo filtro.</p>
  </div>

  <div class="lb" id="lb" role="dialog" aria-modal="true" aria-labelledby="lb-cap">
    <button class="lb-close" id="lb-close" aria-label="Chiudi">&times;</button>
    <button class="lb-nav lb-prev" id="lb-prev" aria-label="Precedente">&lsaquo;</button>
    <figure><img id="lb-img" alt="" /><figcaption id="lb-cap"></figcaption></figure>
    <button class="lb-nav lb-next" id="lb-next" aria-label="Successivo">&rsaquo;</button>
  </div>
</Base>

<style>
/* Lo scioglimento del contenitore chip (display:contents) ora e' globale in global.css,
   uguale per tutte le pagine. */

/* min(300px,100%): stessa protezione anti-overflow delle altre griglie su contenitore stretto. */
.gallery { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: var(--grid-gap); margin-bottom: 0.5rem; }
.shot { --pc: var(--accent); text-align: left; padding: 0; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; cursor: pointer; transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition); font: inherit; color: inherit; display: block; width: 100%; }
/* Come le card di /extra: le card cliccabili si sollevano su hover (feedback uniforme). */
.shot:hover { border-color: var(--pc); box-shadow: 0 2px 12px rgba(0,0,0,0.08); transform: translateY(-1px); }
/* `display:block` vince sull'attributo [hidden] (regola autore > UA): forziamo il nascondere. */
.shot[hidden] { display: none !important; }
.class-group[hidden] { display: none !important; }
.imgwrap { display: block; aspect-ratio: 16 / 9; background: #0a0a0a; }
.imgwrap img { width: 100%; height: 100%; object-fit: cover; }
.cap { display: flex; align-items: center; gap: 0.6rem; padding: 0.5rem 0.65rem; border-top: 3px solid var(--pc); }
.cap-txt { display: flex; flex-direction: column; min-width: 0; }
.ch { font-weight: 600; font-size: 0.92rem; }
.sp { margin-left: auto; font-family: var(--font-mono); font-size: 0.62rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-muted); background: color-mix(in srgb, var(--pc) 14%, transparent); border: 1px solid color-mix(in srgb, var(--pc) 40%, var(--border)); padding: 0.15rem 0.4rem; border-radius: var(--radius-sm); white-space: nowrap; }

.lb { position: fixed; inset: 0; z-index: 100; background: rgba(10,12,16,0.94); display: none; align-items: center; justify-content: center; padding: 0.5rem; }
.lb.open { display: flex; }
.lb figure { position: relative; margin: 0; max-width: 96vw; max-height: 94vh; display: flex; }
.lb img { max-width: 100%; max-height: 94vh; object-fit: contain; border-radius: 5px; }
.lb figcaption { position: absolute; left: 0; right: 0; bottom: 0; display: flex; align-items: center; gap: 0.75rem; color: #e8eaed; padding: 2rem 1rem 0.9rem; background: linear-gradient(transparent, rgba(10,12,16,0.85)); font-family: var(--font-mono); font-size: 0.78rem; }
.lb figcaption b { font-family: var(--font-sans); font-weight: 600; }
.lb figcaption span { color: color-mix(in srgb, #e8eaed 68%, transparent); letter-spacing: 0.02em; }
.lb-nav { position: absolute; top: 50%; transform: translateY(-50%); background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.18); color: #fff; width: 42px; height: 42px; border-radius: 50%; font-size: 1.3rem; cursor: pointer; display: flex; align-items: center; justify-content: center; }
.lb-nav:hover { background: rgba(255,255,255,0.16); }
.lb-prev { left: 1rem; } .lb-next { right: 1rem; }
/* Area cliccabile comoda su touch (~44px), oltre il minimo AA di 24px: il controllo di
   chiusura e' primario. Il glifo resta 1.6rem, centrato nell'area. */
.lb-close { position: absolute; top: 0.75rem; right: 1rem; z-index: 2; display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; background: none; border: 0; color: #fff; font-size: 1.6rem; line-height: 1; cursor: pointer; opacity: 0.85; }
.lb-close:hover { opacity: 1; }
</style>

<script>
import { loadFilters, saveFilters } from '../lib/filter-state';

// ── Stato del lightbox a livello di modulo ──
// Il listener da tastiera sta su `document` e va agganciato UNA volta sola (vedi
// initLbKeys): con ClientRouter `astro:page-load` rispara a ogni navigazione. Per
// questo lo stato non puo' vivere in una closure di pagina e i nodi si risolvono
// dentro le funzioni, non una volta per sempre. Stesso pattern di transmog.astro.
let lbList: HTMLButtonElement[] = [];
let lbIdx = 0;
let lbLastFocus: HTMLElement | null = null;

const lbEl = () => document.getElementById('lb');

function lbShow(i: number) {
  if (!lbList.length) return;
  lbIdx = (i + lbList.length) % lbList.length;
  const el = lbList[lbIdx];
  const img = document.getElementById('lb-img') as HTMLImageElement | null;
  const cap = document.getElementById('lb-cap');
  if (img) { img.src = el.dataset.src || ''; img.alt = el.dataset.char || ''; }
  // Costruito con textContent (non innerHTML): i valori vengono dai nomi-file, ma un nome
  // con < o & romperebbe il markup — meglio non passare mai da una stringa HTML.
  if (cap) {
    cap.replaceChildren();
    const b = document.createElement('b');
    b.textContent = el.dataset.char || '';
    const s = document.createElement('span');
    s.textContent = el.dataset.who || '';
    cap.append(b, s);
  }
}

// Alla chiusura il focus torna da dove era partito, altrimenti finisce su <body>
// e chi naviga da tastiera riparte dall'inizio della pagina.
function lbClose() {
  const lb = lbEl();
  if (!lb) return;
  lb.classList.remove('open');
  document.body.style.overflow = '';
  // Il contenuto della pagina (galleria + filtri) torna navigabile: era stato reso
  // inerte all'apertura. Non tocchiamo #main, che CONTIENE l'overlay stesso.
  document.getElementById('ui-main')?.removeAttribute('inert');
  lbLastFocus?.focus();
  lbLastFocus = null;
}

function initLbKeys() {
  if ((window as any).__uiLbKeys) return;
  (window as any).__uiLbKeys = true;

  document.addEventListener('keydown', (e) => {
    const lb = lbEl();
    if (!lb || !lb.classList.contains('open')) return;
    if (e.key === 'Escape') { lbClose(); return; }
    if (e.key === 'ArrowLeft') { lbShow(lbIdx - 1); return; }
    if (e.key === 'ArrowRight') { lbShow(lbIdx + 1); return; }
    if (e.key !== 'Tab') return;

    // Trappola del focus: dentro un dialog modale il Tab non deve uscire
    // sui contenuti della pagina, che restano inerti dietro l'overlay.
    const f = Array.from(lb.querySelectorAll<HTMLElement>('button'));
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    const cur = document.activeElement;
    if (e.shiftKey && (cur === first || !lb.contains(cur))) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && (cur === last || !lb.contains(cur))) { e.preventDefault(); first.focus(); }
  });
}

document.addEventListener('astro:page-load', () => {
  const lb = document.getElementById('lb');
  if (!lb) return;
  const allShots = Array.from(document.querySelectorAll<HTMLButtonElement>('.shot'));
  if (!allShots.length) return;

  // ── Filtri: search (testo) + chip classe (multi-selezione, unione) ──
  const search = document.getElementById('ui-search') as HTMLInputElement;
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('#ui-filters .chip'));
  const sections = Array.from(document.querySelectorAll<HTMLElement>('.class-group'));
  const empty = document.getElementById('empty');
  const activeClasses = new Set<string>();
  let query = '';
  // Salva ricerca + classi selezionate (multi, quindi array) in localStorage.
  const persist = () => saveFilters('ui', { q: search?.value || '', classes: [...activeClasses] });

  const applyFilter = () => {
    let shown = 0;
    for (const el of allShots) {
      const okClass = activeClasses.size === 0 || activeClasses.has(el.dataset.class || '');
      const okText = query === '' || (el.dataset.search || '').includes(query);
      const show = okClass && okText;
      el.hidden = !show;
      if (show) shown++;
    }
    // nascondi le sezioni classe senza screenshot visibili
    for (const sec of sections) {
      sec.hidden = !sec.querySelector('.shot:not([hidden])');
    }
    if (empty) empty.hidden = shown > 0;
  };

  if (search) search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); applyFilter(); persist(); });
  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const c = chip.dataset.class || '';
      if (activeClasses.has(c)) activeClasses.delete(c); else activeClasses.add(c);
      // `aria-pressed` va tenuto in sync con `is-active`: e' l'unico stato che
      // uno screen reader puo' leggere.
      const on = activeClasses.has(c);
      chip.classList.toggle('is-active', on);
      chip.setAttribute('aria-pressed', on ? 'true' : 'false');
      applyFilter();
      persist();
    });
  }

  // Ripristina ricerca + classi selezionate dall'ultima visita (localStorage).
  // Classi sparite (slug non piu' presente) -> semplicemente ignorate.
  const saved = loadFilters('ui', { q: '', classes: [] as string[] });
  if (search && saved.q) { search.value = saved.q; query = saved.q.trim().toLowerCase(); }
  if (Array.isArray(saved.classes) && saved.classes.length) {
    for (const chip of chips) {
      const c = chip.dataset.class || '';
      if (!saved.classes.includes(c)) continue;
      activeClasses.add(c);
      chip.classList.add('is-active');
      chip.setAttribute('aria-pressed', 'true');
    }
  }
  applyFilter();

  // ── Lightbox: naviga solo tra gli screenshot visibili ──
  lbList = allShots;
  function open(el: HTMLButtonElement) {
    // Da dove siamo arrivati, per poterci tornare alla chiusura.
    lbLastFocus = document.activeElement as HTMLElement | null;
    lbList = allShots.filter((s) => !s.hidden);
    lbShow(Math.max(0, lbList.indexOf(el)));
    lb!.classList.add('open'); document.body.style.overflow = 'hidden';
    // Sfondo inerte: lo screen reader non naviga galleria/filtri dietro l'overlay.
    // Rendiamo inerte il contenitore della pagina, NON l'overlay (che vive in #main).
    document.getElementById('ui-main')?.setAttribute('inert', '');
    (document.getElementById('lb-close') as HTMLButtonElement | null)?.focus();
  }
  allShots.forEach((el) => el.addEventListener('click', () => open(el)));
  document.getElementById('lb-close')!.addEventListener('click', lbClose);
  document.getElementById('lb-prev')!.addEventListener('click', (e) => { e.stopPropagation(); lbShow(lbIdx - 1); });
  document.getElementById('lb-next')!.addEventListener('click', (e) => { e.stopPropagation(); lbShow(lbIdx + 1); });
  lb.addEventListener('click', (e) => { if (e.target === lb) lbClose(); });

  initLbKeys();
});
</script>
