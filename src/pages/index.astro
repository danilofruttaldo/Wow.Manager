---
import Base from '../layouts/Base.astro';
import { getClassStats } from '../lib/content';

// Matrice per classe: una riga per classe, colonne = le metriche che il repo conosce
// per-classe (macro, PG, screenshot, transmog). Le colonne sono ordinabili (JS sotto);
// la nav della sezione vive ora nella toolbar in header (che ha assorbito i pulsanti che
// stavano qui), quindi la home e' solo questa tabella.
const stats = getClassStats();
const totMacro = stats.reduce((n, s) => n + s.macros, 0);
const totRoster = stats.reduce((n, s) => n + s.roster, 0);
const totShots = stats.reduce((n, s) => n + s.shots, 0);
const tmogGot = stats.reduce((n, s) => n + s.tmogGot, 0);
const tmogTotal = stats.reduce((n, s) => n + s.tmogTotal, 0);
const tmogPct = tmogTotal ? Math.round((tmogGot / tmogTotal) * 100) : 0;
---
<Base title="WoW Manager">
  <div class="wrap">
    <section class="cstats">
      <div class="cstats-scroll">
        <table class="cstats-tbl">
          <thead>
            <tr>
              <th scope="col" class="c-cls" aria-sort="ascending"><button type="button" class="sort-btn" data-type="text" aria-label="Ordina per classe">Classe</button></th>
              <th scope="col"><button type="button" class="sort-btn" data-type="num" aria-label="Ordina per numero di macro">Macro</button></th>
              <th scope="col"><button type="button" class="sort-btn" data-type="num" aria-label="Ordina per numero di PG">Roster</button></th>
              <th scope="col"><button type="button" class="sort-btn" data-type="num" aria-label="Ordina per numero di screenshot">UI</button></th>
              <th scope="col" class="c-tmog"><button type="button" class="sort-btn" data-type="num" aria-label="Ordina per completamento transmog">Transmog</button></th>
            </tr>
          </thead>
          <tbody>
            {stats.map(s => (
              <tr>
                <th scope="row" class="c-cls" data-v={s.label}>
                  <span class="c-clswrap">
                    <img class="c-ico" src={s.icon} alt="" width="26" height="26" />
                    <span>{s.label}</span>
                  </span>
                </th>
                <td data-v={s.macros}>{s.macros || <span class="c-zero">—</span>}</td>
                <td data-v={s.roster}>{s.roster || <span class="c-zero">—</span>}</td>
                <td data-v={s.shots}>{s.shots || <span class="c-zero">—</span>}</td>
                <td class="c-tmog" data-v={s.tmogPct}>
                  <span class="c-tcell" style={`--pct:${s.tmogPct}`}>
                    <span class="c-bar"><span class="c-fill" style={`width:${s.tmogPct}%`}></span></span>
                    <span class="c-val">{s.tmogPct}%</span>
                  </span>
                </td>
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <th scope="row" class="c-cls">Totale</th>
              <td>{totMacro}</td>
              <td>{totRoster}</td>
              <td>{totShots}</td>
              <td class="c-tmog">
                <span class="c-tcell" style={`--pct:${tmogPct}`}>
                  <span class="c-bar"><span class="c-fill" style={`width:${tmogPct}%`}></span></span>
                  <span class="c-val">{tmogPct}%</span>
                </span>
              </td>
            </tr>
          </tfoot>
        </table>
      </div>
    </section>
  </div>
</Base>

<script>
  import { loadFilters, saveFilters } from '../lib/filter-state';

  // Ordinamento client-side della matrice per classe. Ogni intestazione porta un <button>
  // (il controllo vero, azionabile da AT/tastiera); il <th> resta columnheader e porta
  // `aria-sort`. Click -> ordina per quella colonna; ri-click -> inverte. Testo A→Z al
  // primo click, numeri dal piu' alto. Il <tfoot> (Totale) resta fuori dall'ordinamento.
  function setupClassSort() {
    const table = document.querySelector<HTMLTableElement>('.cstats-tbl');
    if (!table) return;
    const tbody = table.tBodies[0];
    const ths = Array.from(table.tHead?.rows[0]?.cells ?? []) as HTMLTableCellElement[];
    let curCol = -1, curDir = 1;

    // Applica l'ordinamento su una colonna e aggiorna aria-sort. Estratto perche' lo usano
    // sia il click sia il ripristino da localStorage. Non salva: lo fa il chiamante.
    const applySort = (i: number, dir: number, type: string | undefined) => {
      curCol = i; curDir = dir;
      const rows = Array.from(tbody.rows);
      rows.sort((a, b) => {
        const av = a.cells[i].dataset.v ?? '';
        const bv = b.cells[i].dataset.v ?? '';
        const cmp = type === 'num' ? Number(av) - Number(bv) : av.localeCompare(bv, 'it');
        return cmp * dir;
      });
      rows.forEach((r) => tbody.appendChild(r));
      ths.forEach((t) => t.removeAttribute('aria-sort'));
      ths[i]?.setAttribute('aria-sort', dir === 1 ? 'ascending' : 'descending');
    };

    table.querySelectorAll<HTMLButtonElement>('.sort-btn').forEach((btn) => {
      const th = btn.closest('th') as HTMLTableCellElement;
      const i = th.cellIndex;
      const type = btn.dataset.type;
      btn.addEventListener('click', () => {
        const dir = curCol === i ? -curDir : (type === 'num' ? -1 : 1);
        applySort(i, dir, type);
        saveFilters('home', { col: i, dir });
      });
    });

    // Ripristina l'ultimo ordinamento scelto (localStorage). Colonna fuori range (tabella
    // cambiata) -> si ignora e resta l'ordine naturale renderizzato dal server.
    const saved = loadFilters('home', { col: -1, dir: 1 });
    if (saved.col >= 0 && saved.col < ths.length) {
      const type = ths[saved.col]?.querySelector<HTMLButtonElement>('.sort-btn')?.dataset.type;
      applySort(saved.col, saved.dir === -1 ? -1 : 1, type);
    }
  }
  document.addEventListener('astro:page-load', setupClassSort);
</script>

<style>
/* ── Matrice per classe ────────────────────────────
   Le metriche che il repo conosce per-classe, in un colpo d'occhio: macro, PG,
   screenshot e completamento transmog. Colonne ordinabili (click sull'intestazione). */
/* Larghezza: riempie .wrap (standard unico --page-max del sito), niente cap proprio. */
.cstats { margin: 0.5rem auto 0; }
.cstats-scroll { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius-lg); box-shadow: var(--shadow-sm); background: var(--surface); }
.cstats-tbl { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
.cstats-tbl th, .cstats-tbl td { padding: 0.5rem 0.75rem; text-align: center; }
.cstats-tbl thead th { font-size: 0.78rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.02em; color: var(--text-subtle); border-bottom: 1px solid var(--border); padding: 0; }
.cstats-tbl tbody tr { border-top: 1px solid color-mix(in srgb, var(--border) 60%, transparent); }
.cstats-tbl tbody tr:hover { background: color-mix(in srgb, var(--accent) 4%, transparent); }
.cstats-tbl td { font-variant-numeric: tabular-nums; font-weight: 600; }
.c-zero { color: var(--text-subtle); font-weight: 400; }

/* Intestazioni ordinabili: il controllo e' un <button> a tutta cella. Caret in CSS puro
   (triangolo da bordi, non glifo ne' SVG), semi-visibile = ordinabile, pieno = colonna
   attiva; ruota per asc/desc. */
.cstats-tbl .sort-btn {
  width: 100%; display: inline-flex; align-items: center; justify-content: center;
  gap: 0.1rem; padding: 0.5rem 0.75rem; font: inherit; color: inherit;
  text-transform: inherit; letter-spacing: inherit; background: none; border: 0;
  cursor: pointer; white-space: nowrap;
}
.cstats-tbl .c-cls .sort-btn { justify-content: flex-start; }
.cstats-tbl .sort-btn:hover { color: var(--accent); }
.cstats-tbl .sort-btn::after {
  content: ''; display: inline-block; width: 0; height: 0; margin-left: 0.35rem; flex: none;
  border-left: 4px solid transparent; border-right: 4px solid transparent;
  border-bottom: 5px solid currentColor; opacity: 0.42;
  transition: opacity var(--transition), transform var(--transition);
}
.cstats-tbl th[aria-sort='ascending'] .sort-btn::after { opacity: 0.95; }
.cstats-tbl th[aria-sort='descending'] .sort-btn::after { opacity: 0.95; transform: rotate(180deg); }

/* Colonna classe: icona + nome, allineata a sinistra. Il flex sta in uno span INTERNO,
   non sulla cella: `display:flex` su <th>/<td> la toglie dal table-layout e sfasa le
   colonne fra intestazione e corpo. */
.c-cls { text-align: left !important; white-space: nowrap; }
thead th.c-cls, tfoot th.c-cls { font-weight: 700; }
.c-clswrap { display: flex; align-items: center; gap: 0.5rem; font-weight: 600; }
.c-ico { width: 26px; height: 26px; border-radius: 6px; border: 1px solid var(--border); object-fit: cover; max-width: none; }

/* Colonna transmog: barra + percentuale, colorate sulla rampa rosso->giallo->verde. */
.c-tmog { min-width: 180px; width: 30%; }
.c-tcell { display: flex; align-items: center; gap: 0.6rem; }
.c-bar { flex: 1 1 auto; height: 7px; border-radius: 999px; background: color-mix(in srgb, var(--text) 8%, var(--surface)); overflow: hidden; }
.c-fill { display: block; height: 100%; border-radius: 999px; background: var(--tint); }
/* La % usa una versione SCURITA della tinta (mix con --text): mantiene il segnale del
   colore-rampa ma resta leggibile (il --tint puro sul verde/arancio e' sotto AA). */
.c-val { flex: none; min-width: 2.8rem; text-align: right; color: color-mix(in srgb, var(--tint) 55%, var(--text)); font-weight: 700; }
.c-tcell {
  --mix-warn: clamp(0%, calc(var(--pct, 0) * 2%), 100%);
  --mix-ok:   clamp(0%, calc((var(--pct, 0) - 50) * 2%), 100%);
  --tint: color-mix(in srgb,
            var(--ok) var(--mix-ok),
            color-mix(in srgb, var(--warn) var(--mix-warn), var(--bad)));
}

.cstats-tbl tfoot tr { border-top: 2px solid var(--border); }
.cstats-tbl tfoot th, .cstats-tbl tfoot td { font-weight: 800; }

/* Su schermo stretto la matrice va in scroll orizzontale dentro .cstats-scroll: tengo la
   colonna Classe ancorata a sinistra, altrimenti scorrendo verso destra si perde a quale
   riga appartengono i numeri. Sfondo opaco per coprire le celle che le passano sotto. */
@media (max-width: 640px) {
  .cstats-tbl th.c-cls { position: sticky; left: 0; }
  .cstats-tbl tbody th.c-cls { background: var(--surface); z-index: 2; }
  .cstats-tbl thead th.c-cls, .cstats-tbl tfoot th.c-cls { background: var(--surface-2); z-index: 3; }
}
</style>
