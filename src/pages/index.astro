---
import Base from '../layouts/Base.astro';
import { getAddons, getMacros, getProfessions, addonsMeta } from '../lib/content';

const addons = getAddons();
const macros = getMacros();
const professions = getProfessions();

const sections = [
  { href: '/addons', name: 'Addon', sub: 'versioni, source, note', count: `${addons.length}` },
  { href: '/macros', name: 'Macro', sub: 'per account/character', count: `${macros.length}` },
  { href: '/professioni', name: 'Professioni', sub: 'specializzazioni e ramo da maxare', count: `${professions.length}` },
  { href: '/roster', name: 'Roster', sub: 'matrice razza × classe', count: '' },
  { href: '/ui', name: 'UI', sub: 'screenshot in gioco per classe', count: '7' },
];
---
<Base title="Setup WoW Retail">
  <div class="wrap">
    <div class="phead">
      <h1>Setup WoW Retail</h1>
      <span class="meta">Stato versionato del setup di Stantu · build <code>{addonsMeta?.wow_build}</code> · sync <code>{addonsMeta?.last_sync}</code></span>
    </div>

    <div class="tiles">
      {sections.map(s => (
        <a class="tile" href={s.href}>
          <div class="t-body">
            <div class="t-name">{s.name}</div>
            <div class="t-sub">{s.sub}</div>
          </div>
          {s.count && <span class="t-count">{s.count}</span>}
        </a>
      ))}
    </div>
  </div>
</Base>
