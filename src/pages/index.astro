---
import Base from '../layouts/Base.astro';
import { getAddons, getMacros, getProfessions, getRosterCount, getExtra, getTransmog, getScreenshotCount } from '../lib/content';

const addons = getAddons();
const macros = getMacros();
const professions = getProfessions();
const rosterCount = getRosterCount();
const extra = getExtra();
const shots = getScreenshotCount();
// Completamento dei tier set, la stessa metrica dei chip per classe su /transmog ma
// su tutte le classi insieme. Contare invece le RIGHE della griglia non direbbe nulla
// sulla collezione, e sarebbe pure ambiguo: quante righe si vedono dipende dalla
// classe (`classStart` taglia quelle precedenti alla sua nascita, l'Evoker ne vede 15
// contro le 41 del guerriero). I set per tipo di armatura stanno sotto ogni classe che
// porta quel tipo, quindi pesano una volta per classe: e' il completamento della
// griglia del sito, non un inventario di apparenze distinte.
const tmog = getTransmog();
const tmogGot = tmog.reduce((n, c) => n + c.got, 0);
const tmogTotal = tmog.reduce((n, c) => n + c.total, 0);
const tmogPct = tmogTotal ? Math.round((tmogGot / tmogTotal) * 100) : 0;

const sections = [
  { href: '/addons',      name: 'Addon',       sub: 'addon installati e versioni', count: `${addons.length}`,     icon: '/icons/section/addon.jpg',  color: '#2E68D8' },
  { href: '/macros',      name: 'Macro',       sub: 'macro per account e PG',      count: `${macros.length}`,     icon: '/icons/section/macro.jpg',  color: '#7A5AF8' },
  { href: '/professioni', name: 'Professioni', sub: 'specializzazioni e rami',     count: `${professions.length}`, icon: '/icons/section/prof.jpg',  color: '#C77D0A' },
  { href: '/roster',      name: 'Roster',      sub: 'personaggi Orda e Alleanza',  count: `${rosterCount}`,       icon: '/icons/section/roster.jpg', color: '#C0202A' },
  { href: '/transmog',    name: 'Transmog',    sub: 'pezzi dei tier set collezionati', count: `${tmogPct}%`,      icon: '/icons/section/transmog.jpg', color: '#9B4DCA' },
  { href: '/ui',          name: 'UI',          sub: 'screenshot dell’interfaccia', count: `${shots}`,             icon: '/icons/section/ui.jpg',     color: '#159A8C' },
  { href: '/extra',       name: 'Extra',       sub: 'script di manutenzione e note', count: `${extra.length}`,    icon: '/icons/section/extra.jpg',  color: '#5B6470' },
];
---
<Base title="WoW Manager">
  <div class="wrap">
    <div class="home-grid">
      {sections.map(s => (
        <a class="home-btn" href={s.href} style={`--hc: ${s.color}`}>
          <img class="hb-icon" src={s.icon} alt="" width="56" height="56" />
          <span class="hb-title">{s.name}</span>
          <span class="hb-sub">{s.sub}</span>
          {s.count && <span class="hb-count">{s.count}</span>}
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
/* Home a "pulsantoni": griglia di grossi tasti a tessera, uno per sezione.
   Le colonne dichiarate sono il DOPPIO di quelle visibili (6 per 3, 4 per 2) e ogni
   card ne occupa due: serve a mezza colonna di gioco per centrare l'ultima riga
   quando resta incompleta (sotto), cosa che con 3 colonne secche non si puo' fare. */
.home-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.9rem; max-width: 1000px; margin: 0.5rem auto 0; }
.home-btn { grid-column: auto / span 2; }

/* Ultima riga spaiata: le sezioni sono 7, quindi su 3 colonne l'ultima card resterebbe
   sola a sinistra con due colonne di vuoto accanto. Spostandola al centro la griglia
   torna simmetrica. Le regole guardano la POSIZIONE (nth-child), non il 7 di oggi:
   aggiungere o togliere una sezione non le rompe, e con 9 card non scattano affatto. */
.home-btn:last-child:nth-child(3n + 1)      { grid-column: 3 / span 2; }  /* 1 sola in coda */
.home-btn:nth-last-child(2):nth-child(3n + 1) { grid-column: 2 / span 2; }  /* 2 in coda */

/* Sempre 2 o 3 colonne: sotto i 760px scende a 2, mai a colonna singola. */
@media (max-width: 760px) {
  .home-grid { grid-template-columns: repeat(4, 1fr); gap: 0.7rem; }
  /* Su 2 colonne le righe si spezzano altrove: le regole del 3 vanno spente, o
     centrerebbero una card che sta gia' in una riga piena. */
  .home-btn:last-child:nth-child(3n + 1),
  .home-btn:nth-last-child(2):nth-child(3n + 1) { grid-column: auto / span 2; }
  .home-btn:last-child:nth-child(2n + 1)        { grid-column: 2 / span 2; }
}

.home-btn {
  position: relative; display: flex; flex-direction: column; gap: 0.3rem;
  padding: 1.1rem 1.15rem; min-height: 116px;
  background: var(--surface); border: 1px solid var(--border);
  border-radius: var(--radius-lg); box-shadow: var(--shadow-sm);
  overflow: hidden;
  transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition), background var(--transition);
}
/* Sottile barra colore sezione in cima al pulsante */
.home-btn::before { content: ''; position: absolute; inset: 0 0 auto 0; height: 3px; background: var(--hc); }
.home-btn:hover { border-color: var(--hc); box-shadow: var(--shadow-md); transform: translateY(-1px); background: color-mix(in srgb, var(--hc) 5%, var(--surface)); }
.hb-icon {
  width: 42px; height: 42px; border-radius: 10px; margin-bottom: 0.35rem;
  border: 1px solid var(--border); object-fit: cover; max-width: none;
}
.hb-title { font-weight: 700; font-size: 1.1rem; letter-spacing: -0.01em; line-height: 1.15; }
.hb-sub { font-size: 0.83rem; color: var(--text-subtle); line-height: 1.3; }
.hb-count {
  position: absolute; top: 0.95rem; right: 1rem;
  font-size: 0.92rem; font-weight: 700; color: var(--hc);
  font-variant-numeric: tabular-nums; min-width: 1.6rem; text-align: center;
  background: color-mix(in srgb, var(--hc) 12%, var(--surface));
  border: 1px solid color-mix(in srgb, var(--hc) 28%, var(--border));
  padding: 0.1rem 0.5rem; border-radius: 999px;
}
</style>
