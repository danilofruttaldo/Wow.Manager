---
import Base from '../layouts/Base.astro';
import { getAddons, getMacros, getProfessions, getRosterCount } from '../lib/content';

const addons = getAddons();
const macros = getMacros();
const professions = getProfessions();
const rosterCount = getRosterCount();

const sections = [
  { href: '/addons',      name: 'Addon',       sub: 'addon installati e versioni', count: `${addons.length}`,     icon: '/icons/section/addon.jpg',  color: '#2E68D8' },
  { href: '/macros',      name: 'Macro',       sub: 'macro per account e PG',      count: `${macros.length}`,     icon: '/icons/section/macro.jpg',  color: '#7A5AF8' },
  { href: '/professioni', name: 'Professioni', sub: 'specializzazioni e rami',     count: `${professions.length}`, icon: '/icons/section/prof.jpg',  color: '#C77D0A' },
  { href: '/roster',      name: 'Roster',      sub: 'personaggi Orda e Alleanza',  count: `${rosterCount}`,       icon: '/icons/section/roster.jpg', color: '#C0202A' },
  { href: '/ui',          name: 'UI',          sub: 'screenshot dell’interfaccia', count: '10',                   icon: '/icons/section/ui.jpg',     color: '#159A8C' },
];
---
<Base title="WoW Manager">
  <div class="wrap">
    <div class="home-cards">
      {sections.map(s => (
        <a class="home-card" href={s.href} style={`--hc: ${s.color}`}>
          <img class="hc-icon" src={s.icon} alt="" width="46" height="46" />
          <span class="hc-text">
            <span class="hc-title">{s.name}</span>
            <span class="hc-sub">{s.sub}</span>
          </span>
          {s.count && <span class="hc-count">{s.count}</span>}
          <svg class="hc-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      ))}
    </div>
  </div>
</Base>

<style>
.home-cards { display: flex; flex-direction: column; gap: 0.7rem; max-width: 680px; margin: 0.25rem auto 0; }
.home-card {
  display: flex; align-items: center; gap: 1rem;
  padding: 1rem 1.15rem; background: var(--surface);
  border: 1px solid var(--border); border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
  transition: border-color var(--transition), box-shadow var(--transition), transform var(--transition);
}
.home-card:hover { border-color: var(--hc); box-shadow: var(--shadow-md); transform: translateY(-1px); }
.hc-icon {
  width: 46px; height: 46px; flex-shrink: 0; border-radius: 10px;
  border: 1px solid var(--border); object-fit: cover; max-width: none;
}
.hc-text { display: flex; flex-direction: column; min-width: 0; gap: 0.1rem; }
.hc-title { font-weight: 700; font-size: 1.08rem; letter-spacing: -0.01em; }
.hc-sub { font-size: 0.85rem; color: var(--text-subtle); }
.hc-count {
  margin-left: auto; font-size: 0.95rem; font-weight: 700; color: var(--hc);
  font-variant-numeric: tabular-nums;
  background: color-mix(in srgb, var(--hc) 12%, var(--surface));
  padding: 0.1rem 0.55rem; border-radius: 999px;
}
.hc-arrow { width: 18px; height: 18px; color: var(--text-subtle); flex-shrink: 0; transition: transform var(--transition), color var(--transition); }
.home-card:hover .hc-arrow { transform: translateX(3px); color: var(--hc); }
.home-card:not(:has(.hc-count)) .hc-arrow { margin-left: auto; }
</style>
