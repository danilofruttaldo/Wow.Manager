---
import Base from '../layouts/Base.astro';
import { getAddons, addonsMeta } from '../lib/content';

const addons = getAddons();
const sourceLabel = (s: string) => s === 'curseforge' ? 'CurseForge' : s;

// Build corrente → codice TOC atteso (es. "12.0.7.68235" → "120007") per l'indicatore di compatibilità.
const build: string = addonsMeta?.wow_build ?? '';
const [bMaj, bMin, bPat] = build.split('.');
const buildShort = bMaj && bMin != null && bPat != null ? `${bMaj}.${bMin}.${bPat}` : '';
const buildToc = buildShort ? String(Number(bMaj) * 10000 + Number(bMin) * 100 + Number(bPat)) : '';
const matchesBuild = (iface: string) => !!buildToc && iface.replace(/\s/g, '').split(',').includes(buildToc);
// Codice TOC (es. 120005) → versione leggibile (12.0.5).
const tocToVer = (toc: number) => `${Math.floor(toc / 10000)}.${Math.floor(toc / 100) % 100}.${toc % 100}`;
// Se non combacia col build, la versione di gioco più alta che l'addon dichiara di supportare.
const lastSupported = (iface: string) => {
  const codes = iface.replace(/\s/g, '').split(',').map(Number).filter(Boolean);
  return codes.length ? tocToVer(Math.max(...codes)) : '';
};
const updatedCount = addons.filter(a => matchesBuild(a.interface)).length;
const outdatedCount = addons.length - updatedCount;
---
<Base title="Addon" description="Addon WoW Retail installati: versione, cosa fanno e link, con ricerca in tempo reale.">
  <div class="wrap">
    <div class="filters row">
      <input id="addon-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca addon…" aria-label="Cerca addon" />
      <div class="chips" id="addon-filters" role="group" aria-label="Filtra per stato">
        <button class="chip" data-filter="updated" type="button" aria-pressed="false"><img class="chip-ico" src="/icons/ui/ok.jpg" alt="" width="18" height="18" /> Aggiornati<span class="c">{updatedCount}</span></button>
        <button class="chip" data-filter="outdated" type="button" aria-pressed="false"><img class="chip-ico" src="/icons/ui/warn.jpg" alt="" width="18" height="18" /> Da aggiornare<span class="c">{outdatedCount}</span></button>
      </div>
    </div>

    <div class="addon-grid" id="addon-grid">
      {addons.map(a => {
        return (
          <article class="acard" data-updated={matchesBuild(a.interface) ? '1' : '0'} data-search={`${a.name} ${a.desc ?? ''} ${a.version} ${a.source} ${(a.folders ?? []).join(' ')}`.toLowerCase()}>
            {a.icon
              ? <img class="aico" src={a.icon} alt="" width="38" height="38" loading="lazy" />
              : <span class="mono" aria-hidden="true">{a.name.replace(/[^A-Za-z0-9]/g, '').charAt(0).toUpperCase()}</span>}
            <div class="acard-body">
              <div class="acard-head">
                {a.url
                  ? <a href={a.url} target="_blank" rel="noopener noreferrer" class="acard-name">{a.name}</a>
                  : <span class="acard-name">{a.name}</span>}
                <span class="badge badge--accent acard-ver">{a.version}</span>
              </div>
              {a.desc && <p class="acard-desc">{a.desc}</p>}
              <div class="acard-meta">
                {matchesBuild(a.interface)
                  ? <span class="ok" title={`Interface: ${a.interface}`}><img class="stat-ico" src="/icons/ui/ok.jpg" alt="" width="14" height="14" /> {buildShort}</span>
                  : <span class="warn" title={`Non aggiornato al build ${buildShort}. Interface: ${a.interface}`}><img class="stat-ico" src="/icons/ui/warn.jpg" alt="" width="14" height="14" /> {lastSupported(a.interface)}</span>}
                {a.installed && <span title="Ultimo aggiornamento/installazione">agg. {a.installed}</span>}
                {a.url && <a href={a.url} target="_blank" rel="noopener noreferrer" class="acard-src">{sourceLabel(a.source)} ↗</a>}
              </div>
            </div>
          </article>
        );
      })}
    </div>
    <p class="empty" id="empty" role="status" hidden>Nessun addon trovato.</p>
  </div>
</Base>

<style>
/* Griglia a 3 colonne row-major: l'ordine alfabetico si legge per righe. 2 su medi, 1 su stretti. */
.addon-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.7rem; padding-top: 0.6rem; }
@media (max-width: 1200px) { .addon-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
@media (max-width: 820px) { .addon-grid { grid-template-columns: 1fr; } .filters { top: 0; } }

/* align-items:stretch (default della grid) → card della stessa riga ad altezza uguale, footer allineati. */
.acard { display: flex; align-items: stretch; gap: 0.9rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 0.85rem 1.05rem; }
.acard[hidden] { display: none !important; }  /* display:flex vince su [hidden]: forziamo */
.mono { align-self: flex-start; flex-shrink: 0; display: grid; place-items: center; width: 38px; height: 38px; border-radius: 8px; background: var(--accent-soft); color: var(--accent); font-weight: 700; font-size: 1.1rem; }
.aico { align-self: flex-start; flex-shrink: 0; width: 38px; height: 38px; min-width: 38px; border-radius: 8px; border: 1px solid var(--border); background: var(--surface); object-fit: cover; }
.acard-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 0.45rem; }
.acard-head { display: flex; align-items: baseline; gap: 0.55rem; flex-wrap: wrap; }
.acard-name { font-weight: 600; font-size: 1rem; line-height: 1.2; color: var(--text); }
a.acard-name:hover { color: var(--accent); text-decoration: underline; text-underline-offset: 2px; }
.acard-desc { font-size: 0.88rem; color: var(--text-muted); line-height: 1.5; margin: 0; }
/* Footer in fondo alla card, separato da una linea. */
.acard-meta { margin-top: auto; padding-top: 0.55rem; border-top: 1px solid var(--border-light); display: flex; flex-wrap: wrap; align-items: center; gap: 0.15rem 0.7rem; font-size: 0.74rem; color: var(--text-subtle); }.acard-meta .ok { color: var(--ok); font-weight: 600; display: inline-flex; align-items: center; gap: 0.28rem; }
.acard-meta .warn { color: var(--warn); font-weight: 600; display: inline-flex; align-items: center; gap: 0.28rem; }
.acard-src { margin-left: auto; color: var(--accent); font-weight: 600; }
.acard-src:hover { text-decoration: underline; text-underline-offset: 2px; }
</style>

<script>
  function initAddons() {
    const grid = document.getElementById('addon-grid');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll('.acard')) as HTMLElement[];
    const search = document.getElementById('addon-search') as HTMLInputElement;
    const chips = Array.from(document.querySelectorAll('#addon-filters .chip')) as HTMLButtonElement[];
    const empty = document.getElementById('empty') as HTMLElement;

    let query = '';
    let filter = ''; // '' = tutti, 'updated', 'outdated'

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const okText = query === '' || (card.dataset.search || '').includes(query);
        const okFilter = filter === '' || card.dataset.updated === (filter === 'updated' ? '1' : '0');
        const show = okText && okFilter;
        card.hidden = !show;
        if (show) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    if (search) search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); apply(); });
    for (const chip of chips) {
      chip.addEventListener('click', () => {
        const f = chip.dataset.filter || '';
        filter = filter === f ? '' : f;              // toggle: ri-click deseleziona
        // Lo stato attivo non deve vivere solo nella classe: `aria-pressed` e' quello
        // che uno screen reader legge, e va tenuto in sync con `is-active`.
        for (const c of chips) {
          const on = c === chip && filter !== '';
          c.classList.toggle('is-active', on);
          c.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        apply();
      });
    }
  }

  document.addEventListener('astro:page-load', initAddons);
</script>
