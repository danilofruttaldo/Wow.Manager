---
import Base from '../layouts/Base.astro';
import { getTransmog, transmogColumns } from '../lib/content';

const classes = getTransmog();
const cols = transmogColumns;
const ncols = cols.length + 1; // + colonna del nome set

// Le intestazioni (LFR/Normal/Heroic/Mythic) sono SLOT, non difficolta' letterali:
// su un terzo delle righe l'asse e' un altro -- Black Temple contro Sunwell, 10
// contro 25 uomini, Alleanza contro Orda, i tre item level del T10. Quello che
// conta e' l'aspetto del set, quindi dove l'etichetta della riga dice qualcosa di
// diverso dall'intestazione la si scrive nella cella. Dove coincide si tace, per
// non ripetere "Normal" sotto "Normal" su tutti i tier moderni.
const etichettaCol = Object.fromEntries(cols.map(c => [c.key, c.label]));

// Si tace anche dove l'etichetta non aggiunge nulla, altrimenti il rumore seppellisce
// il segnale: "Raid Finder" e' l'intestazione LFR detta con altre parole (24 righe), e
// "Versione unica" dice solo che la riga ha una colonna sola (8 righe). Restano scritte
// le sole 12 celle che dicono davvero qualcosa di diverso: Sunwell, Alleanza/Orda,
// 10/25 uomini, i tre item level del T10.
const MUTE = new Set(['Versione unica', 'Raid Finder']);
const spoglia = (s: string) => s.toLowerCase().replace(/[^a-z0-9]/g, '');
const daScrivere = (cell: { slot: string; label: string }) =>
  !!cell.label && !MUTE.has(cell.label) &&
  spoglia(cell.label) !== spoglia(etichettaCol[cell.slot] ?? '');
---
<Base title="Transmog" description="Set dei raid per classe: matrice set × versione, raggruppata per espansione.">
  <div class="wrap tmog-wrap">
    <div class="filters row">
      <div class="chips" id="tmog-chips" role="tablist" aria-label="Scegli la classe">
        {classes.map((c, i) => (
          <button class:list={['chip', { 'is-active': i === 0 }]} data-class={c.slug} type="button"
                  role="tab" id={`ttab-${c.slug}`} aria-controls={`tpanel-${c.slug}`} aria-selected={i === 0 ? 'true' : 'false'}>
            <img class="chip-ico" src={c.icon} alt="" width="18" height="18" />
            {/* Anche questo e' un contatore, e da solo dice una percentuale senza
                denominatore: il title scioglie in quanti pezzi su quanti. */}
            {c.label}<span class="c" title={`${c.got}/${c.total} pezzi collezionati`}
              >{Math.round((c.got / (c.total || 1)) * 100)}%</span>
          </button>
        ))}
      </div>
    </div>

    {classes.map((c, i) => (
      <section class="tmog-panel" data-class={c.slug} hidden={i !== 0} role="tabpanel" id={`tpanel-${c.slug}`} aria-labelledby={`ttab-${c.slug}`}>
        <div class="table-scroll">
          <table>
            <thead>
              <tr>
                <th class="thead-tier" scope="col">
                  <img class="ico" src={c.icon} alt="" width="24" height="24" />
                  <span>{c.label}</span>
                </th>
                {cols.map(col => <th scope="col">{col.label}</th>)}
              </tr>
            </thead>
            <tbody>
              {c.groups.map(g => (
                <Fragment>
                  <tr class="rsep"><td colspan={ncols}>{g.name}{g.note && <em> — {g.note}</em>}</td></tr>
                  {g.rows.map(r => {
                    // Senza nome del set il titolo E' gia' il nome del raid: la sigla ripeterebbe e basta.
                    const sigle = r.setName || r.raids.length > 1 ? r.raids : [];
                    // Intestazione del tooltip: nome del set + versione. Sui tier a
                    // versione singola l'etichetta non distingue nulla, quindi si omette.
                    const titolo = (cell: { label: string; setName?: string }) => {
                      const nome = cell.setName ?? r.setName ?? r.name;
                      return cell.label && cell.label !== 'Versione unica'
                        ? `${nome} — ${cell.label}` : nome;
                    };
                    // Nome del set, a sinistra, una riga per set. E' l'intestazione
                    // della riga, non un dato: <th scope="row"> perche' uno screen
                    // reader possa annunciarlo leggendo le celle. La resa non cambia
                    // (il font-weight lo riporta il CSS su th.rhead).
                    const intestazione = () => (
                      <th class="rhead" scope="row">
                        <span class="tname">
                          <strong>{r.setName ?? r.name}</strong>
                          {r.setName && r.tier.startsWith('T') && <span class="ttier">({r.tier})</span>}
                          {sigle.length > 0 && <span class="traid">
                            {sigle.map(([sigla, raid]) => <abbr title={raid}>{sigla}</abbr>)}
                          </span>}
                        </span>
                      </th>
                    );
                    // Il tooltip c'e' SEMPRE dove c'e' un contatore: se l'elenco pezzi
                    // manca resta almeno il titolo, invece di una cella muta.
                    //
                    // Le varianti che cadono nella STESSA colonna stanno dentro la
                    // stessa cella, una sotto l'altra: il T10 ha due Sanctified in
                    // Heroic e il T9 due fazioni in Normal. Prima erano sotto-righe
                    // separate, ognuna con tre caselle tratteggiate accanto: tre righe
                    // di tabella per tre numeri.
                    const varianti = (chiave: string) =>
                      r.cells.filter(c => c.colonna === chiave && c.state !== 'na');
                    // Colonne gia' occupate da una cella che si allarga (il T16 ne copre
                    // due): vanno saltate, altrimenti si disegna anche la casella sotto
                    // il colspan e la riga esce dalla tabella con una colonna di troppo.
                    const coperte = new Set<string>();
                    for (const c of r.cells) {
                      if (c.span < 2) continue;
                      const i = cols.findIndex(x => x.key === c.colonna);
                      for (let k = 1; k < c.span && cols[i + k]; k++) coperte.add(cols[i + k].key);
                    }
                    return (
                      <tr class="trow fine" style={`--pct:${r.pct}`}>
                        {intestazione()}
                        {cols.map(col => {
                          if (coperte.has(col.key)) return null;
                          const dentro = varianti(col.key);
                          if (dentro.length === 0) return <td><span class="na"></span></td>;
                          const tot = dentro.reduce((s, c) => s + c.total, 0);
                          const got = dentro.reduce((s, c) => s + c.got, 0);
                          return (
                            <td class="cell" colspan={dentro[0].span > 1 ? dentro[0].span : undefined}
                                style={`--pct:${tot ? (got / tot) * 100 : 0}`}>
                              {/* Il tooltip sta sulla singola variante, non sulla cella:
                                  in una cella possono essercene due, con pezzi diversi. */}
                              {dentro.map(cell => (
                                <span class="var has-tip" tabindex={0}
                                      data-tier={r.key} data-ver={cell.slot}
                                      data-tip-title={titolo(cell)}>
                                  {/* I pezzi non sono piu' inline: il JS li prende da
                                      /transmog/<classe>.json alla prima apertura del tab.
                                      Restano qui solo la chiave (tier, versione) e il titolo. */}
                                  <span class="frac">{cell.got}/{cell.total}</span>
                                  {cell.setName && <span class="vname">{cell.setName}</span>}
                                  {daScrivere(cell) && <span class="vlab">{cell.label}</span>}
                                  <span class="bar"><span class="bar-fill" style={`width:${(cell.got / cell.total) * 100}%`}></span></span>
                                </span>
                              ))}
                            </td>
                          );
                        })}
                      </tr>
                    );
                  })}
                </Fragment>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}

    {/* Popover dei pezzi mancanti: fuori dalla tabella, altrimenti l'overflow di
        .table-scroll lo taglierebbe. Posizionato via JS al passaggio sulla cella. */}
    <div class="tmog-tip" id="tmog-tip" role="tooltip" hidden>
      <div class="tip-head"></div>
      <ul class="tip-list"></ul>
    </div>
  </div>
</Base>

<style>
  .tmog-wrap { max-width: min(1200px, 96vw); }

  .tmog-panel[hidden] { display: none !important; }

  /* Matrice: colonna tier larga e a sinistra, 4 colonne versione strette e centrate. */
  .tmog-panel table {
    font-size: 0.78rem; width: 100%; table-layout: fixed;
    border: 1px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; background: var(--surface);
  }
  .tmog-panel th, .tmog-panel td {
    padding: 0.34rem 0.4rem; text-align: center; vertical-align: middle;
    border-bottom: 1px solid var(--border-light); border-right: 1px solid var(--border-light);
    line-height: 1.25;
  }
  /* Sticky a top:0: la tabella e' dentro `.table-scroll` (contenitore-scroll proprio),
     quindi la testata si incolla al bordo del contenitore, non al viewport — l'offset
     globale e' 0 e qui va bene cosi'. */
  .tmog-panel thead th { background: var(--surface-2); font-size: 0.72rem; padding: 0.45rem 0.4rem; }
  /* Con le righe impilate un set puo' occupare piu' <tr>: senza un confine piu' marcato
     non si capisce dove finisce un set e comincia il successivo. `fine` sta sull'ultima
     sotto-riga di ogni set; fra le sotto-righe dello stesso set il bordo resta appena
     accennato, cosi' le versioni si leggono come un blocco solo. */
  /* `th` accanto a `td`: la prima cella della riga e' <th scope="row"> (l'etichetta
     del set), quindi ogni regola di bordo deve nominarlo o quel bordo salta. */
  .tmog-panel tr.trow:not(.fine) > td, .tmog-panel tr.trow:not(.fine) > th { border-bottom-color: transparent; }
  .tmog-panel tr.trow.fine > td, .tmog-panel tr.trow.fine > th { border-bottom: 2px solid var(--border); }
  .tmog-panel th:first-child, .tmog-panel td:first-child { width: 46%; text-align: left; }
  /* Nelle righe impilate (T9) il nome sta a sinistra con un rowspan, quindi dalla
     seconda sotto-riga in poi la cella dei dati diventa il primo td: senza questo si
     prenderebbe l'allineamento a sinistra della colonna del nome. */
  .tmog-panel td.cell { text-align: center; }
  .tmog-panel .thead-tier { display: table-cell; }
  .tmog-panel .thead-tier .ico { width: 22px; height: 22px; vertical-align: middle; margin-right: 0.35rem; }
  .tmog-panel .thead-tier span { vertical-align: middle; font-weight: 700; }

  /* Etichetta di riga: nome del set + tier + sigle dei raid, a capo solo se serve. */
  /* `font-weight: 400` annulla il grassetto di default di <th>: il nome del set e'
     gia' dentro uno <strong>, il tier e le sigle devono restare smorzati. */
  .tmog-panel th.rhead { background: var(--surface-2); padding-left: 0.6rem; font-weight: 400; }
  .tmog-panel .tname { display: inline-flex; align-items: baseline; gap: 0.4rem; flex-wrap: wrap; }
  .tmog-panel .tname strong { font-size: 0.78rem; font-variant-numeric: tabular-nums; }
  .tmog-panel .ttier { color: var(--text-subtle); font-size: 0.7rem; font-variant-numeric: tabular-nums; }
  /* Sigle dei raid dove droppa il set: il nome per esteso sta nel tooltip dell'<abbr>. */
  .tmog-panel .traid { display: inline-flex; gap: 0.25rem; flex-wrap: wrap; }
  .tmog-panel .traid abbr {
    text-decoration: none; cursor: help;
    padding: 0.02rem 0.28rem; border: 1px solid var(--border-light); border-radius: 4px;
    background: var(--surface); color: var(--text-subtle);
    font-size: 0.6rem; font-weight: 700; letter-spacing: 0.03em;
  }
  /* Celle: frazione + barra di completamento, colore per stato. */
  .tmog-panel td.cell { font-variant-numeric: tabular-nums; font-weight: 600; }
  .tmog-panel .frac { display: block; font-size: 0.74rem; line-height: 1.15; }
  /* Contrasto della frazione n/total: `td.cell { color: var(--tint) }` la tingeva col
     colore pieno della rampa (verde/arancio ~4:1, sotto AA). La si scurisce mescolando
     la tinta col colore del testo, cosi' resta leggibile; la barra sotto tiene la tinta piena. */
  .tmog-panel .frac { color: color-mix(in srgb, var(--tint) 55%, var(--text)); }
  /* Etichetta della versione, scritta solo dove differisce dall'intestazione: e' il
     nome dell'ASPETTO (Sunwell, Sanctified (264), Alleanza), non della difficolta'. */
  /* Nome del set di questa versione: sulle righe a piu' aspetti ogni cella ha il
     suo, perche' i nomi differiscono davvero (T6 rogue: Slayer's Armor a Black
     Temple, Slayer's Battlegear a Sunwell). */
  .tmog-panel .vname {
    display: block; font-size: 0.66rem; line-height: 1.2; font-weight: 600;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .tmog-panel .vlab {
    display: block; font-size: 0.6rem; line-height: 1.2; opacity: 0.7;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .tmog-panel .bar { display: block; height: 3px; margin-top: 3px; border-radius: 999px; background: var(--border-light); overflow: hidden; }
  /* Cella che copre piu' colonne (righe impilate e T16): il contenuto resta largo
     come una colonna normale e centrato. Senza questo la barra si stira per tutta la
     tabella e sembra una sottolineatura invece che un indicatore di avanzamento. */
  .tmog-panel td.cell[colspan] .var { max-width: 150px; margin-left: auto; margin-right: auto; }
  .tmog-panel .bar-fill { display: block; height: 100%; border-radius: 999px; background: currentColor; }
  /* Rampa continua rosso -> giallo -> verde in funzione di --pct (0..100, unitless).
     Due mix in cascata: il primo porta bad -> warn nella prima meta', il secondo
     porta il risultato -> ok nella seconda. Le clamp tengono ferma la meta' che
     non e' ancora in gioco, cosi' 0 = rosso pieno e 100 = verde pieno senza salti. */
  .tmog-panel tr.trow, .tmog-panel td.cell {
    --mix-warn: clamp(0%, calc(var(--pct, 0) * 2%), 100%);
    --mix-ok:   clamp(0%, calc((var(--pct, 0) - 50) * 2%), 100%);
    --tint: color-mix(in srgb,
              var(--ok) var(--mix-ok),
              color-mix(in srgb, var(--warn) var(--mix-warn), var(--bad)));
  }

  /* Celle: frazione + barra, colorate sui pezzi sbloccati di quel blocco. */
  .tmog-panel td.cell { color: var(--tint); background: color-mix(in srgb, var(--tint) 10%, var(--surface)); }

  /* Riga: stessa rampa, ma sull'avanzamento complessivo dei blocchi del set.
     Il tint sta sulla riga; le celle ci mettono sopra il proprio colore. */
  .tmog-panel tr.trow { background: color-mix(in srgb, var(--tint) 8%, var(--surface)); }
  .tmog-panel tr.trow th.rhead { background: color-mix(in srgb, var(--tint) 18%, var(--surface)); }

  /* Bande espansione */
  .tmog-panel tr.rsep td {
    text-align: left; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;
    font-size: 0.68rem; padding: 0.45rem 0.65rem;
    background: color-mix(in srgb, var(--accent) 13%, var(--surface)); color: var(--accent);
  }
  .tmog-panel tr.rsep em { text-transform: none; letter-spacing: 0; font-weight: 500; opacity: 0.85; }

  /* Versione inesistente per questo set: tratteggio che recede (come il roster) */
  .tmog-panel td:has(.na) {
    background-color: color-mix(in srgb, var(--text) 4%, var(--surface));
    background-image: repeating-linear-gradient(45deg,
      color-mix(in srgb, var(--text) 10%, transparent) 0 1px,
      transparent 1px 7px);
  }
  .tmog-panel .na { display: block; width: 100%; height: 100%; min-height: 1.4em; }

  .tmog-panel tbody tr.trow:hover td:not(.rhead):not(:has(.na)) {
    background: color-mix(in srgb, var(--accent) 7%, var(--surface));
  }

  /* Cella con pezzi mancanti: la frazione segnala che c'e' il dettaglio sotto. */
  /* Una cella puo' contenere piu' varianti: il tooltip e il focus stanno su ognuna. */
  .tmog-panel .var { display: block; cursor: help; }
  .tmog-panel .var + .var { margin-top: 0.28rem; padding-top: 0.28rem; border-top: 1px dashed var(--border-light); }
  .tmog-panel .var .frac { text-decoration: underline dotted; text-underline-offset: 2px; }
  .tmog-panel .var:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }

  /* Popover: fisso rispetto al viewport, cosi' non lo taglia lo scroll della tabella. */
  .tmog-tip {
    position: fixed; z-index: 50; pointer-events: none;
    max-width: 22rem; padding: 0.5rem 0.65rem;
    border: 1px solid var(--border); border-radius: var(--radius-md);
    background: var(--surface); box-shadow: 0 8px 24px rgb(0 0 0 / 0.16);
    font-size: 0.74rem; line-height: 1.35;
  }
  .tmog-tip[hidden] { display: none; }
  .tmog-tip .tip-head {
    font-weight: 700; margin-bottom: 0.35rem; padding-bottom: 0.3rem;
    border-bottom: 1px solid var(--border-light);
  }
  .tmog-tip .tip-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.12rem; }
  /* ⚠️ Le voci della lista le crea il JS a runtime, quindi NON hanno l'attributo
     [data-astro-cid-…] con cui Astro scopa gli stili: senza :global() queste regole
     non le colpiscono e il tooltip resta grigio. Il compilatore lascia cadere il
     `.tmog-tip` davanti, quindi queste finiscono globali: `.tip-list` esiste solo
     qui, ma se la riusi altrove ricordati che non sono piu' isolate.

     Ogni voce porta la sua barretta di stato a sinistra: rosso = manca, verde = preso.
     Nessuna etichetta di testo, nessun glifo — la riga si legge a colpo d'occhio. */
  .tmog-tip :global(.tip-list li) {
    padding: 0.06rem 0.3rem 0.06rem 0.4rem; border-radius: 3px;
    border-left: 3px solid currentColor;
  }
  .tmog-tip :global(.tip-list .is-preso) { color: var(--ok); background: color-mix(in srgb, var(--ok) 9%, var(--surface)); }
  .tmog-tip :global(.tip-list .is-manca) { color: var(--bad); background: color-mix(in srgb, var(--bad) 9%, var(--surface)); }
  /* "Shoulder - Ragnaros (FL)" -> slot in evidenza (eredita il colore di stato dalla
     voce), boss smorzato accanto. */
  .tmog-tip :global(.tip-list b) { font-weight: 600; }
  .tmog-tip :global(.tip-list .is-preso span) { color: color-mix(in srgb, var(--ok) 55%, var(--text-subtle)); }
  .tmog-tip :global(.tip-list .is-manca span) { color: color-mix(in srgb, var(--bad) 45%, var(--text-subtle)); }

  @media (max-width: 700px) {
    .tmog-panel th:first-child, .tmog-panel td:first-child { width: 40%; }
    /* Le sigle dei raid sono contenuto (eccezione documentata), non decorazione: su
       mobile non si nascondono. `.tname` va gia' a capo (flex-wrap: wrap), quindi le
       si lascia scendere sotto il nome del set invece di sopprimerle. */
    .tmog-panel .traid { flex-basis: 100%; }
  }
</style>

<script>
  // Elenco pezzi per classe, caricato da /transmog/<classe>.json alla prima apertura
  // del tab e tenuto in cache. Modulo eseguito una volta sola, quindi la cache
  // sopravvive alle navigazioni ClientRouter (come la guardia __tmogTip).
  const tipCache = new Map<string, any>();
  const tipPending = new Map<string, Promise<any>>();
  function ensureTips(slug: string): Promise<any> {
    if (!slug) return Promise.resolve(null);
    if (tipCache.has(slug)) return Promise.resolve(tipCache.get(slug));
    if (tipPending.has(slug)) return tipPending.get(slug)!;
    const p = fetch(`/transmog/${slug}.json`)
      .then(r => (r.ok ? r.json() : null))
      .then(d => { if (d) tipCache.set(slug, d); tipPending.delete(slug); return d; })
      .catch(() => { tipPending.delete(slug); return null; });
    tipPending.set(slug, p);
    return p;
  }

  function initTransmog() {
    const chips = Array.from(document.querySelectorAll('#tmog-chips .chip')) as HTMLButtonElement[];
    const panels = Array.from(document.querySelectorAll('.tmog-panel')) as HTMLElement[];
    if (!chips.length || !panels.length) return;

    // Scalda la cache della classe gia' visibile all'apertura della pagina.
    const visibile = panels.find(p => !p.hidden);
    if (visibile?.dataset.class) ensureTips(visibile.dataset.class);

    // Tab a selezione singola: una classe alla volta (a differenza del filtro multi di /macros).
    // `focus` distingue il click (non deve rubare il focus) dalla navigazione a tastiera
    // (deve spostarlo sul nuovo tab). Roving tabindex: solo il tab attivo e' tabbabile.
    function select(chip: HTMLButtonElement, focus = false) {
      const target = chip.dataset.class || '';
      for (const c of chips) {
        const on = c === chip;
        c.classList.toggle('is-active', on);
        c.setAttribute('aria-selected', on ? 'true' : 'false');
        c.tabIndex = on ? 0 : -1;
      }
      for (const p of panels) p.hidden = p.dataset.class !== target;
      if (focus) chip.focus();
      ensureTips(target); // carica i pezzi della classe appena aperta
    }

    // Stato iniziale del roving tabindex: solo il chip attivo (il primo) entra nel Tab order.
    for (const c of chips) c.tabIndex = c.classList.contains('is-active') ? 0 : -1;

    for (const chip of chips) chip.addEventListener('click', () => select(chip));

    // Navigazione a tastiera del tablist (pattern WAI-ARIA APG): frecce spostano
    // selezione+focus tra i tab, Home/End ai due capi. Non cambia cosa fa il click.
    document.getElementById('tmog-chips')?.addEventListener('keydown', e => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(e.key)) return;
      const cur = chips.findIndex(c => c === document.activeElement);
      if (cur < 0) return;
      e.preventDefault();
      let next = cur;
      if (e.key === 'ArrowLeft') next = (cur - 1 + chips.length) % chips.length;
      else if (e.key === 'ArrowRight') next = (cur + 1) % chips.length;
      else if (e.key === 'Home') next = 0;
      else if (e.key === 'End') next = chips.length - 1;
      select(chips[next], true);
    });

    initTip();
  }

  // Popover dei pezzi mancanti sulle celle con `data-ver` (i pezzi arrivano dal JSON
  // della classe, non piu' da un attributo inline).
  //
  // I listener stanno su `document` e vanno agganciati UNA volta sola: con
  // ClientRouter `astro:page-load` rispara a ogni navigazione, e ri-registrarli
  // lascerebbe in giro copie legate al popover della pagina precedente. Per lo
  // stesso motivo il nodo si risolve dentro l'handler, non qui fuori.
  function initTip() {
    if ((window as any).__tmogTip) return;
    (window as any).__tmogTip = true;

    const el = () => document.getElementById('tmog-tip') as HTMLElement | null;

    let openCell: HTMLElement | null = null;

    // Togliendo il popover si toglie anche l'aria-describedby dalla cella, altrimenti
    // lo screen reader punterebbe a un tooltip nascosto/svuotato.
    function hide() {
      if (openCell) openCell.removeAttribute('aria-describedby');
      openCell = null;
      const tip = el(); if (tip) tip.hidden = true;
    }

    // Disegna titolo + elenco pezzi e posiziona. `pieces` puo' essere vuoto: allora
    // resta il solo titolo, com'era per le celle senza elenco. Il primo carattere di
    // ogni voce dice preso (+) o mancante (-); il resto e' gia' formatato da
    // formatMissing ("Shoulder — Ragnaros (FL)", o il solo slot se il boss e' ignoto).
    function render(cell: HTMLElement, pieces: string[]) {
      const tip = el();
      if (!tip) return;
      const head = tip.querySelector('.tip-head') as HTMLElement;
      const list = tip.querySelector('.tip-list') as HTMLElement;
      head.textContent = cell.dataset.tipTitle || '';
      list.replaceChildren();
      for (const grezzo of pieces) {
        const preso = grezzo[0] === '+';
        const raw = grezzo.slice(1);
        const i = raw.indexOf(' — ');
        const li = document.createElement('li');
        li.className = preso ? 'is-preso' : 'is-manca';
        const b = document.createElement('b');
        b.textContent = i < 0 ? raw : raw.slice(0, i);
        li.append(b);
        if (i >= 0) {
          const s = document.createElement('span');
          s.textContent = raw.slice(i);
          li.append(s);
        }
        list.append(li);
      }
      tip.hidden = false;

      // Posizione: sotto la cella, rientrata nel viewport se sborda.
      const r = cell.getBoundingClientRect();
      const t = tip.getBoundingClientRect();
      const pad = 8;
      let left = r.left + r.width / 2 - t.width / 2;
      left = Math.max(pad, Math.min(left, window.innerWidth - t.width - pad));
      let top = r.bottom + 6;
      if (top + t.height > window.innerHeight - pad) top = r.top - t.height - 6;
      tip.style.left = `${left}px`;
      tip.style.top = `${Math.max(pad, top)}px`;
    }

    function show(cell: HTMLElement) {
      if (openCell && openCell !== cell) openCell.removeAttribute('aria-describedby');
      openCell = cell;
      // Lega la cella al popover: lo screen reader annuncia l'elenco pezzi come descrizione.
      cell.setAttribute('aria-describedby', 'tmog-tip');
      const slug = (cell.closest('.tmog-panel') as HTMLElement | null)?.dataset.class || '';
      const tier = cell.dataset.tier || '', ver = cell.dataset.ver || '';
      const data = tipCache.get(slug);
      render(cell, data?.[tier]?.[ver] ?? []);
      // Se i pezzi non sono ancora arrivati, mostra subito il titolo e riempi appena
      // il fetch risolve — ma solo se il mouse e' ancora su questa cella.
      if (!data) {
        ensureTips(slug).then(d => {
          if (openCell === cell) render(cell, d?.[tier]?.[ver] ?? []);
        });
      }
    }

    // Il bersaglio dell'evento e' una cella con tooltip? (null se siamo altrove)
    const cellOf = (e: Event) => {
      const t = e.target;
      return t instanceof Element
        ? (t.closest('[data-ver]') as HTMLElement | null)
        : null;
    };

    // Delega: le celle sono tante e i pannelli cambiano con i chip.
    document.addEventListener('mouseover', e => {
      const cell = cellOf(e);
      if (cell) show(cell); else hide();
    });
    document.addEventListener('focusin', e => {
      const cell = cellOf(e);
      if (cell) show(cell); else hide();
    });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') hide(); });
    window.addEventListener('scroll', hide, true);
  }

  document.addEventListener('astro:page-load', initTransmog);
</script>
