---
import Base from '../layouts/Base.astro';
import { getHwComponents } from '../lib/content';

// SOLO le spec: la pagina dice com'e' fatta la macchina, non come e' configurata ne'
// cosa e' stato aggiornato. Una scheda tecnica, quindi niente stati, niente contatori,
// niente bollini — la sezione non ha nulla da "sistemare".
const components = getHwComponents();
---
<Base title="Hardware" description="Scheda tecnica della postazione di gioco: CPU, scheda video, memoria, monitor.">
  <div class="wrap hw">
    <dl class="spec">
      {components.map(c => (
        <div class="spec-row">
          <dt class="spec-label">{c.label}</dt>
          <dd class="spec-val">
            <span class="spec-name">{c.name}</span>
            {c.detail && <span class="spec-detail">{c.detail}</span>}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</Base>

<style>
/* ── Scheda tecnica ────────────────────────────────
   Una lista di definizioni, non una tabella: le coppie etichetta/valore sono
   esattamente questo, e <dl> dice la stessa cosa al lettore e allo screen reader senza
   dover fingere righe e colonne. */
.hw { padding-top: 0.5rem; }

.spec {
  margin: 0;
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}
.spec-row { display: flex; gap: 1rem; padding: 0.75rem 1rem; border-top: 1px solid var(--border-light); }
.spec-row:first-child { border-top: 0; }
/* La riga si scalda nella tinta della sezione, come le altre griglie del sito. */
.spec-row:hover { background: color-mix(in srgb, var(--section, var(--accent)) 4%, transparent); }

/* Colonna etichetta a larghezza fissa: e' quello che incolonna i valori e fa leggere la
   scheda come una scheda invece che come un elenco puntato. */
.spec-label {
  flex: none; width: 9rem; margin: 0;
  font-size: var(--fs-xs); font-weight: 700;
  text-transform: uppercase; letter-spacing: 0.02em;
  color: var(--text-subtle);
  padding-top: 0.12rem;
}
.spec-val { min-width: 0; margin: 0; display: flex; flex-direction: column; gap: 0.1rem; }
.spec-name { font-size: var(--fs-md); font-weight: 600; color: var(--text); }
/* tabular-nums: le cifre di frequenze e risoluzioni restano incolonnate fra le righe. */
.spec-detail { font-size: var(--fs-xs); color: var(--text-muted); font-variant-numeric: tabular-nums; }

@media (max-width: 620px) {
  .spec-row { flex-direction: column; gap: 0.2rem; }
  .spec-label { width: auto; }
}
</style>
