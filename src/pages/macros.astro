---
import Base from '../layouts/Base.astro';
import { getMacros, classLabel, titleCase } from '../lib/content';

const macros = getMacros();

// icona classe (i file sono senza trattino: death-knight -> deathknight)
const KNOWN = new Set(['warrior','paladin','hunter','rogue','priest','deathknight','shaman','mage','warlock','monk','druid','demonhunter','evoker']);
const nodash = (cls: string) => cls.replace(/-/g, '');
const classIcon = (cls: string | null) => {
  if (!cls) return null;
  const slug = nodash(cls);
  return KNOWN.has(slug) ? `/icons/class/${slug}.jpg` : null;
};
const specIcon = (cls: string | null, spec: string | null) =>
  cls && spec ? `/icons/spec/${nodash(cls)}-${spec}.jpg` : null;

// Tutte le classi WoW: il filtro le mostra SEMPRE, anche quelle senza macro (count 0).
const ALL_CLASSES = ['warrior','paladin','hunter','rogue','priest','death-knight','shaman','mage','warlock','monk','druid','demon-hunter','evoker'];

// Classi con conteggio e spec 'proprie', in ordine alfabetico di etichetta (Shared in fondo).
interface ClassInfo { slug: string; label: string; icon: string | null; count: number; specs: string[]; }
const classes: ClassInfo[] = ALL_CLASSES.map(slug => ({
  slug, label: classLabel(slug), icon: classIcon(slug), count: 0, specs: [],
}));
for (const m of macros) {
  const slug = m.class ?? 'shared';
  let info = classes.find(c => c.slug === slug);
  if (!info) {
    info = { slug, label: m.class ? classLabel(m.class) : 'Shared', icon: classIcon(m.class), count: 0, specs: [] };
    classes.push(info);
  }
  info.count++;
  if (m.spec && !info.specs.includes(m.spec)) info.specs.push(m.spec);
}
classes.sort((a, b) => (a.slug === 'shared' ? 1 : b.slug === 'shared' ? -1 : a.label.localeCompare(b.label)));
for (const c of classes) c.specs.sort();

// Mappa classe→spec (solo classi con spec proprie) per la riga di chip spec lato client.
const specMap: Record<string, string[]> = Object.fromEntries(
  classes.filter(c => c.specs.length).map(c => [c.slug, c.specs]),
);
---
<Base title="Macro" description="Macro WoW per account/character, filtrabili per classe e spec: cosa fanno e il codice pronto da copiare.">
  <div class="wrap">
    <div class="filters row">
      <input id="macro-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca macro, abilità, spec…" aria-label="Cerca macro" />
      <div class="chips" id="class-chips" role="group" aria-label="Filtra per classe">
        {classes.map(c => (
          <button class:list={['chip', { 'is-empty': c.count === 0 }]} data-class={c.slug} type="button" aria-pressed="false">
            <img class="chip-ico" src={c.icon ?? '/icons/ui/shared.jpg'} alt="" width="18" height="18" />
            {c.label}<span class="c">{c.count}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- Riga chip spec: popolata dal JS solo quando è attiva UNA sola classe con spec proprie. -->
    <div class="chips spec-chips" id="spec-chips" role="group" aria-label="Filtra per spec" hidden></div>
    {/* `<` escapato a \u003c: JSON.stringify non lo tocca, e uno spec con "</script>"
        chiuderebbe il tag in anticipo. JSON.parse lato client lo ridecodifica identico. */}
    <script type="application/json" id="spec-map" set:html={JSON.stringify(specMap).replace(/</g, '\\u003c')}></script>

    <div class="macro-grid" id="macro-grid">
      {macros.map(m => {
        const cIcon = classIcon(m.class);
        const sIcon = specIcon(m.class, m.spec);
        return (
          <article class="mcard" data-class={m.class ?? 'shared'} data-spec={m.spec ?? ''}
                   data-search={`${m.name} ${m.desc ?? ''} ${m.spec ?? ''} ${m.class ?? ''} ${m.body ?? ''}`.toLowerCase()}>
            <div class="mcard-head">
              <div class="mcard-icons">
                {cIcon
                  ? <img class="ico ico-sm" src={cIcon} alt={m.class ? classLabel(m.class) : ''} title={m.class ? classLabel(m.class) : ''} width="24" height="24" />
                  : <img class="ico ico-sm" src="/icons/ui/shared.jpg" alt="Cross-classe" title="Cross-classe" width="24" height="24" />}
                {sIcon && <img class="ico ico-spec ico-spec--card" src={sIcon} alt={titleCase(m.spec ?? '')} title={titleCase(m.spec ?? '')} width="18" height="18" />}
              </div>
              <div class="mcard-title">
                <strong>{m.name}</strong>
              </div>
            </div>
            {m.desc && <p class="mcard-desc">{m.desc}</p>}
            {m.body && (
              <div class="mcard-code">
                <button class="copy" type="button" aria-label="Copia la macro" aria-live="polite">Copia</button>
                <pre><code>{m.body}</code></pre>
              </div>
            )}
          </article>
        );
      })}
    </div>
    <p class="empty" id="empty" role="status" hidden>Nessuna macro per questo filtro.</p>
  </div>
</Base>

<style>
/* Lo scioglimento del contenitore chip (display:contents) ora e' globale in global.css,
   uguale per tutte le pagine: qui non serve piu' l'override. */

/* Riga spec: chip sotto la riga classe, stesso stile ma flusso proprio (non `display:contents`). */
.spec-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.5rem; }

/* `display:flex/grid` sulle card/chips vince sull'attributo [hidden] (regola autore > UA): forziamo il nascondere. */
.mcard[hidden], .chips[hidden] { display: none !important; }

/* Masonry via multi-column con column-width: il numero di colonne si adatta da sé alla
   larghezza (come l'auto-fill delle griglie a card), senza breakpoint scelti a mano.
   Le card si impilano in verticale riempiendo i vuoti; una riga lunga di macro non allarga
   la colonna, è il <pre> a scrollare. Sotto ~340px di contenitore: una colonna sola. */
.macro-grid { column-width: 340px; column-gap: var(--grid-gap); padding-top: 0.6rem; }
.mcard { display: flex; flex-direction: column; gap: 0.55rem; min-width: 0; break-inside: avoid; -webkit-column-break-inside: avoid; margin-bottom: var(--grid-gap); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: var(--card-pad); }
.mcard-head { display: flex; align-items: center; gap: 0.6rem; }
.mcard-icons { display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0; }
.ico-spec--card { width: 18px; height: 18px; min-width: 18px; border-radius: 4px; }
.mcard-title { min-width: 0; }
.mcard-title strong { font-size: var(--fs-lg); line-height: 1.25; }
.mcard-desc { font-size: var(--fs-md); color: var(--text-muted); line-height: 1.45; margin: 0; }
.mcard-code { position: relative; }
/* padding-right ampio: il bottone .copy (overlay in alto a destra) non copre la prima riga del corpo. */
.mcard-code pre { background: var(--surface-2); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 0.6rem 3.2rem 0.6rem 0.7rem; overflow: hidden; }
/* Wrap invece di scroll: rientro pendente = ogni riga a capo (continuazione) resta indentata,
   marcatore visivo che quella riga prosegue la precedente. */
.mcard-code code { display: block; font-family: var(--font-mono); font-size: 0.74rem; line-height: 1.5; background: none; padding: 0; color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; padding-left: 1.5em; text-indent: -1.5em; }
/* Aspetto base in global.css (`.copy`): qui solo posizione, misura e la comparsa
   in hover. */
.copy { position: absolute; top: 0.35rem; right: 0.35rem; font-size: 0.68rem; padding: 0.12rem 0.42rem; opacity: 0; }
.mcard-code:hover .copy, .copy:focus-visible { opacity: 1; }
.copy.done { opacity: 1; }
/* Su touch non esiste hover: se resta a opacity 0 il bottone non e' scopribile. */
@media (hover: none) {
  .copy { opacity: 1; }
}

</style>

<script>
  import { loadFilters, saveFilters } from '../lib/filter-state';
  import { copyText } from '../lib/clipboard';

  function initMacros() {
    const grid = document.getElementById('macro-grid');
    if (!grid) return;
    const classChips = Array.from(document.querySelectorAll('#class-chips .chip')) as HTMLButtonElement[];
    const cards = Array.from(grid.querySelectorAll('.mcard')) as HTMLElement[];
    const empty = document.getElementById('empty') as HTMLElement;
    const specChipsBox = document.getElementById('spec-chips') as HTMLElement;

    // Mappa classe→spec (dal JSON renderizzato lato server): alimenta la riga di chip spec.
    let specMap: Record<string, string[]> = {};
    try {
      specMap = JSON.parse(document.getElementById('spec-map')?.textContent || '{}');
    } catch { /* mappa assente/malformata: nessuna riga spec */ }

    // Filtro classe a selezione ESCLUSIVA (una sola classe alla volta). Tenuto come Set
    // per non toccare `apply`/`renderSpecRow`, ma contiene al piu' un elemento: vuoto =
    // nessun filtro (tutte le classi).
    const activeClasses = new Set<string>();
    // Filtro spec: singola selezione, valido solo con UNA classe attiva. '' = nessun filtro.
    let activeSpec = '';
    const search = document.getElementById('macro-search') as HTMLInputElement;
    let query = '';
    // Salva ricerca + classe + spec correnti (localStorage): al piu' una classe, quindi
    // il Set collassa a stringa; spec vale solo con una classe attiva.
    const persist = () => saveFilters('macros', {
      q: search?.value || '', cls: [...activeClasses][0] || '', spec: activeSpec,
    });

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const okClass = activeClasses.size === 0 || activeClasses.has(card.dataset.class || '');
        // Le card cross-spec (data-spec vuoto) restano sempre visibili in ogni filtro spec.
        const cardSpec = card.dataset.spec || '';
        const okSpec = activeSpec === '' || cardSpec === '' || cardSpec === activeSpec;
        const okText = query === '' || (card.dataset.search || '').includes(query);
        const show = okClass && okSpec && okText;
        card.hidden = !show;
        if (show) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    // Etichetta leggibile per una spec (prima lettera maiuscola), come il titleCase server-side.
    const specLabel = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

    // Ricostruisce la riga spec: compare SOLO con una singola classe attiva che ha spec proprie.
    // Ogni ricostruzione azzera il filtro spec (cambio classe = reset).
    const renderSpecRow = () => {
      activeSpec = '';
      if (!specChipsBox) return;
      specChipsBox.replaceChildren();
      const only = activeClasses.size === 1 ? [...activeClasses][0] : '';
      const specs = only ? (specMap[only] || []) : [];
      if (!specs.length) { specChipsBox.hidden = true; return; }
      const nodash = only.replace(/-/g, '');
      for (const spec of specs) {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'chip';
        btn.dataset.spec = spec;
        btn.setAttribute('aria-pressed', 'false');
        const img = document.createElement('img');
        img.className = 'chip-ico';
        img.src = `/icons/spec/${nodash}-${spec}.jpg`;
        img.alt = '';
        img.width = 18; img.height = 18;
        btn.append(img, document.createTextNode(specLabel(spec)));
        btn.addEventListener('click', () => {
          const s = btn.dataset.spec || '';
          activeSpec = activeSpec === s ? '' : s;   // toggle: ri-click deseleziona
          for (const c of Array.from(specChipsBox.querySelectorAll('.chip')) as HTMLButtonElement[]) {
            const on = c === btn && activeSpec !== '';
            c.classList.toggle('is-active', on);
            c.setAttribute('aria-pressed', on ? 'true' : 'false');
          }
          apply();
          persist();
        });
        specChipsBox.append(btn);
      }
      specChipsBox.hidden = false;
    };

    if (search) {
      search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); apply(); persist(); });
    }

    for (const chip of classChips) {
      chip.addEventListener('click', () => {
        const c = chip.dataset.class || '';
        // Esclusivo: click su una classe -> resta solo quella; ri-click sull'attiva -> nessuna.
        if (activeClasses.has(c)) activeClasses.clear();
        else { activeClasses.clear(); activeClasses.add(c); }
        // Selezione singola: aggiorno TUTTE le chip, non solo quella cliccata (l'altra
        // eventualmente attiva va spenta). `aria-pressed` in sync con `is-active`: e'
        // l'unico stato leggibile da uno screen reader.
        for (const other of classChips) {
          const on = activeClasses.has(other.dataset.class || '');
          other.classList.toggle('is-active', on);
          other.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        // La riga spec vive solo con UNA classe attiva: si aggiorna/sparisce a ogni scelta.
        renderSpecRow();
        apply();
        persist();
      });
    }

    // Ripristina l'ultimo stato (localStorage): ricerca, classe e, se ancora presente
    // fra le chip rigenerate, la spec. Valori spariti (classe/spec rimossa) -> si ignora.
    const saved = loadFilters('macros', { q: '', cls: '', spec: '' });
    if (saved.q) { query = saved.q.trim().toLowerCase(); if (search) search.value = saved.q; }
    if (saved.cls) {
      const chip = classChips.find(c => (c.dataset.class || '') === saved.cls);
      if (chip) {
        activeClasses.clear();
        activeClasses.add(saved.cls);
        for (const other of classChips) {
          const on = activeClasses.has(other.dataset.class || '');
          other.classList.toggle('is-active', on);
          other.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        renderSpecRow();              // ricostruisce le chip spec e azzera activeSpec
        if (saved.spec) {
          const specBtn = (Array.from(specChipsBox.querySelectorAll('.chip')) as HTMLButtonElement[])
            .find(b => (b.dataset.spec || '') === saved.spec);
          if (specBtn) {
            activeSpec = saved.spec;
            specBtn.classList.add('is-active');
            specBtn.setAttribute('aria-pressed', 'true');
          }
        }
      }
    }
    apply();

    // L'etichetta di riposo e' una costante, non il testo letto dal bottone: leggendolo
    // due click ravvicinati catturavano 'Copiato' come "precedente" e il bottone ci
    // restava per sempre. Stessa scelta gia' fatta in /extra.
    const COPY_LABEL = 'Copia';
    for (const btn of Array.from(document.querySelectorAll('.copy')) as HTMLButtonElement[]) {
      btn.addEventListener('click', async () => {
        const code = btn.parentElement?.querySelector('code')?.textContent ?? '';
        const ok = await copyText(code);
        btn.textContent = ok ? 'Copiato' : 'Errore';
        btn.classList.toggle('done', ok);
        setTimeout(() => { btn.textContent = COPY_LABEL; btn.classList.remove('done'); }, 1400);
      });
    }
  }

  document.addEventListener('astro:page-load', initMacros);
</script>
