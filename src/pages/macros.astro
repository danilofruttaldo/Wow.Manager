---
import Base from '../layouts/Base.astro';
import { getMacros, classLabel, titleCase } from '../lib/content';

const macros = getMacros();

// icona classe (i file sono senza trattino: death-knight -> deathknight)
const KNOWN = new Set(['warrior','paladin','hunter','rogue','priest','deathknight','shaman','mage','warlock','monk','druid','demonhunter','evoker']);
const nodash = (cls: string) => cls.replace(/-/g, '');
const classIcon = (cls: string | null) => {
  if (!cls) return null;
  const slug = nodash(cls);
  return KNOWN.has(slug) ? `/icons/class/${slug}.jpg` : null;
};
const specIcon = (cls: string | null, spec: string | null) =>
  cls && spec ? `/icons/spec/${nodash(cls)}-${spec}.jpg` : null;

// Classi presenti (con conteggio e spec 'proprie'), in ordine alfabetico di etichetta.
interface ClassInfo { slug: string; label: string; icon: string | null; count: number; specs: string[]; }
const classes: ClassInfo[] = [];
for (const m of macros) {
  const slug = m.class ?? 'shared';
  let info = classes.find(c => c.slug === slug);
  if (!info) {
    info = { slug, label: m.class ? classLabel(m.class) : 'Shared', icon: classIcon(m.class), count: 0, specs: [] };
    classes.push(info);
  }
  info.count++;
  if (m.spec && !info.specs.includes(m.spec)) info.specs.push(m.spec);
}
classes.sort((a, b) => (a.slug === 'shared' ? 1 : b.slug === 'shared' ? -1 : a.label.localeCompare(b.label)));
for (const c of classes) c.specs.sort();
---
<Base title="Macro" description="Macro WoW per account/character, filtrabili per classe e spec: cosa fanno e il codice pronto da copiare.">
  <div class="wrap">
    <div class="filters">
      <input id="macro-search" class="search" type="search" inputmode="search" autocomplete="off"
             placeholder="Cerca macro, abilità, spec…" aria-label="Cerca macro" />
      <div class="chips" id="class-chips" role="group" aria-label="Filtra per classe">
        {classes.map(c => (
          <button class="chip" data-class={c.slug} type="button">
            {c.icon
              ? <img class="ico ico-sm" src={c.icon} alt="" width="18" height="18" />
              : <span class="chip-dot" aria-hidden="true"></span>}
            {c.label}<span class="c">{c.count}</span>
          </button>
        ))}
      </div>
      <div class="chips chips--spec" id="spec-chips" hidden>
        {classes.filter(c => c.specs.length).flatMap(c =>
          c.specs.map(spec => (
            <button class="chip chip--sm spec-opt" data-parent={c.slug} data-spec={spec} type="button" hidden>
              {specIcon(c.slug, spec) && <img class="ico ico-spec" src={specIcon(c.slug, spec)} alt="" width="16" height="16" />}
              {titleCase(spec)}
            </button>
          )),
        )}
      </div>
    </div>

    <div class="macro-grid" id="macro-grid">
      {macros.map(m => {
        const cIcon = classIcon(m.class);
        const sIcon = specIcon(m.class, m.spec);
        return (
          <article class="mcard" data-class={m.class ?? 'shared'} data-spec={m.spec ?? ''}
                   data-search={`${m.name} ${m.desc ?? ''} ${m.spec ?? ''} ${m.class ?? ''} ${m.body ?? ''}`.toLowerCase()}>
            <div class="mcard-head">
              <div class="mcard-icons">
                {cIcon
                  ? <img class="ico ico-sm" src={cIcon} alt={m.class ? classLabel(m.class) : ''} title={m.class ? classLabel(m.class) : ''} width="24" height="24" />
                  : <span class="chip-dot chip-dot--lg" title="Cross-classe" aria-hidden="true"></span>}
                {sIcon && <img class="ico ico-spec ico-spec--card" src={sIcon} alt={titleCase(m.spec ?? '')} title={titleCase(m.spec ?? '')} width="18" height="18" />}
              </div>
              <div class="mcard-title">
                <strong>{m.name}</strong>
              </div>
            </div>
            {m.desc && <p class="mcard-desc">{m.desc}</p>}
            {m.body && (
              <div class="mcard-code">
                <button class="copy" type="button" aria-label="Copia la macro">Copia</button>
                <pre><code>{m.body}</code></pre>
              </div>
            )}
          </article>
        );
      })}
    </div>
    <p class="empty" id="empty" hidden>Nessuna macro per questo filtro.</p>
  </div>
</Base>

<style>
.filters { position: sticky; top: var(--header-height); z-index: 10; background: color-mix(in srgb, var(--bg) 92%, transparent); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); padding: 0.7rem 0 0.6rem; margin-bottom: 0.4rem; border-bottom: 1px solid var(--border); }
.search { display: block; width: 100%; max-width: 420px; margin-bottom: 0.6rem; font-family: inherit; font-size: 0.88rem; color: var(--text); background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 0.4rem 0.9rem; transition: border-color var(--transition), box-shadow var(--transition); }
.search::placeholder { color: var(--text-subtle); }
.search:focus-visible { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-soft); }
.chips { display: flex; flex-wrap: wrap; gap: 0.4rem; }
.chips--spec { margin-top: 0.5rem; padding-top: 0.5rem; border-top: 1px dashed var(--border); }
.chip { display: inline-flex; align-items: center; gap: 0.4rem; font-family: inherit; font-size: 0.82rem; font-weight: 500; color: var(--text-muted); background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 0.28rem 0.7rem; cursor: pointer; transition: color var(--transition), background var(--transition), border-color var(--transition); }
.chip:hover { border-color: var(--accent); color: var(--text); }
.chip.is-active { background: var(--accent); border-color: var(--accent); color: #fff; }
.chip.is-active .c { color: #fff; opacity: 0.85; }
.chip .c { font-size: 0.72rem; font-variant-numeric: tabular-nums; color: var(--text-subtle); }
.chip--sm { font-size: 0.78rem; padding: 0.2rem 0.6rem; }
.chip .ico-sm { width: 18px; height: 18px; min-width: 18px; }
.chip-dot { width: 14px; height: 14px; border-radius: 50%; background: linear-gradient(135deg, var(--text-subtle), var(--border)); }
.chip-dot--lg { width: 24px; height: 24px; border: 1px solid var(--border); }

/* `display:flex/grid` sulle card/chip vince sull'attributo [hidden] (regola autore > UA): forziamo il nascondere. */
.mcard[hidden], .chip[hidden], .chips[hidden] { display: none !important; }

/* 3 colonne fisse (2 su schermi medi, 1 su mobile). minmax(0,1fr) evita che una riga
   lunga di macro allarghi la colonna oltre la pagina: è il <pre> a scrollare. */
/* Masonry via multi-column: le card si impilano in verticale riempiendo i vuoti (niente
   allineamento per righe, così non restano spazi morti sotto le card più corte). */
.macro-grid { column-count: 3; column-gap: 0.7rem; padding-top: 0.6rem; }
@media (max-width: 1000px) { .macro-grid { column-count: 2; } }
.mcard { display: flex; flex-direction: column; gap: 0.55rem; min-width: 0; break-inside: avoid; -webkit-column-break-inside: avoid; margin-bottom: 0.7rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 0.8rem 0.9rem; }
.mcard-head { display: flex; align-items: center; gap: 0.6rem; }
.mcard-icons { display: flex; align-items: center; gap: 0.25rem; flex-shrink: 0; }
.ico-spec--card { width: 18px; height: 18px; min-width: 18px; border-radius: 4px; }
.mcard-title { min-width: 0; }
.mcard-title strong { font-size: 0.95rem; line-height: 1.25; }
.mcard-desc { font-size: 0.83rem; color: var(--text-muted); line-height: 1.45; margin: 0; }
.mcard-code { position: relative; }
.mcard-code pre { background: var(--surface-2); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 0.6rem 0.7rem; overflow: hidden; }
/* Wrap invece di scroll: rientro pendente = ogni riga a capo (continuazione) resta indentata,
   marcatore visivo che quella riga prosegue la precedente. */
.mcard-code code { display: block; font-family: var(--font-mono); font-size: 0.74rem; line-height: 1.5; background: none; padding: 0; color: var(--text); white-space: pre-wrap; overflow-wrap: anywhere; padding-left: 1.5em; text-indent: -1.5em; }
.copy { position: absolute; top: 0.35rem; right: 0.35rem; font-family: inherit; font-size: 0.68rem; font-weight: 600; color: var(--text-subtle); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 0.12rem 0.42rem; cursor: pointer; opacity: 0; transition: opacity var(--transition), color var(--transition), border-color var(--transition); }
.mcard-code:hover .copy, .copy:focus-visible { opacity: 1; }
.copy:hover { color: var(--accent); border-color: var(--accent); }
.copy.done { opacity: 1; color: var(--c-monk); border-color: var(--c-monk); }
.empty { color: var(--text-subtle); font-size: 0.9rem; padding: 2rem 0; text-align: center; }

@media (max-width: 600px) {
  .macro-grid { column-count: 1; }
  .filters { top: 0; }
}
</style>

<script>
  function initMacros() {
    const grid = document.getElementById('macro-grid');
    if (!grid) return;
    const classChips = Array.from(document.querySelectorAll('#class-chips .chip')) as HTMLButtonElement[];
    const specBar = document.getElementById('spec-chips') as HTMLElement;
    const specOpts = Array.from(document.querySelectorAll('.spec-opt')) as HTMLButtonElement[];
    const cards = Array.from(grid.querySelectorAll('.mcard')) as HTMLElement[];
    const empty = document.getElementById('empty') as HTMLElement;

    // Multi-selezione su entrambi i filtri (unione). Set vuoto = nessun filtro su quell'asse.
    const activeClasses = new Set<string>();
    const activeSpecs = new Set<string>();
    const search = document.getElementById('macro-search') as HTMLInputElement;
    let query = '';

    const apply = () => {
      let shown = 0;
      for (const card of cards) {
        const okClass = activeClasses.size === 0 || activeClasses.has(card.dataset.class || '');
        // nessuna spec scelta, spec fra quelle scelte, o card cross-spec (data-spec vuoto = sempre visibile)
        const okSpec = activeSpecs.size === 0 || activeSpecs.has(card.dataset.spec || '') || card.dataset.spec === '';
        const okText = query === '' || (card.dataset.search || '').includes(query);
        const show = okClass && okSpec && okText;
        card.hidden = !show;
        if (show) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    if (search) {
      search.addEventListener('input', () => { query = search.value.trim().toLowerCase(); apply(); });
    }

    // La barra spec mostra le spec delle classi selezionate (dedupe per nome). Appare con >=1 classe attiva.
    const updateSpecBar = () => {
      // togli dalla selezione le spec non più offerte dalle classi attive
      const available = new Set(specOpts.filter(o => activeClasses.has(o.dataset.parent || '')).map(o => o.dataset.spec || ''));
      for (const s of [...activeSpecs]) if (!available.has(s)) activeSpecs.delete(s);
      const seen = new Set<string>();
      let any = false;
      for (const o of specOpts) {
        const spec = o.dataset.spec || '';
        const showChip = activeClasses.has(o.dataset.parent || '') && !seen.has(spec);
        if (showChip) { seen.add(spec); any = true; }
        o.hidden = !showChip;
        o.classList.toggle('is-active', showChip && activeSpecs.has(spec));
      }
      specBar.hidden = !any;
    };

    for (const chip of classChips) {
      chip.addEventListener('click', () => {
        const c = chip.dataset.class || '';
        if (activeClasses.has(c)) activeClasses.delete(c);   // toggle: ri-click deseleziona
        else activeClasses.add(c);
        chip.classList.toggle('is-active', activeClasses.has(c));
        updateSpecBar();
        apply();
      });
    }

    for (const chip of specOpts) {
      chip.addEventListener('click', () => {
        const s = chip.dataset.spec || '';
        if (activeSpecs.has(s)) activeSpecs.delete(s);       // toggle multi: ri-click deseleziona
        else activeSpecs.add(s);
        // allinea tutte le chip con lo stesso nome spec (possono essercene più d'una nascosta)
        for (const x of specOpts) if ((x.dataset.spec || '') === s) x.classList.toggle('is-active', activeSpecs.has(s));
        apply();
      });
    }

    for (const btn of Array.from(document.querySelectorAll('.copy')) as HTMLButtonElement[]) {
      btn.addEventListener('click', async () => {
        const code = btn.parentElement?.querySelector('code')?.textContent ?? '';
        try {
          await navigator.clipboard.writeText(code);
          const prev = btn.textContent;
          btn.textContent = 'Copiato';
          btn.classList.add('done');
          setTimeout(() => { btn.textContent = prev; btn.classList.remove('done'); }, 1400);
        } catch { /* clipboard non disponibile */ }
      });
    }
  }

  document.addEventListener('astro:page-load', initMacros);
</script>
