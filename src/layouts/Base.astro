---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;

const SITE_NAME = 'wow.danilofruttaldo.com';
const metaDescription = description || 'Setup WoW Retail di Stantu — addon, macro, build, roster. Stato versionato, cartella di gioco ricostruibile.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const nav = [
  { href: '/addons', label: 'Addon' },
  { href: '/macros', label: 'Macro' },
  { href: '/roster', label: 'Roster' },
  { href: '/ui', label: 'UI' },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={metaDescription} />
  <meta name="theme-color" content="#F4F5F7" />
  <meta name="color-scheme" content="light" />
  <ClientRouter />

  <meta property="og:title" content={`${title} — ${SITE_NAME}`} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:site_name" content={SITE_NAME} />

  <title>{title} &middot; {SITE_NAME}</title>
  <link rel="canonical" href={canonicalUrl.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" /></noscript>
</head>
<body>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand">wow<span>.danilofruttaldo</span></a>
      <nav aria-label="Navigazione">
        {nav.map(item => (
          <a href={item.href} data-astro-prefetch class:list={['nav-link', { active: isActive(item.href) }]}>{item.label}</a>
        ))}
      </nav>
    </div>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <span>{SITE_NAME} &mdash; setup WoW Retail, stato versionato</span>
      <span class="spacer"></span>
      <a href="https://github.com/danilofruttaldo/Wow.Manager" target="_blank" rel="noopener noreferrer">GitHub</a>
      <span class="dot">·</span>
      <span>WoW &copy; Blizzard. Sito non ufficiale.</span>
    </div>
  </footer>
</body>
</html>

<style>
.site-header {
  position: sticky; top: 0; z-index: 50;
  height: var(--header-height);
  background: color-mix(in srgb, var(--surface) 88%, transparent);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}
.header-inner { height: 100%; display: flex; align-items: center; gap: 1.5rem; }
.brand { font-weight: 700; font-size: 0.95rem; letter-spacing: -0.02em; white-space: nowrap; flex-shrink: 0; }
.brand span { color: var(--text-subtle); font-weight: 500; }
.site-header nav { display: flex; align-items: center; gap: 0.15rem; margin-left: auto; overflow-x: auto; }
.nav-link { font-size: 0.85rem; font-weight: 500; color: var(--text-muted); padding: 0.35rem 0.6rem; border-radius: var(--radius-sm); white-space: nowrap; transition: color var(--transition), background var(--transition); }
.nav-link:hover { color: var(--text); background: var(--border-light); }
.nav-link.active { color: var(--accent); background: var(--accent-soft); }

.site-footer { border-top: 1px solid var(--border); background: var(--surface); }
.footer-inner { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; padding-top: 0.9rem; padding-bottom: 0.9rem; font-size: 0.78rem; color: var(--text-subtle); }
.footer-inner .spacer { margin-left: auto; }
.footer-inner a { color: var(--accent); }
.footer-inner .dot { opacity: 0.5; }

@media (max-width: 600px) {
  .header-inner { gap: 0.75rem; }
  .brand span { display: none; }
}
</style>
