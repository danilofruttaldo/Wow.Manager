---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import { wowBuild, sourceDate, getAddons, getMacros, getProfessions, getPgCount, getExtra, getScreenshotCount, getTransmog } from '../lib/content';

interface Props {
  title: string;
  description?: string;
  /* Il layout inietta un <h1 class="sr-only"> col titolo, cosi' ogni pagina ha
     un'intestazione di primo livello (a11y + SEO) senza mostrare un titolo visibile: le
     pagine partono col contenuto, scelta voluta. Chi ha gia' un h1 proprio (404) passa
     bareHeading per non averne due. */
  bareHeading?: boolean;
}
const { title, description, bareHeading } = Astro.props;
const currentPath = Astro.url.pathname;

// Data di aggiornamento della pagina = ultimo commit git del suo file sorgente.
const SOURCE_BY_PATH: Record<string, string> = {
  '/': '.',
  '/addons': 'addons/manifest.json',
  '/macros': 'macros/manifest.json',
  '/professioni': 'professions',
  '/pg': 'pg.md',
  '/transmog': 'transmog/manifest.json',
  '/ui': 'public/screenshots',
  '/extra': 'scripts',
};
// Il build statico emette /professioni/ con lo slash finale, le chiavi qui sopra no:
// senza normalizzare, il lookup manca sempre e ogni pagina mostra la data del repo.
const pathKey = currentPath.replace(/\/+$/, '') || '/';
const updated = sourceDate(SOURCE_BY_PATH[pathKey] ?? '.');

const SITE_NAME = 'wow.danilofruttaldo.com'; // dominio (footer, canonical)
const SITE_TITLE = 'WoW Manager';            // nome nel titolo del tab
const fullTitle = title === SITE_TITLE ? SITE_TITLE : `${title} · ${SITE_TITLE}`;
const metaDescription = description || 'Setup WoW Retail di Stantu — addon, macro, professioni, PG.';
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Anteprima social: URL ASSOLUTO (i crawler non risolvono i path relativi). Asset in
// public/og-image.png, 1200×630 (rigenerabile con scripts/make-og-image.ps1).
const ogImage = new URL('/og-image.png', Astro.site).href;

// La toolbar ha ASSORBITO i pulsanti che stavano sulla home: icona + conteggio per
// sezione, cosi' non c'e' piu' un doppione (nav in header + barra di card che linkavano
// le stesse pagine). I conteggi sono le stesse fonti delle pagine, quindi si allineano
// da se'; il transmog e' la % di completamento complessiva.
const tmog = getTransmog();
const tmogTotal = tmog.reduce((n, c) => n + c.total, 0);
const tmogPct = tmogTotal ? Math.round((tmog.reduce((n, c) => n + c.got, 0) / tmogTotal) * 100) : 0;
// `label` = sigla mostrata nella toolbar (spazio stretto, si appoggia a icona + conteggio
// per il senso); `full` = nome esteso nel title per accessibilita' e hover.
// `color` = tinta identitaria della sezione (la stessa delle vecchie card della home):
// i pulsanti la prendono su hover/active, restando neutri a riposo.
const nav = [
  { href: '/addons', label: 'Addon', full: 'Addon', icon: '/icons/section/addon.jpg', count: `${getAddons().length}`, color: '#2E68D8' },
  { href: '/macros', label: 'Macro', full: 'Macro', icon: '/icons/section/macro.jpg', count: `${getMacros().length}`, color: '#7A5AF8' },
  { href: '/professioni', label: 'Prof', full: 'Professioni', icon: '/icons/section/prof.jpg', count: `${getProfessions().length}`, color: '#C77D0A' },
  { href: '/pg', label: 'PG', full: 'PG', icon: '/icons/section/pg.jpg', count: `${getPgCount()}`, color: '#C0202A' },
  { href: '/transmog', label: 'Xmog', full: 'Transmog', icon: '/icons/section/transmog.jpg', count: `${tmogPct}%`, color: '#9B4DCA' },
  { href: '/ui', label: 'UI', full: 'UI', icon: '/icons/section/ui.jpg', count: `${getScreenshotCount()}`, color: '#159A8C' },
  { href: '/extra', label: 'Extra', full: 'Extra', icon: '/icons/section/extra.jpg', count: `${getExtra().length}`, color: '#5B6470' },
];
const isActive = (href: string) => currentPath === href || currentPath.startsWith(href + '/');
// Tinta della sezione attiva = colore del pulsante nav corrispondente. Il layout la espone
// come --section sul <main>; le pagine la usano per il filetto della barra filtri e per
// hover/focus, cosi' l'identita' cromatica della nav "entra" nella pagina. Home/404 non
// combaciano con nessuna voce nav -> nessuna sezione, resa neutra.
const sectionColor = nav.find(item => isActive(item.href))?.color;
---
<!doctype html>
<html lang="it">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={metaDescription} />
  <meta name="theme-color" content="#F3F4F7" />
  <meta name="color-scheme" content="light" />
  <ClientRouter />

  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalUrl.href} />
  <meta property="og:site_name" content={SITE_TITLE} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={ogImage} />

  <title>{fullTitle}</title>
  <link rel="canonical" href={canonicalUrl.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Font self-hostati: nessuna richiesta a Google, quindi nessun IP di visitatore
       a terzi. Non piu' caricati in modo asincrono (il trucco media="print") perche'
       stessa origine: preload del solo subset latin, gli altri li prende il browser
       se servono. Rigenerabile con scripts/fetch-fonts.ps1. -->
  <link rel="preload" href="/fonts/Inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
</head>
<body>
  <a href="#main" class="skip-link">Vai al contenuto</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand">wow<span>.danilofruttaldo</span></a>
      <nav aria-label="Navigazione">
        {nav.map(item => (
          <a href={item.href} data-astro-prefetch title={item.full} style={`--hc: ${item.color}`} aria-current={isActive(item.href) ? 'page' : undefined} class:list={['nav-link', { active: isActive(item.href) }]}>
            <img class="nav-ico" src={item.icon} alt="" width="18" height="18" />
            <span class="nav-txt">{item.label}</span>
            <span class="nav-count">{item.count}</span>
          </a>
        ))}
      </nav>
    </div>
  </header>

  <main id="main" style={sectionColor ? `--section: ${sectionColor}` : undefined}>
    {!bareHeading && <h1 class="sr-only">{title}</h1>}
    <slot />
  </main>

  <footer class="site-footer">
    <div class="wrap footer-inner">
      <span>{SITE_NAME}</span>
      <span class="build-badge">
        {wowBuild && <>build <code>{wowBuild}</code></>}
        {updated && <> · sync <code>{updated}</code></>}
      </span>
      <a href="https://github.com/danilofruttaldo/Wow.Manager" target="_blank" rel="noopener noreferrer">GitHub</a>
    </div>
    <div class="wrap footer-legal">
      <p>
        World of Warcraft&reg; e Blizzard Entertainment&reg; sono marchi o marchi registrati di
        Blizzard Entertainment, Inc. negli Stati Uniti e/o in altri Paesi. Nomi, immagini e icone
        di gioco sono &copy; Blizzard Entertainment, Inc. e sono usati qui a scopo informativo e
        amatoriale. Sito fan non ufficiale, non affiliato né approvato da Blizzard Entertainment.
        Icone di gioco tramite Wowhead; avatar addon tramite CurseForge.
      </p>
    </div>
  </footer>
</body>
</html>

<style>
.site-header {
  position: sticky; top: 0; z-index: 50;
  height: var(--header-height);
  background: color-mix(in srgb, var(--surface) 88%, transparent);
  -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  border-bottom: 1px solid var(--border);
}
/* Senza il badge in mezzo, brand a sinistra e nav a destra: space-between li tiene ai
   due estremi (la nav prende comunque solo lo spazio che le serve, con overflow-x). */
.header-inner { position: relative; height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
/* Il badge vive nel FOOTER, in flusso fra dominio e GitHub: flex: 1 gli fa prendere lo
   spazio residuo e text-align: center lo centra dentro (stesso trucco che aveva in header). */
.build-badge { flex: 1; text-align: center; font-size: 0.74rem; color: var(--text-subtle); white-space: nowrap; pointer-events: none; }
.build-badge code { font-size: var(--fs-xs); background: var(--border-light); padding: 0.05rem 0.4rem; border-radius: 999px; color: var(--text-muted); }
.brand { font-weight: 700; font-size: 0.95rem; letter-spacing: -0.02em; white-space: nowrap; flex-shrink: 0; }
.brand span { color: var(--text-subtle); font-weight: 500; }
.site-header nav { display: flex; align-items: center; gap: 0.3rem; overflow-x: auto; flex: 0 1 auto; min-width: 0; }
/* Pulsante: pill con bordo neutro SEMPRE visibile (contorno a riposo), su superficie
   chiara. Su hover il bordo/sfondo prendono la tinta della sezione; da attivo (pagina
   corrente) e' piu' marcato, con l'icona cerchiata nel colore. */
.nav-link {
  display: inline-flex; align-items: center; gap: 0.4rem;
  font-size: 0.85rem; font-weight: 600; color: var(--text-muted);
  padding: 0.3rem 0.6rem 0.3rem 0.45rem; border: 1px solid var(--border);
  background: var(--surface);
  border-radius: 999px; white-space: nowrap;
  transition: color var(--transition), background var(--transition), border-color var(--transition);
}
.nav-ico { width: 20px; height: 20px; border-radius: 999px; border: 1px solid var(--border); object-fit: cover; max-width: none; flex: none; transition: box-shadow var(--transition), border-color var(--transition); }
.nav-count { font-size: var(--fs-2xs); font-weight: 700; color: var(--text-muted); font-variant-numeric: tabular-nums; background: var(--border-light); padding: 0.03rem 0.36rem; border-radius: 999px; transition: color var(--transition), background var(--transition); }

.nav-link:hover {
  color: var(--text);
  background: color-mix(in srgb, var(--hc) 8%, var(--surface));
  border-color: color-mix(in srgb, var(--hc) 30%, var(--border));
}
.nav-link:hover .nav-ico { border-color: color-mix(in srgb, var(--hc) 45%, var(--border)); }
.nav-link:hover .nav-count { color: var(--text); background: color-mix(in srgb, var(--hc) 15%, var(--surface)); }

.nav-link.active {
  color: color-mix(in srgb, var(--hc) 72%, var(--text));
  background: color-mix(in srgb, var(--hc) 13%, var(--surface));
  border-color: color-mix(in srgb, var(--hc) 45%, var(--border));
}
/* Solo il colore del bordo cambia (1px come a riposo): niente anello/box-shadow, che
   farebbe APPARIRE l'icona piu' grande e sembrare che il pulsante attivo si "gonfi". */
.nav-link.active .nav-ico { border-color: var(--hc); }
.nav-link.active .nav-count { color: #fff; background: var(--hc); }

.site-footer { border-top: 1px solid var(--border); background: var(--surface); }
.footer-inner { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; padding-top: 1.4rem; padding-bottom: 1rem; font-size: var(--fs-sm); color: var(--text-subtle); }
.footer-inner a { color: var(--accent); }
/* Disclaimer IP: nomi/immagini/icone di WoW sono di Blizzard, questo e' un sito fan
   non ufficiale. Testo piccolo e smorzato, su tutte le pagine (e' nel layout).
   Filetto sopra + aria per staccarlo dalla riga dominio/GitHub. NIENTE max-width:
   deve occupare tutta la fascia del footer (poche righe larghe), non incolonnarsi
   stretto a sinistra lasciando meta' footer vuoto. */
.footer-legal { padding-top: 1rem; padding-bottom: 1.8rem; border-top: 1px solid var(--border-light); }
.footer-legal p { margin: 0; font-size: var(--fs-xs); line-height: 1.7; color: var(--text-subtle); }

/* Su schermo stretto il badge va a capo su una riga propria (flex-basis: 100%), centrato,
   invece di stringere dominio e GitHub sulla stessa riga. */
@media (max-width: 560px) { .build-badge { flex-basis: 100%; } }
@media (max-width: 600px) {
  .header-inner { gap: 0.75rem; }
  .brand span { display: none; }
  /* Spazio stretto: la nav resta iconica (icona + conteggio). Le etichette spariscono
     alla vista ma restano nell'albero di accessibilita' (.sr-only), non `display:none`,
     cosi' il link conserva il suo nome per screen reader. */
  .nav-txt { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .nav-link { padding: 0.42rem 0.4rem; gap: 0.25rem; }
}
</style>
